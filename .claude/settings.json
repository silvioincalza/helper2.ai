{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.secrets)",
      "Read(./.secrets/**)",
      "Read(./deploy/k8s/*/app.env)",
      "Bash(gh pr merge:*)",
      "Bash(gh stack merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push * main)",
      "Bash(git push *:main)"
    ]
  }
}
