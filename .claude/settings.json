{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh:*)",
      "Bash(./scripts/verify.sh:*)",
      "Bash(python3 .claude/hooks/guard-bash.py --self-test)",
      "Bash(python3 scripts/adr-check.py:*)",
      "Bash(python3 scripts/backlog.py roadmap:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.secrets)",
      "Read(./.secrets/**)",
      "Read(./deploy/k8s/*/app.env)",
      "Bash(gh pr merge:*)",
      "Bash(gh stack merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push * main)",
      "Bash(git push *:main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          }
        ]
      }
    ]
  }
}
