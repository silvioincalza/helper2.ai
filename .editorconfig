root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,json,css,html,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Google style (google-java-format, ktfmt --google-style): 2 spaces. Spotless is the source of truth.
[*.{java,kt,kts}]
indent_size = 2
max_line_length = 100
