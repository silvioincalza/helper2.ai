# Copy to .env and fill in. NEVER commit real values. All variables are optional unless noted.
# --- Database (required in production) ---
H2_DATABASE_URL=jdbc:postgresql://localhost:5432/helper2
H2_DATABASE_USER=helper2
H2_DATABASE_PASSWORD=
# --- Cache (Redis). App works without it; searches then go live every time. ---
H2_REDIS_HOST=localhost
H2_REDIS_PORT=6379
H2_REDIS_PASSWORD=
# --- Source credentials (server-side only; raise rate limits) ---
# HMAC key for the per-day client key (rate limits, guide quota, daily web searches; ADR 0037, 0027) and the query key.
# Required when H2_LIVE_WEB_API_KEY is set. Without it the client key uses a random key per process. openssl rand -hex 32
H2_QUOTA_KEY_SECRET=
# --- Source switches ---
H2_SOURCE_CURATED_ENABLED=true
# --- AI: NVIDIA Nemotron on Nebius Token Factory. Run with H2_PROFILES=<...>,llm-nebius and set: ---
H2_NEBIUS_API_KEY=
# Confirm ids via GET https://api.tokenfactory.nebius.com/v1/models
H2_NEBIUS_REASONING_MODEL=nvidia/Nemotron-3.5-Super-VL
# Planning, query translation, list classification. Empty = the reasoning model does these too.
H2_NEBIUS_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# HTTP retries of the model SDK per call. They are not charged to the daily budgets, so keep 0: the app's own
# retries (one per malformed answer) are charged.
H2_LLM_MAX_RETRIES=0
# --- Sign-in: GitHub OAuth App, profile oauth-github (local: callback http://localhost:5173/login/oauth2/code/github) ---
# Only behind a proxy that overwrites X-Forwarded-*: native | framework. Default none.
H2_FORWARD_HEADERS_STRATEGY=
# --- Web ---
H2_PORT=8080

# Vector search (ADR 0024): NVIDIA API catalog key (build.nvidia.com). Empty = keyword search only.
H2_NVIDIA_API_KEY=
H2_NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b


# Every other setting the apps read, at its default (helper2-shared.yaml and each app's application.yaml). Uncomment a line to change it;
# a commented line keeps the default, so a default changed in the code still applies.
# --- Server, database, Redis, schema and runtime.
# Temporary switch: true = the catalog row takes its licence, type, pricing, open source and event days from the merge the resource page runs; false = from the older SQL rule.
# H2_CATALOG_RECONCILE_BY_PROJECTION=true
# H2_CATEGORIES_BACKFILL_AT_STARTUP=true
# Public app only.
# H2_DATABASE_BACKOFFICE_PASSWORD=
# H2_DATABASE_POOL_SIZE=16
# Public app only.
# H2_DATABASE_PUBLIC_PASSWORD=
# H2_REDIS_USER=
# H2_RUNTIME_SETTINGS_REFRESH=PT20S
# H2_SCHEMA_MIGRATE=false
# H2_SCHEMA_WAIT=PT4M
# --- Model calls (Nebius, NVIDIA embeddings, timeouts).
# H2_LLM_TIMEOUT=40s
# H2_NEBIUS_NATIVE_SCHEMA=true
# H2_NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# --- Search and live web.
# H2_SEARCH_QUERY_VECTOR_TTL=7d
# --- Sources: true/false switches, deadlines (total time per call) and timeouts.
# H2_SOURCE_INDEX_TIMEOUT=3s
# H2_SOURCE_SEMANTIC_MAX_DISTANCE=0.65
# H2_SOURCE_SEMANTIC_TIMEOUT=3s
# --- Circuit breakers and bulkheads.
# H2_RESILIENCE_CATALOG_MAX_CONCURRENT=3
# H2_RESILIENCE_COLLECTOR_MAX_ATTEMPTS=3
# H2_RESILIENCE_COLLECTOR_OPEN_FOR=1m
# H2_RESILIENCE_DB_CACHE_MAX_CONCURRENT=2
# H2_RESILIENCE_DB_CACHE_OPEN_FOR=30s
# H2_RESILIENCE_LLM_OPEN_FOR=30s
# H2_RESILIENCE_REDIS_OPEN_FOR=30s
# H2_RESILIENCE_SOURCE_FAILURE_RATE=50
# H2_RESILIENCE_SOURCE_MAX_CONCURRENT=20
# H2_RESILIENCE_SOURCE_OPEN_FOR=30s
# --- Retention: how long each kind of record is kept, and when the purge runs.
# H2_RETENTION_BACKUPS=P7D
# H2_RETENTION_CRON=0 17 3 * * *
# H2_RETENTION_ENRICHMENT_RUNS=P90D
# H2_RETENTION_LIST_INDEX=P30D
# H2_RETENTION_OBSERVED_UNSEEN=P180D
# H2_RETENTION_PAST_EVENTS=P3650D
# H2_RETENTION_RESOLVED_ISSUE_REPORTS=P365D
# H2_RETENTION_RESOLVED_REVIEW_ITEMS=P180D
# H2_RETENTION_RUNTIME_SETTINGS=P730D
# H2_RETENTION_WEB_NEWS=P180D
# --- Other.
# H2_BUILD_VERSION=local
# H2_ENVIRONMENT=local
# H2_LOG_FORMAT=logstash
# H2_MANAGEMENT_PORT=
# H2_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# H2_SHUTDOWN_TIMEOUT=30s
# H2_TRACING_EXPORT=false
# H2_TRACING_SAMPLING=1.0
# Embedding indexer: texts per call and time between calls. NVIDIA's hosted endpoint fails calls of more than one
# text since 11 Nov 2026 (ADR 0024); 1 every 5 s is 12 calls a minute, under the trial limit of 40.
H2_EMBEDDING_BATCH=1
H2_EMBEDDING_EVERY=PT5S
