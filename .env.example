# Copy to .env and fill in. NEVER commit real values. All variables are optional unless noted.
# --- Database (required in production) ---
H2_DATABASE_URL=jdbc:postgresql://localhost:5432/helper2
H2_DATABASE_USER=helper2
H2_DATABASE_PASSWORD=
# --- Cache (Redis). App works without it; searches then go live every time. ---
H2_REDIS_HOST=localhost
H2_REDIS_PORT=6379
H2_REDIS_PASSWORD=
# --- Source credentials (server-side only; raise rate limits) ---
H2_GITHUB_TOKEN=
H2_HF_TOKEN=
# Setup guide README fetches (ADR 0031): its own GitHub token, apart from H2_GITHUB_TOKEN. Empty = anonymous.
H2_SETUP_GITHUB_TOKEN=
# Tavily web search for AI news/articles/events (free tier: 1,000 credits/month). Empty = source skipped.
H2_TAVILY_API_KEY=
# --- Source switches ---
H2_SOURCE_GITHUB_ENABLED=true
H2_SOURCE_HF_ENABLED=true
H2_SOURCE_NPM_ENABLED=true
H2_SOURCE_MCP_ENABLED=true
H2_SOURCE_ARXIV_ENABLED=true
H2_SOURCE_TAVILY_ENABLED=true
H2_SOURCE_CURATED_ENABLED=true
# --- Search ---
# A source's answer is cached this long and, while it lasts, served when the source fails.
H2_SEARCH_STALE_FOR=24h
# Most results asked of each source per search.
H2_SEARCH_PER_SOURCE_LIMIT=30
# Wait for the English translation of a non-English query before searching untranslated (ms).
H2_SEARCH_TRANSLATE_TIMEOUT_MS=2500
# --- Per-client rate limits (requests per client address; past them 429) ---
H2_RATE_LIMIT_SEARCH_PER_MINUTE=60
H2_RATE_LIMIT_REPORT_PER_HOUR=20
H2_RATE_LIMIT_GUIDE_PER_MINUTE=10
H2_RATE_LIMIT_RECENT_PER_MINUTE=60
# --- AI Resource Scout ---
H2_SCOUT_ENABLED=false
# Checked ~20 s after startup, then every tick; runs when the last scheduled run ended at least
# H2_SCOUT_EVERY ago, or never ran (ISO-8601 durations; default tick PT1H).
H2_SCOUT_INITIAL_DELAY=PT20S
H2_SCOUT_TICK=PT5M
H2_SCOUT_EVERY=PT15M
# --- AI: NVIDIA Nemotron on Nebius Token Factory. Run with H2_PROFILES=<...>,llm-nebius and set: ---
H2_NEBIUS_API_KEY=
# Confirm ids via GET https://api.tokenfactory.nebius.com/v1/models
H2_NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# Planning, query translation, list classification. Empty = the reasoning model does these too.
H2_NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# HTTP retries of the model SDK per call. They are not charged to the daily budgets, so keep 0: the app's own
# retries (one per malformed answer) are charged.
H2_LLM_MAX_RETRIES=0
# --- Sign-in: GitHub OAuth App, profile oauth-github (local: callback http://localhost:5173/login/oauth2/code/github) ---
H2_GITHUB_OAUTH_CLIENT_ID=
H2_GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated ADMIN allow-list: "registrationId:subject" (GitHub: NUMERIC user id, not the login),
# or "registrationId:email" for OIDC providers with a verified email.
H2_ADMINS=
# Only behind a proxy that overwrites X-Forwarded-*: native | framework. Default none.
H2_FORWARD_HEADERS_STRATEGY=
# --- Web ---
H2_FRONTEND_URL=/
H2_COOKIE_SECURE=true
H2_PORT=8080

# Vector search (ADR 0012): NVIDIA API catalog key (build.nvidia.com). Empty = keyword search only.
H2_NVIDIA_API_KEY=
H2_NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
