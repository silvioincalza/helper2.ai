# Repository variables for GitHub Actions: gh variable set -f .github/settings/variables.env
# OpenBao address the CI jobs log in to with GitHub OIDC (.github/actions/bao-login).
BAO_ADDR=https://openbao.infra.incalza.me
# OIDC audience of the CI token: equal to bound_audiences of the OpenBao roles deploy, deploy-staging, deploy-prod.
BAO_AUDIENCE=https://openbao.infra.incalza.me
# Public URL of staging, read by the nightly guide evaluation (guide-eval.yml). Empty = the evaluation is skipped.
H2_STAGING_URL=https://helper2.incalza.me
