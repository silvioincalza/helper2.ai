# Copy to app.env (git-ignored). make env-secret writes the six passwords below into the Secret
# helper2-credentials and every other key into helper2-app-env (ADR 0004). Each password: openssl rand -hex 32
# The database owner's: Postgres, pg-backup and the migrate Job only, never an app.
# H2_DATABASE_PASSWORD: Password of the database owner (Postgres superuser of the app database).
# Type: secret string. Default: none, required (check-app-env.sh). Example: the output of openssl rand -hex 32
H2_DATABASE_PASSWORD=REPLACE-ME-hex
# Each app's own database role (h2_public, h2_backoffice); the migrate Job sets them on every deploy.
# H2_DATABASE_PUBLIC_PASSWORD: Password of h2_public, the public app's database role.
# Type: secret string. Default: none, required (check-app-env.sh). Example: the output of openssl rand -hex 32
H2_DATABASE_PUBLIC_PASSWORD=REPLACE-ME-hex
# H2_DATABASE_BACKOFFICE_PASSWORD: Password of h2_backoffice, the back office's database role.
# Type: secret string. Default: none, required (check-app-env.sh). Example: the output of openssl rand -hex 32
H2_DATABASE_BACKOFFICE_PASSWORD=REPLACE-ME-hex
# Redis requirepass, the default user (the admin: probes, redis-cli); never given to an app. Letters and digits only.
# H2_REDIS_PASSWORD: Redis requirepass of the default (admin) user.
# Type: secret string. Default: none, required (check-app-env.sh). Example: the output of openssl rand -hex 32
H2_REDIS_PASSWORD=REPLACE-ME-hex
# Each app's own Redis ACL user (deploy/helm/helper2/files/redis-users.acl). Letters and digits only.
# H2_REDIS_PUBLIC_PASSWORD: Password of the public app's Redis ACL user.
# Type: secret string. Default: none, required (check-app-env.sh). Example: the output of openssl rand -hex 32
H2_REDIS_PUBLIC_PASSWORD=REPLACE-ME-hex
# H2_REDIS_BACKOFFICE_PASSWORD: Password of the back office's Redis ACL user.
# Type: secret string. Default: none, required (check-app-env.sh). Example: the output of openssl rand -hex 32
H2_REDIS_BACKOFFICE_PASSWORD=REPLACE-ME-hex
# H2_NEBIUS_API_KEY: API key for Nebius Token Factory, where the Nemotron chat models run.
# Type: secret string. Default: none, required. Example: the key from the Nebius Token Factory console
H2_NEBIUS_API_KEY=REPLACE-ME
# H2_NEBIUS_REASONING_MODEL: Chat model for the hard steps: guide answers, setup guides, enrichment.
# Type: model id. Default: nvidia/Nemotron-3.5-Super-VL. Example: nvidia/Nemotron-3.5-Super-VL
H2_NEBIUS_REASONING_MODEL=nvidia/Nemotron-3.5-Super-VL
# H2_NEBIUS_FAST_MODEL: Chat model for the quick steps: translation, classification, small checks.
# Type: model id. Default: nvidia/Nemotron-3_5-Lightning. Example: nvidia/Nemotron-3_5-Lightning
H2_NEBIUS_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# HTTP retries of the model SDK per call. They are not charged to the daily budgets, so keep 0: the app's own
# retries (one per malformed answer) are charged.
# H2_LLM_MAX_RETRIES: HTTP retries of the model SDK per call.
# Type: integer. Default: 0. Example: 1
H2_LLM_MAX_RETRIES=0
# H2_LIVE_WEB_API_KEY: Tavily API key for live web search. Empty = no live web results.
# Type: secret string. Default: empty. Example: tvly-... from the Tavily dashboard
H2_LIVE_WEB_API_KEY=
# H2_HF_TOKEN: Hugging Face token for the Hub API. Empty = anonymous, lower rate limits.
# Type: secret string. Default: empty. Example: hf_... (a read token)
H2_HF_TOKEN=
# H2_GITHUB_TOKEN: GitHub token for the GitHub search source and the Scout collectors. Empty = anonymous, 60 calls an hour.
# Type: secret string. Default: empty. Example: github_pat_... (fine-grained, public repositories, read only)
H2_GITHUB_TOKEN=
# Guide cost guard (ADR 0032). Each question = 3 model calls (ADR 0031); past the cap the guide degrades until 00:00 UTC.
# H2_GUIDE_DAILY_MODEL_CALLS: Model calls the AI guide may make per UTC day, across all replicas.
# Type: integer. Default: 600. Example: 1200
H2_GUIDE_DAILY_MODEL_CALLS=600
# The cap opens in parts of the UTC day (12 = every 2 hours, unused calls carry over; 1 = all at 00:00), questions per
# network (IPv4 /24, IPv6 /56) and questions running at once per client. A network count of 0 refuses every AI
# answer: there is no "off" value, set it high instead (staging uses 1000).
# H2_GUIDE_BUDGET_PACE_SLOTS: Parts of the UTC day the guide cap opens in.
# Type: integer. Default: 12. Example: 24
# H2_GUIDE_BUDGET_PACE_SLOTS=12
# H2_GUIDE_NETWORK_DAILY_QUESTIONS: Guide questions per network (IPv4 /24, IPv6 /56) per UTC day.
# Type: integer. Default: 300. Example: 600
# H2_GUIDE_NETWORK_DAILY_QUESTIONS=300
# H2_GUIDE_CLIENT_CONCURRENT_QUESTIONS: Guide questions one client may have running at once.
# Type: integer. Default: 2. Example: 4
# H2_GUIDE_CLIENT_CONCURRENT_QUESTIONS=2
# Staging only, for the nightly guide evaluation (ADR 0046, .github/workflows/guide-eval.yml): every answer is a
# real model call, one run (28 questions) and a rerun fit the per-client quota, and the guide cap bounds a run at 150.
# H2_GUIDE_CACHE_TTL: How long a guide answer is reused for the same question and results.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT24H. Example: PT48H
# H2_GUIDE_CACHE_TTL=PT1S
# H2_GUIDE_CLIENT_DAILY_QUESTIONS: Guide questions per client per UTC day.
# Type: integer. Default: 30. Example: 60
# H2_GUIDE_CLIENT_DAILY_QUESTIONS=60
# H2_GUIDE_DAILY_MODEL_CALLS=300
# H2_GUIDE_BUDGET_PACE_SLOTS=1
# H2_GUIDE_NETWORK_DAILY_QUESTIONS=1000
# Non-English search queries translated to English per UTC day (ADR 0023), separate cap.
# H2_SEARCH_DAILY_TRANSLATIONS: Search queries translated to English per UTC day.
# Type: integer. Default: 300. Example: 600
H2_SEARCH_DAILY_TRANSLATIONS=300
# How long the replicas share a query's translation and its query vector in PostgreSQL (ADR 0023, ADR 0024).
# H2_SEARCH_TRANSLATION_TTL: How long a query's English translation is shared and reused.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 24h. Example: 48h
# H2_SEARCH_TRANSLATION_TTL=24h
# H2_SEARCH_QUERY_VECTOR_TTL: How long a query's embedding vector is shared and reused.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 7d. Example: 14d
# H2_SEARCH_QUERY_VECTOR_TTL=7d
# Per-client rate limits (requests per client address; past them 429).
# H2_RATE_LIMIT_SEARCH_PER_MINUTE: Search requests per client per minute; past it the API answers 429.
# Type: integer. Default: 120. Example: 240
H2_RATE_LIMIT_SEARCH_PER_MINUTE=120
# H2_RATE_LIMIT_REPORT_PER_HOUR: Issue reports per client per hour.
# Type: integer. Default: 20. Example: 40
H2_RATE_LIMIT_REPORT_PER_HOUR=20
# H2_RATE_LIMIT_GUIDE_PER_MINUTE: Guide requests per client per minute.
# Type: integer. Default: 10. Example: 20
H2_RATE_LIMIT_GUIDE_PER_MINUTE=10
# H2_RATE_LIMIT_RECENT_PER_MINUTE: Requests for the recent-items lists per client per minute.
# Type: integer. Default: 60. Example: 120
H2_RATE_LIMIT_RECENT_PER_MINUTE=60
# H2_RATE_LIMIT_DEFAULT_PER_MINUTE: Requests per client per minute for every API call and page with no limit of its own.
# Type: integer. Default: 120. Example: 240
# H2_RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Tavily answers in 2-4 s; 3 s was too short on prod.
# H2_SOURCE_LIVE_WEB_TIMEOUT: Timeout of one live web (Tavily) search call.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 6s. Example: 12s
H2_SOURCE_LIVE_WEB_TIMEOUT=6s
# Total time per Scout collector call, body included (ADR 0006 §2); unset = twice the collector's timeout.
# H2_SOURCE_GITHUB_AWESOME_DEADLINE=30s   (also HF_TRENDING, LIVE_WEB_SCOUT, COURSE_SCOUT, LINKEDIN_SCOUT, HF_ORGS, AI_DEADLINES, MCP)
# Embeddings for vector search (NVIDIA API catalog, build.nvidia.com). Empty key = keyword search only.
# H2_NVIDIA_API_KEY: NVIDIA API catalog key for embeddings. Empty = keyword search only, no vector search.
# Type: secret string. Default: empty. Example: nvapi-... from build.nvidia.com
H2_NVIDIA_API_KEY=
# H2_NVIDIA_EMBEDDING_MODEL: Embedding model for vector search.
# Type: model id. Default: nvidia/nemotron-3.5-embed-1b. Example: nvidia/nemotron-3.5-embed-1b
H2_NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# Setup guide (ADR 0034): model calls per UTC day for the step-by-step guide, and README/registry fetches per hour
# across all replicas.
# H2_SETUP_GUIDE_DAILY_MODEL_CALLS: Model calls the setup guide may make per UTC day.
# Type: integer. Default: 500. Example: 1000
H2_SETUP_GUIDE_DAILY_MODEL_CALLS=500
# New setup guides per visitor and per network (IPv4 /24, IPv6 /56) per UTC day, and guides written at once per replica.
# H2_SETUP_GUIDE_CLIENT_DAILY: New setup guides per visitor per UTC day.
# Type: integer. Default: 20. Example: 40
# H2_SETUP_GUIDE_CLIENT_DAILY=20
# H2_SETUP_GUIDE_NETWORK_DAILY: New setup guides per network (IPv4 /24, IPv6 /56) per UTC day.
# Type: integer. Default: 200. Example: 400
# H2_SETUP_GUIDE_NETWORK_DAILY=200
# H2_SETUP_GUIDE_MAX_CONCURRENT: Setup guides written at once per replica.
# Type: integer. Default: 2. Example: 4
# H2_SETUP_GUIDE_MAX_CONCURRENT=2
# H2_SETUP_HOURLY_FETCHES: README and registry fetches per hour for setup guides, across all replicas.
# Type: integer. Default: 1000. Example: 2000
H2_SETUP_HOURLY_FETCHES=1000
# Setup guide step texts: VERIFIED = a second model call checks each step's text, an unchecked step shows only its
# source (two calls a guide); SOURCE_ONLY = no second call, every step shows only its source quote and command
# (one call a guide).
# H2_SETUP_GUIDE_STEP_TEXT: How setup guide steps are written: VERIFIED or SOURCE_ONLY.
# Type: VERIFIED or SOURCE_ONLY. Default: VERIFIED. Example: SOURCE_ONLY
H2_SETUP_GUIDE_STEP_TEXT=VERIFIED
# How long an unreadable model answer is kept, so the same ask does not spend two model calls again at once.
# H2_SETUP_UNREADABLE_TTL: How long an unreadable model answer is kept so the same ask is not paid twice.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT10M. Example: PT20M
H2_SETUP_UNREADABLE_TTL=PT10M
# Setup guide's own GitHub token for README fetches (read-only public access), apart from H2_GITHUB_TOKEN; empty = anonymous.
# H2_SETUP_GITHUB_TOKEN: GitHub token for setup guide README fetches. Empty = anonymous.
# Type: secret string. Default: empty. Example: github_pat_... (fine-grained, public repositories, read only)
H2_SETUP_GITHUB_TOKEN=
# PyPI packages through BigQuery (ADR 0017). The Google Cloud project that runs the queries, in BigQuery sandbox
# mode (no billing account, so nothing can be charged). Its own service account has the BigQuery Job User role only;
# its JSON key goes here as base64 on one line (base64 -w0 key.json, or base64 -i key.json on macOS). Keep the key in
# OpenBao. Empty = no PyPI collector.
# H2_PYPI_BIGQUERY_PROJECT: Google Cloud project that runs the PyPI BigQuery queries. Empty = no PyPI collector.
# Type: Google Cloud project id. Default: empty. Example: helper2-pypi
H2_PYPI_BIGQUERY_PROJECT=
# H2_PYPI_BIGQUERY_KEY: Base64 JSON key of the BigQuery service account for PyPI.
# Type: secret string (base64 on one line). Default: empty. Example: the output of base64 -w0 key.json
H2_PYPI_BIGQUERY_KEY=
# HMAC key for the per-day client key (rate limits, guide quota, daily web searches; ADR 0037, 0027) and the query key.
# Required when H2_LIVE_WEB_API_KEY is set; set it anyway, or rate limits count per replica. Keep it in OpenBao.
# openssl rand -hex 32
# H2_QUOTA_KEY_SECRET: HMAC key that turns a client address into the per-day client key for rate limits and quotas.
# Type: secret string. Default: empty. Example: the output of openssl rand -hex 32
H2_QUOTA_KEY_SECRET=REPLACE-ME-hex
# Sign-in (ADR 0036): the GitHub OAuth App of this environment (profile oauth-github). Without them the apps
# do not start. Both apps read this file: users sign in on the public host, the owner on the admin host (the back
# office, ADR 0043), each with its own callback /login/oauth2/code/github.
# H2_GITHUB_OAUTH_CLIENT_ID: Client id of this environment's GitHub OAuth App for sign-in.
# Type: string. Default: none, required. Example: Ov23li... from the GitHub OAuth App
H2_GITHUB_OAUTH_CLIENT_ID=REPLACE-ME
# H2_GITHUB_OAUTH_CLIENT_SECRET: Client secret of this environment's GitHub OAuth App.
# Type: secret string. Default: none, required. Example: the client secret from the GitHub OAuth App
H2_GITHUB_OAUTH_CLIENT_SECRET=REPLACE-ME
# Comma-separated ADMIN allow-list: "github:<numeric user id>" (never the login). Only the back office grants ADMIN.
# H2_ADMINS: Who gets ADMIN in the back office.
# Type: comma-separated list of github:<numeric user id>. Default: empty. Example: github:1234567,github:7654321
H2_ADMINS=github:REPLACE-ME


# Every other setting the apps read, at its default (helper2-shared.yaml and each app's application.yaml). Uncomment a line to change it;
# a commented line keeps the default, so a default changed in the code still applies.
# --- Server, database, Redis and schema (the chart sets the usual ones).
# H2_CATALOG_RECONCILE_BY_PROJECTION: Temporary switch. true = the catalog row takes its licence, type, pricing, open source and event days from the merge the resource page runs; false = from the older SQL rule.
# Type: boolean (true or false). Default: true. Example: false
# H2_CATALOG_RECONCILE_BY_PROJECTION=true
# H2_CATEGORIES_BACKFILL_AT_STARTUP: Fill in missing categories of catalog entries when the app starts.
# Type: boolean (true or false). Default: true. Example: false
# H2_CATEGORIES_BACKFILL_AT_STARTUP=true
# H2_DATABASE_POOL_SIZE: Database connections per replica (Hikari pool size).
# Type: integer. Default: 16. Example: 20
# H2_DATABASE_POOL_SIZE=16
# H2_FRONTEND_URL: Where the browser goes after sign-in and sign-out. Public app only.
# Type: URL or path. Default: /. Example: https://helper2.ai/
# H2_FRONTEND_URL=/
# H2_PAGES_TEMPLATE: HTML shell the server fills for each page (SEO and first paint). Public app only.
# Type: Spring resource (file: or classpath:). Default: file:/shell/index.html. Example: classpath:/static/index.html
# H2_PAGES_TEMPLATE=file:/shell/index.html
# H2_PORT: HTTP port the app listens on.
# Type: integer. Default: 8080. Example: 16160
# H2_PORT=8080
# H2_REDIS_PORT: Redis port.
# Type: integer. Default: 6379. Example: 12758
# H2_REDIS_PORT=6379
# H2_RUNTIME_SETTINGS_REFRESH: How often a replica reloads the settings changed in the back office.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT20S. Example: PT40S
# H2_RUNTIME_SETTINGS_REFRESH=PT20S
# H2_SCHEMA_MIGRATE: Run the Flyway migrations at startup; false = wait for the migrate Job.
# Type: boolean (true or false). Default: false. Example: true
# H2_SCHEMA_MIGRATE=false
# H2_SCHEMA_WAIT: How long the app waits at startup for the schema to be up to date before it fails.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT4M. Example: PT8M
# H2_SCHEMA_WAIT=PT4M
# --- Model calls (Nebius, NVIDIA embeddings, timeouts).
# H2_LLM_TIMEOUT: Timeout of one chat model call.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 40s. Example: 80s
# H2_LLM_TIMEOUT=40s
# H2_NEBIUS_CHOOSE_MAX_TOKENS: Max output tokens of the guide's choose step. Public app only.
# Type: integer. Default: 8192. Example: 16384
# H2_NEBIUS_CHOOSE_MAX_TOKENS=8192
# H2_NEBIUS_ENRICH_MAX_TOKENS: Max output tokens of one Scout enrichment call. Back office only.
# Type: integer. Default: 8192. Example: 16384
# H2_NEBIUS_ENRICH_MAX_TOKENS=8192
# H2_NEBIUS_NATIVE_SCHEMA: Ask the model for JSON through the provider's native structured output.
# Type: boolean (true or false). Default: true. Example: false
# H2_NEBIUS_NATIVE_SCHEMA=true
# H2_NVIDIA_EMBEDDING_BASE_URL: Base URL of the embedding API.
# Type: URL. Default: https://integrate.api.nvidia.com/v1. Example: https://integrate.api.nvidia.com/v1
# H2_NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# --- Guide (ADR 0031, 0032).
# H2_GUIDE_CLIENT_DAILY_FREE_ANSWERS: Guide answers with no pick, failed, shared or abandoned that a client gets back per UTC day; past it they count as questions.
# Type: integer. Default: 5. Example: 10
# H2_GUIDE_CLIENT_DAILY_FREE_ANSWERS=5
# H2_GUIDE_HEARTBEAT: How often the guide's SSE stream sends a keep-alive. Public app only.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT15S. Example: PT30S
# H2_GUIDE_HEARTBEAT=PT15S
# H2_GUIDE_MAX_CANDIDATES: Search results the guide reads before it answers. Public app only.
# Type: integer. Default: 24. Example: 48
# H2_GUIDE_MAX_CANDIDATES=24
# H2_GUIDE_MAX_CONCURRENT: Guide questions answered at once per replica.
# Type: integer. Default: 8. Example: 16
# H2_GUIDE_MAX_CONCURRENT=8
# Guide model calls: OFF = each call waits for the whole answer; ON = each call is read as a stream, so a call is
# stopped at once, thinking is capped by time and the page says when the model reasons and writes (ADR 0035).
# The whole answer is checked either way. A change needs a restart and keeps the answer cache.
# With ON and a thinking budget above 0 for plan, choose or verify (H2_GUIDE_THINK_*_TOKENS), a question whose
# askers have all closed the connection stops and is given back; in every other case it runs on and its answer is
# cached (ADR 0032).
# H2_GUIDE_MODEL_STREAM: How the guide reads its model calls: OFF or ON. Public app only.
# Type: OFF or ON. Default: OFF. Example: ON
# H2_GUIDE_MODEL_STREAM=OFF
# H2_GUIDE_QUESTION_DEADLINE: Total time a guide question may take before it is cut off. Public app only.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT90S. Example: PT180S
# H2_GUIDE_QUESTION_DEADLINE=PT90S
# H2_GUIDE_THINK_BROWSE_TOKENS: Tokens the model may spend reasoning when the guide's choose step browses by date
# with no subject. Added on top of the room for the answer. 0 turns reasoning off. Public app only.
# Type: whole number, 0 or more. Default: 2048. Example: 1024
# H2_GUIDE_THINK_BROWSE_TOKENS=2048
# H2_GUIDE_THINK_CHOOSE_TOKENS: Tokens the model may spend reasoning in the guide's choose step. Added on top of the
# room for the answer. 0 turns reasoning off. Public app only.
# Type: whole number, 0 or more. Default: 0. Example: 1024
# H2_GUIDE_THINK_CHOOSE_TOKENS=0
# H2_GUIDE_THINK_PLAN_TOKENS: Tokens the model may spend reasoning in the guide's plan step. Added on top of the
# room for the answer. 0 turns reasoning off. Public app only.
# Type: whole number, 0 or more. Default: 0. Example: 512
# H2_GUIDE_THINK_PLAN_TOKENS=0
# H2_GUIDE_THINK_VERIFY_TOKENS: Tokens the model may spend reasoning in the guide's verify step. Added on top of the
# room for the answer. 0 turns reasoning off. Public app only.
# Type: whole number, 0 or more. Default: 0. Example: 1024
# H2_GUIDE_THINK_VERIFY_TOKENS=0
# --- Search and live web.
# H2_LIVE_WEB_FRESH_GENERAL: How long a live web result counts as fresh for a general query.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT48H. Example: PT96H
# H2_LIVE_WEB_FRESH_GENERAL=PT48H
# H2_LIVE_WEB_FRESH_TIMEBOUND: How long a live web result counts as fresh for a time-bound query (news, latest).
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT24H. Example: PT48H
# H2_LIVE_WEB_FRESH_TIMEBOUND=PT24H
# H2_SEARCH_PER_SOURCE_LIMIT: Max results taken from each source per search.
# Type: integer. Default: 30. Example: 60
# H2_SEARCH_PER_SOURCE_LIMIT=30
# H2_SEARCH_STALE_FOR: How long a cached search result may be served while it is refreshed.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 24h. Example: 48h
# H2_SEARCH_STALE_FOR=24h
# H2_SEARCH_TRANSLATE_TIMEOUT_MS: Milliseconds a query translation may take before the search runs untranslated.
# Type: integer (milliseconds). Default: 2500. Example: 5000
# H2_SEARCH_TRANSLATE_TIMEOUT_MS=2500
# H2_VITALITY_ESTABLISHED_STARS: Stars from which a repository never counts as unmaintained, however old its last update.
# Type: whole number, 0 or more. Default: 10000. Example: 5000
# H2_VITALITY_ESTABLISHED_STARS=10000
# H2_VITALITY_FORK_MIN_STARS: Fewest stars a fork needs to be a result when it is not maintained.
# Type: whole number, 0 or more. Default: 10. Example: 50
# H2_VITALITY_FORK_MIN_STARS=10
# H2_VITALITY_MAINTAINED_WITHIN: How long after its last update a library, MCP server, skill or agent still counts as maintained. Older ones rank lower; an older fork with too few stars is no result.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1095D. Example: P730D
# H2_VITALITY_MAINTAINED_WITHIN=P1095D
# --- Setup guide (ADR 0034).
# H2_SETUP_CACHE_TTL: How long fetched READMEs and registry pages are cached. Public app only.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT1H. Example: PT2H
# H2_SETUP_CACHE_TTL=PT1H
# H2_SETUP_DOCUMENT_CACHE_MB: Memory for cached setup documents per replica, in MB. Public app only.
# Type: integer (MB). Default: 32. Example: 64
# H2_SETUP_DOCUMENT_CACHE_MB=32
# H2_SETUP_DOCUMENT_TIMEOUT: Timeout of one README or registry fetch. Public app only.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 10s. Example: 20s
# H2_SETUP_DOCUMENT_TIMEOUT=10s
# H2_SETUP_GUIDE_CACHE_TTL: How long a written setup guide is reused. Public app only.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SETUP_GUIDE_CACHE_TTL=P7D
# H2_SETUP_GUIDE_REASONING: Turn on model reasoning when writing setup guides. Public app only.
# Type: boolean (true or false). Default: false. Example: true
# H2_SETUP_GUIDE_REASONING=false
# H2_SETUP_NPM_README_BASE_URL: Where npm package READMEs are fetched from. Public app only.
# Type: URL. Default: https://cdn.jsdelivr.net. Example: https://unpkg.com
# H2_SETUP_NPM_README_BASE_URL=https://cdn.jsdelivr.net
# --- Example questions.
# H2_EXAMPLES_CRON: When the daily run drafts new example questions for the home page (Spring cron, UTC).
# Type: cron, Spring format (second minute hour day month weekday), UTC. Default: 0 41 2 * * *. Example: 0 0 4 * * *
# H2_EXAMPLES_CRON=0 41 2 * * *
# H2_EXAMPLES_DRAFT_CALLS: Model calls per run to draft example questions; 0 = off.
# Type: integer. Default: 5. Example: 0 (off)
# H2_EXAMPLES_DRAFT_CALLS=5
# H2_EXAMPLES_DRAFT_SOURCES: Catalog entries a draft run reads for ideas.
# Type: integer. Default: 12. Example: 24
# H2_EXAMPLES_DRAFT_SOURCES=12
# H2_EXAMPLES_PENDING_DELAY: Wait after startup before the first check of pending example questions.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT1M. Example: PT2M
# H2_EXAMPLES_PENDING_DELAY=PT1M
# H2_EXAMPLES_PENDING_EVERY: How often pending example questions are checked.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT5M. Example: PT10M
# H2_EXAMPLES_PENDING_EVERY=PT5M
# --- Sources: true/false switches, deadlines (total time per call) and timeouts.
# H2_SOURCE_AI_DEADLINES_DEADLINE: Total time per AI-deadlines collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_AI_DEADLINES_DEADLINE=
# H2_SOURCE_AI_DEADLINES_ENABLED: Turn the AI conference deadlines collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_AI_DEADLINES_ENABLED=true
# H2_SOURCE_ARXIV_ENABLED: Turn the arXiv papers source on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_ARXIV_ENABLED=true
# H2_SOURCE_COURSE_SCOUT_DEADLINE: Total time per course collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_COURSE_SCOUT_DEADLINE=
# H2_SOURCE_COURSE_SCOUT_ENABLED: Turn the AI courses collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_COURSE_SCOUT_ENABLED=true
# H2_SOURCE_CURATED_ENABLED: Turn the hand-curated catalog entries on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_CURATED_ENABLED=true
# H2_SOURCE_DISCOVERY_DEADLINE: Total time per discovery collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_DISCOVERY_DEADLINE=
# H2_SOURCE_DISCOVERY_ENABLED: Turn the web discovery collector (new tools found through Tavily) on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_DISCOVERY_ENABLED=true
# H2_SOURCE_GITHUB_AWESOME_ENABLED: Turn the GitHub awesome-list collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_GITHUB_AWESOME_ENABLED=true
# H2_SOURCE_GITHUB_ENABLED: Turn the GitHub repository search source on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_GITHUB_ENABLED=true
# H2_SOURCE_GITHUB_SDKS_DEADLINE: Total time per SDK collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_GITHUB_SDKS_DEADLINE=
# H2_SOURCE_GITHUB_SDKS_ENABLED: Turn the AI libraries and SDKs collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_GITHUB_SDKS_ENABLED=true
# H2_SOURCE_GITHUB_TOPIC_LEADERS_DEADLINE: Total time per topic-leaders collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_GITHUB_TOPIC_LEADERS_DEADLINE=
# H2_SOURCE_GITHUB_TOPIC_LEADERS_ENABLED: Turn the GitHub topic leaders collector (top-starred repos per topic) on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_GITHUB_TOPIC_LEADERS_ENABLED=true
# H2_SOURCE_HACKER_NEWS_ENABLED: Turn the Hacker News source on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_HACKER_NEWS_ENABLED=true
# H2_SOURCE_HF_ENABLED: Turn the Hugging Face models search source on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_HF_ENABLED=true
# H2_SOURCE_HF_ORGS_DEADLINE: Total time per Hugging Face provider-orgs collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_HF_ORGS_DEADLINE=
# H2_SOURCE_HF_ORGS_ENABLED: Turn the Hugging Face provider organisations collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_HF_ORGS_ENABLED=true
# H2_SOURCE_HF_SPACES_MIN_LIKES: Fewest likes a hosted app whose state is known (a Hugging Face Space) needs to be a result. 0 = no minimum.
# Type: whole number, 0 or more. Default: 3. Example: 10
# H2_SOURCE_HF_SPACES_MIN_LIKES=3
# H2_SOURCE_HF_TRENDING_DEADLINE: Total time per Hugging Face trending collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_HF_TRENDING_DEADLINE=
# H2_SOURCE_HF_TRENDING_ENABLED: Turn the Hugging Face trending models collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_HF_TRENDING_ENABLED=true
# H2_SOURCE_INDEX_TIMEOUT: Timeout of the catalog's full-text search per query.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 3s. Example: 6s
# H2_SOURCE_INDEX_TIMEOUT=3s
# H2_SOURCE_LINKEDIN_SCOUT_DEADLINE: Total time per LinkedIn collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_LINKEDIN_SCOUT_DEADLINE=
# H2_SOURCE_LINKEDIN_SCOUT_ENABLED: Turn the LinkedIn posts collector (through Tavily) on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_LINKEDIN_SCOUT_ENABLED=true
# H2_SOURCE_LIVE_WEB_ENABLED: Turn live web search results on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_LIVE_WEB_ENABLED=true
# H2_SOURCE_LIVE_WEB_EVENTS_SCOUT_DEADLINE: Total time per events collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_LIVE_WEB_EVENTS_SCOUT_DEADLINE=
# H2_SOURCE_LIVE_WEB_EVENTS_SCOUT_ENABLED: Turn the AI events collector (through Tavily) on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_LIVE_WEB_EVENTS_SCOUT_ENABLED=true
# H2_SOURCE_LIVE_WEB_SCOUT_DEADLINE: Total time per web news collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_LIVE_WEB_SCOUT_DEADLINE=
# H2_SOURCE_LIVE_WEB_SCOUT_ENABLED: Turn the web news collector (through Tavily) on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_LIVE_WEB_SCOUT_ENABLED=true
# H2_SOURCE_MCP_DEADLINE: Total time per MCP registry collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_MCP_DEADLINE=
# H2_SOURCE_MCP_ENABLED: Turn the MCP server registry collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_MCP_ENABLED=true
# H2_SOURCE_NEWS_FEEDS_DEADLINE: Total time per news feed collector call. Empty = twice its timeout.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_NEWS_FEEDS_DEADLINE=
# H2_SOURCE_NEWS_FEEDS_ENABLED: Turn the RSS and Atom news feeds collector on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_NEWS_FEEDS_ENABLED=true
# H2_SOURCE_NPM_ENABLED: Turn the npm packages source on or off.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_NPM_ENABLED=true
# H2_SOURCE_PAGE_READER_DEADLINE: Total time per page reader call. Empty = twice its timeout. Back office only.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_PAGE_READER_DEADLINE=
# H2_SOURCE_PAGE_READER_ENABLED: Turn the page reader (reads a page to check evidence) on or off. Back office only.
# Type: boolean (true or false). Default: true. Example: false
# H2_SOURCE_PAGE_READER_ENABLED=true
# H2_SOURCE_PYPI_DEADLINE: Total time per PyPI collector call. Empty = twice its timeout. Back office only.
# Type: duration (10s, 2m). Default: empty. Example: 60s
# H2_SOURCE_PYPI_DEADLINE=
# H2_SOURCE_PYPI_ENABLED: Turn the PyPI packages collector on or off; it also needs the BigQuery project and key.
# Type: boolean (true or false). Default: false. Example: true
# H2_SOURCE_PYPI_ENABLED=false
# H2_SOURCE_SEMANTIC_MAX_DISTANCE: Max vector distance for a semantic match; lower = stricter.
# Type: decimal number, 0 to 2. Default: 0.65. Example: 0.5
# H2_SOURCE_SEMANTIC_MAX_DISTANCE=0.65
# H2_SOURCE_SEMANTIC_TIMEOUT: Timeout of the vector search per query.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 3s. Example: 6s
# H2_SOURCE_SEMANTIC_TIMEOUT=3s
# --- Scout (back office): intervals (ISO-8601), daily caps and per-run limits.
# H2_SCOUT_AI_DEADLINES_INTERVAL: How often the AI conference deadlines collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1D. Example: P2D
# H2_SCOUT_AI_DEADLINES_INTERVAL=P1D
# H2_SCOUT_AWESOME_CLASSIFIER_DAILY_CALLS: Model calls per UTC day to classify awesome-list entries.
# Type: integer. Default: 300. Example: 600
# H2_SCOUT_AWESOME_CLASSIFIER_DAILY_CALLS=300
# H2_SCOUT_AWESOME_INTERVAL: How often the awesome-list collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1D. Example: P2D
# H2_SCOUT_AWESOME_INTERVAL=P1D
# H2_SCOUT_AWESOME_LINKS_PER_DAY: Links from awesome lists followed per UTC day.
# Type: integer. Default: 50. Example: 100
# H2_SCOUT_AWESOME_LINKS_PER_DAY=50
# H2_SCOUT_AWESOME_MAX_README_BYTES: README bytes read per awesome-list run.
# Type: data size (512KB, 50MB, 1GB). Default: 50MB. Example: 100MB
# H2_SCOUT_AWESOME_MAX_README_BYTES=50MB
# H2_SCOUT_AWESOME_MAX_RUN_TIME: Max time of one awesome-list run.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT15M. Example: PT30M
# H2_SCOUT_AWESOME_MAX_RUN_TIME=PT15M
# H2_SCOUT_AWESOME_NESTED_DEPTH: How deep the collector follows awesome lists linked from awesome lists.
# Type: integer. Default: 2. Example: 4
# H2_SCOUT_AWESOME_NESTED_DEPTH=2
# H2_SCOUT_AWESOME_NESTED_LISTS: Nested awesome lists read per run.
# Type: integer. Default: 30. Example: 60
# H2_SCOUT_AWESOME_NESTED_LISTS=30
# H2_SCOUT_AWESOME_PER_RUN: Awesome-list entries taken per run.
# Type: integer. Default: 1000. Example: 2000
# H2_SCOUT_AWESOME_PER_RUN=1000
# H2_SCOUT_COURSES_INTERVAL: How often the AI courses collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SCOUT_COURSES_INTERVAL=P7D
# H2_SCOUT_DAILY_CREDITS: Tavily credits the Scout collectors may spend per UTC day.
# Type: integer. Default: 40. Example: 80
# H2_SCOUT_DAILY_CREDITS=40
# H2_SCOUT_DAILY_ENRICHMENT_CALLS: Model calls per UTC day to enrich catalog entries (summary, category, tags). Back office only.
# Type: integer. Default: 500. Example: 1000
# H2_SCOUT_DAILY_ENRICHMENT_CALLS=500
# H2_SCOUT_DISCOVERY_DEPTH: Tavily search depth of the discovery collector: basic or advanced.
# Type: basic or advanced. Default: advanced. Example: basic
# H2_SCOUT_DISCOVERY_DEPTH=advanced
# H2_SCOUT_DISCOVERY_INTERVAL: How often the web discovery collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SCOUT_DISCOVERY_INTERVAL=P7D
# H2_SCOUT_EVENT_READER_DAILY_CALLS: Model calls per UTC day to read event pages.
# Type: integer. Default: 40. Example: 80
# H2_SCOUT_EVENT_READER_DAILY_CALLS=40
# H2_SCOUT_EVIDENCE_PAGE_READ_TTL: How long a page counts as read, so it is not read again.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P30D. Example: P60D
# H2_SCOUT_EVIDENCE_PAGE_READ_TTL=P30D
# H2_SCOUT_EVIDENCE_PAGE_TEXT_TTL: How long a read page's text is cached.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT24H. Example: PT48H
# H2_SCOUT_EVIDENCE_PAGE_TEXT_TTL=PT24H
# H2_SCOUT_GAP_DAILY_CALLS: Model calls per UTC day to fill gaps in catalog entries. Back office only.
# Type: integer. Default: 400. Example: 800
# H2_SCOUT_GAP_DAILY_CALLS=400
# H2_SCOUT_HF_INTERVAL: How often the Hugging Face trending collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1D. Example: P2D
# H2_SCOUT_HF_INTERVAL=P1D
# H2_SCOUT_HF_ORGS_INTERVAL: How often the Hugging Face provider organisations collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1D. Example: P2D
# H2_SCOUT_HF_ORGS_INTERVAL=P1D
# H2_SCOUT_KNOWN_TARGETS_OWNER_MIN_RESOURCES: GitHub or Hugging Face resources an owner needs to be proposed as a vendor. Back office only.
# Type: integer, at least 1. Default: 5. Example: 10
# H2_SCOUT_KNOWN_TARGETS_OWNER_MIN_RESOURCES=5
# H2_SCOUT_KNOWN_TARGETS_PER_DAY: Known vendors and services the Scout proposes for review per UTC day; 0 turns it off. Back office only.
# Type: integer. Default: 25. Example: 0
# H2_SCOUT_KNOWN_TARGETS_PER_DAY=25
# H2_SCOUT_LINKEDIN_INTERVAL: How often the LinkedIn collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SCOUT_LINKEDIN_INTERVAL=P7D
# H2_SCOUT_LIVE_WEB_EVENTS_INTERVAL: How often the AI events collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SCOUT_LIVE_WEB_EVENTS_INTERVAL=P7D
# H2_SCOUT_LIVE_WEB_EVENTS_MAX_PAGES: Event pages read per run.
# Type: integer. Default: 20. Example: 40
# H2_SCOUT_LIVE_WEB_EVENTS_MAX_PAGES=20
# H2_SCOUT_LIVE_WEB_INTERVAL: How often the web news collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P5D. Example: P10D
# H2_SCOUT_LIVE_WEB_INTERVAL=P5D
# H2_SCOUT_MCP_INTERVAL: How often the MCP registry collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT1H. Example: PT2H
# H2_SCOUT_MCP_INTERVAL=PT1H
# H2_SCOUT_MCP_ITEMS_PER_RUN: MCP servers taken per run. Back office only.
# Type: integer. Default: 5000. Example: 10000
# H2_SCOUT_MCP_ITEMS_PER_RUN=5000
# H2_SCOUT_NEWS_FEEDS_INTERVAL: How often the news feeds collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1D. Example: P2D
# H2_SCOUT_NEWS_FEEDS_INTERVAL=P1D
# H2_SCOUT_PAGE_READER_DAILY_CREDITS: Tavily credits per UTC day for the page reader. Back office only.
# Type: integer. Default: 20. Example: 40
# H2_SCOUT_PAGE_READER_DAILY_CREDITS=20
# H2_SCOUT_PYPI_CANDIDATES_PER_DAY: New PyPI packages taken per UTC day.
# Type: integer. Default: 20. Example: 40
# H2_SCOUT_PYPI_CANDIDATES_PER_DAY=20
# H2_SCOUT_PYPI_INTERVAL: How often the PyPI collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P1D. Example: P2D
# H2_SCOUT_PYPI_INTERVAL=P1D
# H2_SCOUT_PYPI_MAX_BYTES_BILLED: Max bytes one BigQuery query may scan; past it the query is refused.
# Type: integer (bytes). Default: 20000000000. Example: 40000000000
# H2_SCOUT_PYPI_MAX_BYTES_BILLED=20000000000
# H2_SCOUT_SDKS_DEPS_DEV_URL: deps.dev API that maps a repository to its published packages.
# Type: URL. Default: https://api.deps.dev. Example: https://api.deps.dev
# H2_SCOUT_SDKS_DEPS_DEV_URL=https://api.deps.dev
# H2_SCOUT_SDKS_INTERVAL: How often the AI libraries and SDKs collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SCOUT_SDKS_INTERVAL=P7D
# H2_SCOUT_SDKS_LANGUAGES: Languages searched for SDKs, each with its minimum stars (Language:stars).
# Type: comma-separated list of Language:min-stars. Default: Java:1000, Kotlin:1000, Python:5000, TypeScript:5000, JavaScript:5000, Go:1000, Rust:1000, C#:1000, Ruby:1000. Example: Java:1000, Python:5000
# H2_SCOUT_SDKS_LANGUAGES=Java:1000, Kotlin:1000, Python:5000, TypeScript:5000, JavaScript:5000, Go:1000, Rust:1000, C#:1000, Ruby:1000
# H2_SCOUT_SDKS_ORGS: GitHub organisations whose repositories are taken as SDK candidates.
# Type: comma-separated list of GitHub organisations. Default: openai, anthropics, google-gemini, googleapis, aws, Azure, mistralai, cohere-ai, huggingface, ollama, langchain-ai, langchain4j, spring-projects, run-llama, microsoft, deepjavalibrary, oracle, awslabs. Example: openai, anthropics
# H2_SCOUT_SDKS_ORGS=openai, anthropics, google-gemini, googleapis, aws, Azure, mistralai, cohere-ai, huggingface, ollama, langchain-ai, langchain4j, spring-projects, run-llama, microsoft, deepjavalibrary, oracle, awslabs
# H2_SCOUT_SDKS_ORG_MIN_STARS: Minimum stars of a repository from those organisations.
# Type: integer. Default: 300. Example: 600
# H2_SCOUT_SDKS_ORG_MIN_STARS=300
# H2_SCOUT_SDKS_PACKAGES_PER_REPO: Packages kept per repository.
# Type: integer. Default: 3. Example: 6
# H2_SCOUT_SDKS_PACKAGES_PER_REPO=3
# H2_SCOUT_SDKS_PAGES_PER_QUERY: Result pages read per GitHub search query.
# Type: integer. Default: 3. Example: 6
# H2_SCOUT_SDKS_PAGES_PER_QUERY=3
# H2_SCOUT_SDKS_PER_DAY: SDK repositories taken per UTC day.
# Type: integer. Default: 500. Example: 1000
# H2_SCOUT_SDKS_PER_DAY=500
# H2_SCOUT_SDKS_PER_QUERY: Results per GitHub search page.
# Type: integer. Default: 100. Example: 200
# H2_SCOUT_SDKS_PER_QUERY=100
# H2_SCOUT_SDKS_QUERIES_PER_RUN: GitHub search queries per run.
# Type: integer. Default: 20. Example: 40
# H2_SCOUT_SDKS_QUERIES_PER_RUN=20
# H2_SCOUT_SDKS_RATE_LIMIT_RESERVE: GitHub search calls left unused, so other collectors still have some.
# Type: integer. Default: 10. Example: 20
# H2_SCOUT_SDKS_RATE_LIMIT_RESERVE=10
# H2_SCOUT_SDKS_SEARCH_PAUSE: Pause between two GitHub search calls.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 2s. Example: 4s
# H2_SCOUT_SDKS_SEARCH_PAUSE=2s
# H2_SCOUT_SDKS_TOPICS: GitHub topics searched for SDKs.
# Type: comma-separated list of GitHub topics. Default: llm, ai-agents, agents, rag, chatbot, mcp, model-context-protocol, generative-ai, large-language-models, llm-framework, openai, anthropic, gemini, ollama, openai-api, sdk. Example: llm, rag
# H2_SCOUT_SDKS_TOPICS=llm, ai-agents, agents, rag, chatbot, mcp, model-context-protocol, generative-ai, large-language-models, llm-framework, openai, anthropic, gemini, ollama, openai-api, sdk
# H2_SCOUT_TICK: How often the Scout scheduler checks which collector is due. Back office only.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: PT10M. Example: PT20M
# H2_SCOUT_TICK=PT10M
# H2_SCOUT_TOPIC_LEADERS_INDEX_MIN_STARS: Minimum stars of a topic leader indexed without a review.
# Type: integer. Default: 1000. Example: 3000
# H2_SCOUT_TOPIC_LEADERS_INDEX_MIN_STARS=1000
# H2_SCOUT_TOPIC_LEADERS_INDEX_PER_TOPIC: Repositories indexed per topic without a review; 0 turns it off.
# Type: integer, at most 1000. Default: 1000. Example: 0
# H2_SCOUT_TOPIC_LEADERS_INDEX_PER_TOPIC=1000
# H2_SCOUT_TOPIC_LEADERS_INDEX_PUSHED_WITHIN: A topic leader is indexed without a review only if it changed inside this time.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P90D. Example: P180D
# H2_SCOUT_TOPIC_LEADERS_INDEX_PUSHED_WITHIN=P90D
# H2_SCOUT_TOPIC_LEADERS_INTERVAL: How often the topic leaders collector runs.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_SCOUT_TOPIC_LEADERS_INTERVAL=P7D
# H2_SCOUT_TOPIC_LEADERS_MIN_STARS: Minimum stars of a topic leader.
# Type: integer. Default: 3000. Example: 6000
# H2_SCOUT_TOPIC_LEADERS_MIN_STARS=3000
# H2_SCOUT_TOPIC_LEADERS_PER_DAY: Topic leaders taken per UTC day.
# Type: integer. Default: 25. Example: 50
# H2_SCOUT_TOPIC_LEADERS_PER_DAY=25
# H2_SCOUT_TOPIC_LEADERS_PER_TOPIC: Repositories read per topic.
# Type: integer. Default: 50. Example: 100
# H2_SCOUT_TOPIC_LEADERS_PER_TOPIC=50
# H2_SCOUT_TOPIC_LEADERS_SEARCH_PAUSE: Pause between two GitHub search calls of the topic leaders.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 2s. Example: 4s
# H2_SCOUT_TOPIC_LEADERS_SEARCH_PAUSE=2s
# H2_SCOUT_TOPIC_LEADERS_TOPICS: GitHub topics read for topic leaders.
# Type: comma-separated list of GitHub topics. Default: llm, ai-agents, agents, rag, chatbot, mcp, model-context-protocol, speech-recognition, generative-ai, large-language-models, llm-framework, structured-output, machine-learning, deep-learning. Example: llm, ai-agents
# H2_SCOUT_TOPIC_LEADERS_TOPICS=llm, ai-agents, agents, rag, chatbot, mcp, model-context-protocol, speech-recognition, generative-ai, large-language-models, llm-framework, structured-output, machine-learning, deep-learning
# --- Circuit breakers and bulkheads.
# H2_RESILIENCE_CATALOG_MAX_CONCURRENT: Catalog queries run at once per replica.
# Type: integer. Default: 3. Example: 6
# H2_RESILIENCE_CATALOG_MAX_CONCURRENT=3
# H2_RESILIENCE_COLLECTOR_MAX_ATTEMPTS: Tries per collector call, the first included.
# Type: integer. Default: 3. Example: 6
# H2_RESILIENCE_COLLECTOR_MAX_ATTEMPTS=3
# H2_RESILIENCE_COLLECTOR_OPEN_FOR: How long a collector's circuit breaker stays open after too many failures.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 1m. Example: 2m
# H2_RESILIENCE_COLLECTOR_OPEN_FOR=1m
# H2_RESILIENCE_DB_CACHE_MAX_CONCURRENT: Database cache calls run at once per replica.
# Type: integer. Default: 2. Example: 4
# H2_RESILIENCE_DB_CACHE_MAX_CONCURRENT=2
# H2_RESILIENCE_DB_CACHE_OPEN_FOR: How long the database cache's circuit breaker stays open.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 30s. Example: 60s
# H2_RESILIENCE_DB_CACHE_OPEN_FOR=30s
# H2_RESILIENCE_LLM_OPEN_FOR: How long the model's circuit breaker stays open; meanwhile AI features degrade.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 30s. Example: 60s
# H2_RESILIENCE_LLM_OPEN_FOR=30s
# H2_RESILIENCE_LLM_SLOW_CALL: A guide model call slower than this counts as slow for the circuit breaker. Public app only.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 35s. Example: 70s
# H2_RESILIENCE_LLM_SLOW_CALL=35s
# H2_RESILIENCE_REDIS_OPEN_FOR: How long the Redis circuit breaker stays open.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 30s. Example: 60s
# H2_RESILIENCE_REDIS_OPEN_FOR=30s
# H2_RESILIENCE_SOURCE_FAILURE_RATE: Failure rate in percent that opens a source's circuit breaker.
# Type: integer percent, 1 to 100. Default: 50. Example: 30
# H2_RESILIENCE_SOURCE_FAILURE_RATE=50
# H2_RESILIENCE_SOURCE_MAX_CONCURRENT: Calls to one source run at once per replica.
# Type: integer. Default: 20. Example: 40
# H2_RESILIENCE_SOURCE_MAX_CONCURRENT=20
# H2_RESILIENCE_SOURCE_OPEN_FOR: How long a source's circuit breaker stays open.
# Type: duration (500ms, 30s, 5m, 24h, 7d). Default: 30s. Example: 60s
# H2_RESILIENCE_SOURCE_OPEN_FOR=30s
# --- Retention: how long each kind of record is kept, and when the purge runs.
# H2_RETENTION_ADMIN_AUDIT: How long the back office audit log is kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P730D. Example: P1460D
# H2_RETENTION_ADMIN_AUDIT=P730D
# H2_RETENTION_CRON: When the daily purge of expired data runs (Spring cron, UTC).
# Type: cron, Spring format (second minute hour day month weekday), UTC. Default: 0 17 3 * * *. Example: 0 30 2 * * *
# H2_RETENTION_CRON=0 17 3 * * *
# H2_RETENTION_ENRICHMENT_RUNS: How long enrichment run records are kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P90D. Example: P180D
# H2_RETENTION_ENRICHMENT_RUNS=P90D
# H2_RETENTION_INACTIVE_ACCOUNTS: How long an account with no sign-in is kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P730D. Example: P1460D
# H2_RETENTION_INACTIVE_ACCOUNTS=P730D
# H2_RETENTION_LIST_INDEX: How long the index of awesome-list entries is kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P30D. Example: P60D
# H2_RETENTION_LIST_INDEX=P30D
# H2_RETENTION_LIVE_WEB_RESULTS: How long live web results are kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P7D. Example: P14D
# H2_RETENTION_LIVE_WEB_RESULTS=P7D
# H2_RETENTION_OBSERVED_UNSEEN: How long a catalog entry no source has seen again is kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P180D. Example: P360D
# H2_RETENTION_OBSERVED_UNSEEN=P180D
# H2_RETENTION_PAST_EVENTS: How long an event is kept after it ended.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P3650D. Example: P365D
# H2_RETENTION_PAST_EVENTS=P3650D
# H2_RETENTION_RESOLVED_ISSUE_REPORTS: How long a resolved issue report is kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P365D. Example: P730D
# H2_RETENTION_RESOLVED_ISSUE_REPORTS=P365D
# H2_RETENTION_RESOLVED_REVIEW_ITEMS: How long a resolved review queue item is kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P180D. Example: P360D
# H2_RETENTION_RESOLVED_REVIEW_ITEMS=P180D
# H2_RETENTION_RUNTIME_SETTINGS: How long old values of runtime settings are kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P730D. Example: P1460D
# H2_RETENTION_RUNTIME_SETTINGS=P730D
# H2_RETENTION_SCOUT_RUNS: How long Scout run records are kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P90D. Example: P180D
# H2_RETENTION_SCOUT_RUNS=P90D
# H2_RETENTION_WEB_NEWS: How long web news items are kept.
# Type: duration, ISO-8601 (PT30S, PT5M, P7D). Default: P180D. Example: P360D
# H2_RETENTION_WEB_NEWS=P180D
