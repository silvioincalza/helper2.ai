# Flowchart: where each kind of telemetry goes, and the switches that decide it.
# Shows the actuator filter, trace export and sampling, the context wrapper for search threads,
# structured logs on stdout, the pull of meters on the management port, the Grafana dashboard and the alert rules.
# Source of truth: backend/libs/platform/src/main/resources/searchavo-shared.yaml
#   (management.*: the application tag, logging.structured),
#   backend/libs/platform/src/main/java/ai/searchavo/platform/observability/ObservabilityConfiguration.java,
#   backend/libs/core/src/main/java/ai/searchavo/search/config/SearchConfiguration.java, MicrometerSearchMetrics.java,
#   backend/libs/platform/src/main/java/ai/searchavo/platform/llm/ModelCallMetrics.java, internal/LlmConfiguration.java,
#   backend/libs/platform/src/main/java/ai/searchavo/platform/http/ObservedHttp.java, backend/libs/core/src/main/java/ai/searchavo/sources/config/LiveSourcesConfiguration.java, backend/apps/backoffice/src/main/java/ai/searchavo/sources/config/scout/CollectorsConfiguration.java,
#   backend/apps/backoffice/src/main/kotlin/ai/searchavo/scout/usecase/RunScout.kt (searchavo.scout.interval),
#   backend/apps/backoffice/src/main/java/ai/searchavo/scout/internal/LastSuccessGauges.java (searchavo.scout.last.success from scout_run),
#   backend/apps/public/src/main/java/ai/searchavo/guide/web/GuideStreamController.java (searchavo.guide.first_useful),
#   deploy/helm/searchavo/templates/app.yaml, prometheusrule.yaml, deploy/helm/searchavo/values.yaml, deploy/grafana/searchavo.json, searchavo-backoffice.json,
#   deploy/monitoring/searchavo-rules.yaml; the data store exporters: deploy/helm/searchavo/templates/exporters.yaml,
#   files/redis-users.acl, backend/libs/schema/src/main/java/ai/searchavo/platform/schema/MonitorLogin.java.
# Render: cd docs/architecture/diagrams && d2 fmt flow-0009-observability.d2 && d2 flow-0009-observability.d2 flow-0009-observability.svg

...@style

direction: down

req: "HTTP request" {class: end}
act: "Path under /actuator?\n(probes, scrapes)" {class: decision}
noobs: "No observation:\nno span, no http.server.requests" {class: end}
obs: "Server observation:\nspan + http.server.requests" {class: app}

work: Inside the request {
  class: group
  direction: down
  ctx: "searchExecutor wrapped by\nContextExecutorService:\nsource calls keep the trace" {class: app}
  client: "ObservedHttp RestClient\n(sources, embedder; bounded URI):\nclient span, http.client.requests,\ntrace headers" {class: app}
  model: "ModelCallMetrics.observe\n(guide steps, translate, tool-guide,\nenrich, classify): span +\nsearchavo.llm.call, tokens" {class: app}
  meters: "Domain meters: searchavo.search.*,\nsearchavo.source.*, searchavo.cache.events,\nsearchavo.catalog.*, searchavo.embedding.*,\n*.budget.remaining gauges …" {class: app}
  useful: "Guide stream: first retrieved\nor clarify event sent?\n→ searchavo.guide.first_useful{intent}\n(target p50 3 s, p95 8 s)" {class: app}
  useful -> meters
  ctx -> client
  ctx -> meters
  model -> meters
}

traces: Traces {
  class: group
  direction: down
  export: "SA_TRACING_EXPORT=true?\n(chart: true; default false)" {class: decision}
  drop: "Not exported" {class: end}
  sample: "Sampled? (SA_TRACING_SAMPLING, 1.0)" {class: decision}
  otlp: "OTLP/HTTP to SA_OTLP_TRACES_ENDPOINT\n(Alloy :4318 → Tempo)" {class: ext}
  export -> drop: no
  export -> sample: yes
  sample -> otlp: yes {class: hot}
  sample -> drop: no
}

logs: "Structured logs on stdout\n(SA_LOG_FORMAT=logstash JSON,\ntraceId and spanId; no OTLP copy)" {class: app}

metrics: Metrics {
  class: group
  direction: down
  registry: "Micrometer registry\n(tags application = searchavo or\nsearchavo-backoffice, environment;\nbuckets for latency timers)" {class: app}
  endpoint: "/actuator/prometheus on\nSA_MANAGEMENT_PORT 8081" {class: app}
  scrape: "Alloy scrapes (pod annotations)\n→ remote write to Prometheus" {class: ext}
  grafana: "Grafana: searchavo.json (public app:\nHTTP, search, guide, runtime) and\nsearchavo-backoffice.json (Scout, budgets,\nindexer, admin); latency from _bucket" {class: ext}
  alerts: "Alert rules deploy/monitoring/searchavo-rules.yaml\n(rule file, or PrometheusRule with\nmonitoring.prometheusRule.enabled):\nper app by the application tag; first\nuseful p95 > 8 s for 15 min warns;\nRedis evictions in 15 min warn;\none OOM kill of a container warns;\na Scout collector warns one day past\nits run interval (searchavo.scout.interval,\nat least a day); its last success is\nread from scout_run on each scrape" {class: config}
  exporters: "monitoring.exporters.enabled?\n(staging and prod)" {class: decision}
  stores: "postgres-exporter :9187 as h2_monitor\n(pg_monitor, no table, no query text);\nredis-exporter :9121 as h2_monitor\n(PING, INFO; no key, no CONFIG)" {class: app}
  registry -> endpoint
  endpoint -> scrape: {class: hot}
  exporters -> stores: yes
  stores -> scrape: "pg_ and redis_ names on\nthe scraper's allow-list"
  scrape -> grafana: {class: hot}
  scrape -> alerts: {class: config}
}

req -> act
act -> noobs: yes
act -> obs: no {class: hot}
obs -> work.ctx: {class: hot}
obs -> work.model
obs -> traces.export
work.client -> traces.export
work.model -> traces.export
obs -> logs
work.meters -> metrics.registry: {class: hot}
obs -> metrics.registry
