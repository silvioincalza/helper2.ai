# Flowchart: how a pass reads nested awesome lists, where each link of an entry goes by its kind, and where categories come from (ADR 0013).
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/AwesomeCrawl.java, ListEntryLinks.java, ProductLinks.java,
#   backend/libs/kernel/src/main/kotlin/ai/helper2/shared/WebAddresses.kt (the host check),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/ListSeeds.kt (ListSeedStore, HostsNeverRead),
#   WebPageLists.java, WebPageReader.java, libs/core sources/config/CollectorDescriptors.java (curatedWebLists) (an added web page), AwesomeLists.java (readsAsList),
#   AwesomeListParser.java (Item, Link, Entry.pointsAtList), GitHubAwesomeCollector.java (read, links, readModels, candidate, searchEntries),
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/huggingface/scout/HuggingFaceModelReader.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/arxiv/scout/ArxivPaperReader.java, sources/npm/scout/NpmPackageReader.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/CoursePages.java, DiscoveryPages.java (productSite),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/admission/Admission.kt (AdmissionPolicy, IndexFloor),
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java (propose with a daily cap),
#   backend/libs/kernel/src/main/kotlin/ai/helper2/shared/Categories.kt (CategoryMatcher, headings),
#   backend/libs/core/src/main/java/ai/helper2/catalog/usecase/IndexAwesomeLists.java, RefreshCategories.java, catalog/internal/JdbcCategoryLabels.java.
# Render: cd docs/architecture/diagrams && d2 fmt flow-0013-awesome-deep-search.d2 && d2 flow-0013-awesome-deep-search.d2 flow-0013-awesome-deep-search.svg

...@style

direction: down

seeds: "Seed lists (depth 0, queued first):\nthe GitHub lists an administrator added (list_seed),\nthen the top 10 of the search by stars" {class: end}

pages: "WebPageLists: each web page an administrator added,\nthe one tried longest ago first" {
  class: group
  direction: down
  never: "Host in the never-read setting\n(a subdomain matches)?" {class: decision}
  refused: "Not read\n(skip: page-never-read)" {class: end}
  due: "Never tried, or the last try\n7 days ago, or 1 hour ago after\n1 or 2 failed tries in a row?" {class: decision}
  can: "Time and size budget left, a page\nreader, and the Scout's daily\nlive web credits not spent?" {class: decision}
  waits: "Waits for the next pass (skip: time-budget,\nsize-budget, page-reader-off, page-credit-cap);\nnothing is withdrawn" {class: end}
  read: "Store the try (failed tries + 1), count 1 credit (scout-list-pages),\nread the page as Markdown through the\nlive web page reader (collector-gap-web)" {class: ext}
  ok: "Text, from the host asked?" {class: decision}
  failed: "Skip: page-unavailable; tried again at the\nnext pass (1 hour), after 3 in a row in 7 days" {class: end}
  parse: "AwesomeListParser reads the Markdown like a README;\nfailed tries back to 0; list_seed_last_read replaced:\nheadings, entries, links, the two counts, never the text" {class: app}
  last: "What the last read gave\n(list_seed_last_read), if any" {class: data}
  never -> refused: "yes"
  never -> due: "no"
  due -> last: "no"
  due -> can: "yes"
  can -> waits: "no"
  waits -> last
  can -> read: "yes"
  read -> ok
  ok -> failed: "no"
  failed -> last
  ok -> parse: "yes"
  parse -> last
}

crawl: "AwesomeCrawl (breadth first)" {
  class: group
  direction: down
  budget: "Time (15 min) or README\nbytes (50 MB) spent?" {class: decision}
  unread: "Lists left wait for the next pass\n(skip: time-budget / size-budget)" {class: end}
  nested: "Nested list?" {class: decision}
  added: "Added by an administrator\nand not found by the search?" {class: decision}
  addedFacts: "GET /repos/{owner}/{repo}:\nfound and not archived?\n(no star floor, no AI words)" {class: decision}
  addedSkipped: "Skipped, stays added\n(skip: added-archived, added-unavailable)" {class: end}
  facts: "GET /repos/{owner}/{repo}:\nnot archived, not a fork, 50+ stars,\nAI words in name, description, topics?" {class: decision}
  dropped: "Not followed\n(skip: nested-archived, -fork,\n-few-stars, -not-ai, -unavailable)" {class: end}
  readme: "GET README (5 MB, 60 s)\nparse: entries, headings, links" {class: app}
  limited: "Rate limited?" {class: decision}
  stop: "Seed: the pass fails.\nNested: stop following,\nkeep what was read" {class: fail}
  listlinks: "For each entry that points at a list\n(name says awesome, or a section of lists)" {class: decision}
  queue: "Queue at depth + 1" {class: app}
  skipped: "Skip: nested-depth (depth 2 reached),\nnested-seen (read or queued: cycle guard),\nnested-cap (30 tried this run)" {class: end}
  budget -> unread: "yes"
  budget -> nested: "no"
  nested -> added: "no (seed)"
  added -> readme: "no"
  added -> addedFacts: "yes"
  addedFacts -> addedSkipped: "no"
  addedFacts -> readme: "yes"
  nested -> facts: "yes"
  facts -> dropped: "no"
  facts -> readme: "yes"
  readme -> limited
  limited -> stop: "yes"
  limited -> listlinks: "no"
  listlinks -> queue: "new, under depth and cap"
  listlinks -> skipped: "otherwise"
  queue -> budget: "next in queue"
}

lists: "Every list read: a list resource (awesome-list)\nand its text for the list index; its entries join\nthe pass (lists read left out). A web page:\nsource curated-web-lists, its address, its first heading\nas title, AWESOME_LIST with 20 linked items that are\nhalf its lines, else ARTICLE" {class: app}

links: "ListEntryLinks: every link of an entry, outside GitHub" {
  class: group
  direction: down
  safe: "https, a public name: no IP, user info,\nport, private name, punycode, redirect,\nshortener or GitHub page?" {class: decision}
  model: "huggingface.co/{owner}/{name}\nand the Hub reader is on?" {class: decision}
  cap: "Under 100 models this pass,\ntime budget left, Hub answering?" {class: decision}
  wait: "Left for the next pass (skip: model-cap,\ntime-budget, model-rate-limited,\nmodel-unavailable)" {class: end}
  hub: "GET /api/models/{owner}/{name}:\nfound?" {class: decision}
  gone: "Nothing (skip: model-not-found)" {class: end}
  floor: "AdmissionPolicy, the lists' floor:\n10 likes?" {class: decision}
  hit: "MODEL hit with the Hub's facts" {class: app}
  paper: "arxiv.org/abs|pdf/{id}\nand the arXiv reader is on?" {class: decision}
  arxiv: "Under 200 papers this pass: take the shared\n3 s slot, GET /api/query?id_list (50 ids);\nknown, in an AI category?" {class: decision}
  paperHit: "PAPER hit (no author, no PDF)" {class: app}
  package: "npmjs.com/package/{name}\nand the registry reader is on?" {class: decision}
  registry: "Under 100 packages this pass:\nGET /{name}/latest; found, about AI?" {class: decision}
  packageHit: "Package hit; a deprecated one is refused\nby the vitality rule; joins its repository\n(RepositoryJoin)" {class: app}
  nothing: "Nothing (skip: paper-not-kept, package-not-found,\npackage-not-ai; the rest waits on a cap,\na rate limit or a failure)" {class: end}
  course: "On a course platform's host and path,\nabout AI, reads like a course?" {class: decision}
  excluded: "Excluded domain?" {class: decision}
  site: "DiscoveryPages.productSite:\nhome page or one-level page?\n(no docs, blogs, articles)" {class: decision}
  skip: "Skipped (skip: link-<reason>)" {class: end}
  keep: "Candidate: MODEL, COURSE or PRODUCT;\nno query, no fragment;\nonce per pass, at most 500" {class: app}
  safe -> skip: "no"
  safe -> model: "yes"
  model -> cap: "yes"
  cap -> wait: "no"
  cap -> hub: "yes"
  hub -> gone: "no"
  hub -> floor: "yes"
  floor -> hit: "yes"
  floor -> keep: "no: MODEL"
  model -> paper: "no"
  paper -> arxiv: "yes"
  arxiv -> paperHit: "yes"
  arxiv -> nothing: "no"
  paper -> package: "no"
  package -> registry: "yes"
  registry -> packageHit: "yes"
  registry -> nothing: "no"
  package -> course: "no"
  course -> keep: "yes: COURSE"
  course -> excluded: "no"
  excluded -> skip: "yes"
  excluded -> site: "no"
  site -> skip: "no"
  site -> keep: "yes: PRODUCT"
}

tags: "CategoryMatcher: heading path as an input,\neach heading alone (id or words; never\nhealth or legal alone); at most 12 tags" {class: app}

review: "ReviewQueueCandidateReview" {
  class: group
  direction: down
  cap: "Fewer than 50 items opened\nby github-awesome today (UTC)?" {class: decision}
  open: "Open a RESOURCE_CANDIDATE, or a\nCOURSE_CANDIDATE for a course\n(foundBy: list URL, section),\nor join the OPEN item of the site" {class: data}
  join: "Only join the OPEN item\nof the site, if one waits" {class: data}
  cap -> open: "yes"
  cap -> join: "no"
}

assign: "IndexAwesomeLists: after a list's entries are written,\nassign their categories again; JdbcCategoryLabels reads\nthe heading paths of awesome_list_entry" {class: data}

seeds -> crawl.budget
pages.last -> crawl.listlinks: "a seed: its links to lists are followed"
pages.last -> lists
pages.last -> links.safe: "first run of a pass"
crawl.readme -> lists
crawl.readme -> links.safe: "first run of a pass,\nafter the entries"
links.keep -> tags
tags -> review.cap
links.hit -> lists: "indexed with the hits; the list index holds an entry\nrow for every model, paper and package link"
links.paperHit -> lists
links.packageHit -> lists
lists -> assign: "after the hits are indexed"
