# Flowchart: how one hit gets the id of its resource (ADR 0021).
# Source of truth: backend/libs/kernel/src/main/kotlin/ai/helper2/shared/CanonicalUrl.kt (of, github),
#   backend/libs/kernel/src/main/kotlin/ai/helper2/shared/ResourceId.kt (of),
#   backend/libs/core/src/main/kotlin/ai/helper2/search/ResultMerger.kt (joiningRepositories, group, identity),
#   backend/libs/core/src/main/kotlin/ai/helper2/search/RepositoryJoin.kt (of, byRule, CURATED),
#   backend/libs/core/src/main/resources/catalog/repository-joins.properties,
#   backend/libs/kernel/src/main/kotlin/ai/helper2/shared/PlatformBuild.kt (isPlatformBuild),
#   backend/libs/core/src/main/java/ai/helper2/sources/npm/NpmSource.java (toHit),
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/mcp/McpRegistryCollector.java (identity),
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcCatalogWriter.java (upsertResources, upsertRecords).
# Render: cd docs/architecture/diagrams && d2 fmt flow-0021-resource-identity.d2 && d2 flow-0021-resource-identity.d2 flow-0021-resource-identity.svg

...@style

direction: down

hit: "A hit from a source\n(its URL, the repository it states;\nan MCP Registry server: its stated folder,\nelse its registry name)" {class: end}
build: "PlatformBuild: an npm name that ends\nwith a system and a processor\n(-darwin-arm64, -linux-x64-musl)?" {class: decision}
buildout: "A build for one system:\nthe hit is left out,\nthe package it is built for stays" {class: end}
canon: "CanonicalUrl.of: https, host in lower case,\nno www, port, fragment, tracking\nparameters or trailing slash" {class: app}
none: "No canonical URL\n(dot segment, no host):\nthe hit is left out" {class: end}
host: "GitHub, arXiv or\nHugging Face?" {class: decision}
rules: "Host rule: owner/repo in lower case;\na file or an issue names the repository;\ntree/{ref}/{path} -> tree/HEAD/{path};\nevery view of a paper -> arxiv.org/abs/{id}" {class: app}
curated: "An npm or PyPI page on the\ncurated join list?\n(catalog/repository-joins.properties)" {class: decision}
states: "States a repository?\n(npm links.repository,\nPyPI source link,\nMCP Registry repository)" {class: decision}
folder: "Inside the repository\n(its stated sub-directory)?" {class: decision}
subdir: "The stated repository\nis a sub-directory?" {class: decision}
belongs: "RepositoryJoin: its scope is the\nrepository's owner (by word), or\nits name holds the repository's\ntelling words?\n(an MCP Registry server: every telling\nword of one name is in the other)" {class: decision}
repo: "Identity = the repository's address" {class: hot}
own: "Identity = its own address,\na GitHub URL first" {class: app}
id: "ResourceId = UUID v5 of the identity" {class: app}
known: "resource.canonical_url\nalready stored?" {class: decision}
insert: "Insert the resource" {class: data}
merge: "Same row, same id:\nnew facts are merged,\na stronger origin keeps its fields" {class: data}
record: "source_record (source_id, external_id)\nis a record of that resource" {class: data}

hit -> build
build -> buildout: yes
build -> canon: no
canon -> none: none
canon -> host: a URL
host -> rules: yes
host -> curated: no
rules -> curated
curated -> repo: "yes: its curated repository"
curated -> states: no
states -> folder: yes
states -> own: no
folder -> own: yes
folder -> subdir: no
subdir -> repo: yes
subdir -> belongs: no
belongs -> repo: yes
belongs -> own: "no: a result of its own"
repo -> id
own -> id
id -> known
known -> insert: no
known -> merge: yes
insert -> record
merge -> record
