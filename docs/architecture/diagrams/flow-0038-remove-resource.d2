# Flowchart: an admin removes a resource the AI check lists, and what later results with its address do.
# Source of truth: backend/libs/core/src/main/java/ai/helper2/catalog/usecase/RemoveResource.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcResourceRemoval.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcCatalogWriter.java (upsert),
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcReviewQueue.java (proposeCandidate),
#   frontend/src/admin/AiCheckPanel.tsx.
# Render: cd docs/architecture/diagrams && d2 fmt flow-0038-remove-resource.d2 && d2 flow-0038-remove-resource.d2 flow-0038-remove-resource.svg

...@style

direction: down

admin: "Admin, on a row of\nNot about AI by the word rule\n(back office, VPN)" {class: person}
reason: "Reason of 1 to\n500 characters?" {class: decision}
bad: "400, nothing changes" {class: fail}
found: "Resource still listed?" {class: decision}
gone: "404, nothing changes" {class: fail}
remove: "One transaction: REJECTED decision\nand removed_resource for the key;\nresource and what cascades deleted;\naudit REMOVE_RESOURCE (address, reason)" {class: data}
later: "A later result with the address\n(Scout, live search, a candidate)" {class: ext}
origin: "Added by hand\n(CURATED)?" {class: decision}
drop: "Dropped: no resource,\nno record, no review item" {class: end}
back: "Key cleared;\nthe resource comes back" {class: end}

admin -> reason
reason -> bad: no
reason -> found: yes {class: hot}
found -> gone: no
found -> remove: yes {class: hot}
remove -> later
later -> origin
origin -> drop: no {class: hot}
origin -> back: yes
