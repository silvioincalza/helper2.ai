# Flowchart: what the embedder does with one call (ADR 0054).
# Source of truth: deploy/embedder/embedding_api.py, deploy/embedder/server.py,
#   deploy/helm/searchavo/templates/embedder.yaml.
# Render: cd docs/architecture/diagrams && d2 fmt flow-0054-embedding-model-in-the-cluster.d2 && d2 flow-0054-embedding-model-in-the-cluster.d2 flow-0054-embedding-model-in-the-cluster.svg

...@style

direction: down

call: "POST /v1/embeddings\n(public app or back office of\nproduction or staging; nobody else\npasses ingress-embedder)" {class: end}
size: "Content-Length given,\nat most 4 MB?" {class: decision}
toolarge: "411 or 413,\nbody not read" {class: fail}
valid: "JSON object, the served model,\n1 to 32 texts that are not empty,\ninput_type query or passage,\ndimensions 128 to 2048?" {class: decision}
bad: "400 with the reason;\nthe model is not called" {class: fail}
wait: "Wait for the call before it:\none call at a time" {class: app}
prefix: "input_type?" {class: decision}
query: "Prefix query:" {class: app}
passage: "Prefix passage:" {class: app}
encode: "Cut each text at\nEMBEDDER_MAX_TOKENS (1024),\nembed on the CPU: 2048 values" {class: hot}
failed: "Model failure?" {class: decision}
error: "500, no detail in the answer" {class: fail}
shorten: "Keep the first `dimensions` values,\nnormalise again" {class: app}
answer: "200: one vector per text,\nin the order sent" {class: end}

call -> size
size -> toolarge: no
size -> valid: yes
valid -> bad: no
valid -> wait: yes
wait -> prefix
prefix -> query: query
prefix -> passage: passage
query -> encode
passage -> encode
encode -> failed
failed -> error: yes
failed -> shorten: no
shorten -> answer
