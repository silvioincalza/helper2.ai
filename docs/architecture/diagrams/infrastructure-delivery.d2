# Infrastructure, the delivery: how an image gets from GitHub to the cluster (build, sign, check, deploy by
# digest; ADR 0044), and the canary that runs beside production during a release only (ADR 0045).
# Source of truth: .github/workflows/cd.yml, deploy.yml, release.yml, deploy/k8s/Makefile, deploy/k8s/CI.md,
#   deploy/helm/searchavo/templates/canary.yaml, migrate.yaml.
# Render: cd docs/architecture/diagrams && d2 fmt infrastructure-delivery.d2 && d2 infrastructure-delivery.d2 infrastructure-delivery.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

github: "GitHub Actions\n(cd.yml, deploy.yml)" {class: ext}

delivery: "DELIVERY (private network)" {
  class: group
  runner: "Self-hosted GitHub runner\n(one JIT job, no credentials)" {class: app}
  workstation: "Owner workstation\nmake, helm, bao" {class: person}
  openbao: "OpenBao\nsearchavo/kv: ci/<env>, ci/harbor, ci/harbor-pull, backup/r2\nsearchavo/jwt: GitHub OIDC roles\nsearchavo/transit: searchavo-images (signing key)" {
    shape: cylinder
    class: data
  }
  harbor: "Harbor registry\nsearchavo/apps/searchavo-web:<commit>\nsearchavo/apps/searchavo:<commit>\nsearchavo/apps/searchavo-backoffice:<commit>\nsearchavo/apps/postgres:<tag>\nsearchavo/apps/embedder:<tag>" {
    shape: cylinder
    class: data
  }
  runner -> openbao: "OIDC login,\nkv get,\nTransit sign\n(CD only)"
  runner -> harbor: "push image\nand signature;\ncheck signatures\nbefore a deploy"
  workstation -> openbao: "make credentials"
}

cluster: "KUBERNETES · ns searchavo-prod" {
  class: group

  release: "Helm release searchavo" {
    class: group
    migrate: "searchavo-migrate-<revision> Job\nonce per release, before the rollout" {class: app}
    app: "searchavo (public app)\nand the web image of the same tag\n(init container: the shell)" {class: app}
    web: "searchavo-web" {class: app}
    bo: "searchavo-backoffice" {class: app}
  }

  canary: "During a release only: Helm release searchavo-canary (ADR 0045)" {
    class: group
    cingress: "Ingress searchavo-canary\ncanary-by-header X-Searchavo-Canary\n= token of the run, no weight:\nreached with header + token only" {class: config}
    cmigrate: "searchavo-canary-migrate Job\nprod's schema, before the rollout" {class: app}
    capp: "searchavo-canary · 1 pod\npublic image of the release commit\nrole h2_public · Redis user h2_public" {class: app}
    cweb: "searchavo-web-canary · 1 pod\n/assets/ only" {class: app}
    cingress -> capp: "/ (smoke test)"
    cingress -> cweb: "/assets/"
  }

  stores: "prod's Postgres and Redis\n(canary NetworkPolicies)" {
    shape: cylinder
    class: data
  }

  canary.capp -> stores
  canary.cmigrate -> stores: "as the owner"
  release.migrate -> stores: "as the owner"
}

github -> delivery.runner: "job (main only)"
delivery.runner -> cluster: "helm upgrade --wait 12m (deployer ServiceAccount),\nevery image by its checked digest;\na release: the canary first, smoke test, then remove it" {class: config}
delivery.harbor -> cluster: "image pull" {class: config}
