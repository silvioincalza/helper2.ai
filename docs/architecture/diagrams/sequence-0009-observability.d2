# Sequence: the telemetry of one search in the cluster: one trace across threads, meters, logs,
# the time to the first useful event of a guide question, the scrape on the management port and the dashboard read.
# Source of truth: backend/libs/core/src/main/java/ai/searchavo/search/config/SearchConfiguration.java, MicrometerSearchMetrics.java,
#   backend/libs/core/src/main/kotlin/ai/searchavo/search/usecase/SearchResources.kt, backend/libs/platform/src/main/java/ai/searchavo/platform/http/ObservedHttp.java,
#   backend/libs/platform/src/main/resources/searchavo-shared.yaml, deploy/helm/searchavo/templates/app.yaml, networkpolicy.yaml,
#   deploy/grafana/searchavo.json; the guide block: backend/apps/public/src/main/java/ai/searchavo/guide/web/GuideStreamController.java,
#   deploy/monitoring/searchavo-rules.yaml (SearchavoGuideFirstUsefulSlow, SearchavoRedisEvicting, SearchavoScoutCollectorStale); the Scout block:
#   backend/apps/backoffice/src/main/kotlin/ai/searchavo/scout/usecase/RunScout.kt,
#   backend/apps/backoffice/src/main/java/ai/searchavo/scout/internal/LastSuccessGauges.java, JdbcScoutStore.java; the exporters:
#   deploy/helm/searchavo/templates/exporters.yaml, files/redis-users.acl.
# Render: cd docs/architecture/diagrams && d2 fmt sequence-0009-observability.d2 && d2 sequence-0009-observability.d2 sequence-0009-observability.svg

...@style

shape: sequence_diagram

browser: Browser {class: person}
app: "searchavo app\n(port 8080)" {class: app}
bo: "searchavo-backoffice\n(the Scout)" {class: app}
vt: "Virtual thread\n(ContextExecutorService)" {class: app}
gh: "GitHub API" {class: ext}
reg: "Micrometer registry" {class: app}
stdout: "stdout (JSON logs)" {class: data}
alloy: "Grafana Alloy\n(observability ns)" {class: ext}
tempo: Tempo {class: data}
prom: Prometheus {class: data}
pg: "Postgres\n(scout_run)" {class: data}
rexp: "redis-exporter\n(:9121)" {class: app}
redis: "Redis\n(maxmemory, allkeys-lru)" {class: data}
graf: Grafana {class: ext}

browser -> app: "GET /api/v1/search?q=…" {class: hot}
app -> app: "server span starts (trace id T)"
app -> vt: "submit GitHubSource.search (context T)" {class: hot}
vt -> gh: "GET /search/repositories\ntraceparent: T, client span" {class: hot}
gh -> vt: "200"
vt -> reg: "http.client.requests{client_name, status}"
vt -> app: "hits"
app -> reg: "searchavo.source.requests{source,outcome,served_from},\nsearchavo.source.latency{source,outcome}"
app -> reg: "searchavo.cache.events{event},\nsearchavo.search.requests{partial}, searchavo.search.latency"
app -> stdout: "warn line if a source fails\n(traceId T, no query text)"
app -> browser: "200"
app -> alloy: "spans of T over OTLP/HTTP :4318"
alloy -> tempo: "forward spans"

guide: A guide question on the stream {
  browser -> app: "POST /api/v1/guide/stream" {class: hot}
  app -> browser: "event: planned, understood"
  app -> browser: "event: retrieved (or clarify):\nthe first useful event" {class: hot}
  app -> reg: "searchavo.guide.first_useful{intent}:\nrequest to that event, once"
  app -> browser: "event: chosen, validated, checked, answer"
}

scrape: Every scrape {
  alloy -> app: "GET :8081/actuator/prometheus\n(NetworkPolicy: observability ns only)"
  app -> alloy: "text format, no observation\nfor /actuator"
  alloy -> prom: "remote write"
  alloy -> rexp: "GET :9121/metrics\n(observability ns only)"
  rexp -> redis: "INFO as h2_monitor\n(no key, no CONFIG)"
  redis -> rexp: "evicted_keys, used_memory"
  rexp -> alloy: "redis_evicted_keys_total\n(kept by the redis_ allow-list)"
  prom -> prom: "SearchavoRedisEvicting when it\nrose in the last 15 min" {class: hot}
}

scout: The Scout's stale check {
  bo -> reg: "start-up: searchavo.scout.interval{source}\nfor every collector"
  alloy -> bo: "GET :8081/actuator/prometheus"
  bo -> pg: "SELECT newest SUCCEEDED scout_run\nper source (at most every 30 s)"
  pg -> bo: "searchavo.scout.last.success{source};\na run not due is SKIPPED and leaves it"
  alloy -> prom: "remote write"
  prom -> prom: "now - max last success over 9 d >\nmax(interval, 1 d) + 1 d → SearchavoScoutCollectorStale" {class: hot}
}

graf -> prom: "dashboard searchavo: PromQL per environment;\nlatency: histogram_quantile over _bucket"
prom -> graf: "series"
prom -> prom: "rules: p95 of first useful > 8 s\nfor 15 min → SearchavoGuideFirstUsefulSlow"
