# Sequence: a package seen alone, then its repository, are written to one resource (ADR 0021).
# Source of truth: backend/libs/core/src/main/kotlin/ai/searchavo/search/ResultMerger.kt, RepositoryJoin.kt,
#   backend/libs/core/src/main/java/ai/searchavo/catalog/ResourceDetail.java (SourceRecordInfo.of),
#   backend/libs/kernel/src/main/kotlin/ai/searchavo/shared/CanonicalUrl.kt, ResourceId.kt,
#   backend/libs/core/src/main/java/ai/searchavo/catalog/internal/JdbcCatalogWriter.java,
#   backend/libs/core/src/main/java/ai/searchavo/catalog/internal/JdbcResources.java (ownerOfRecordUrl).
# Render: cd docs/architecture/diagrams && d2 fmt sequence-0021-resource-identity.d2 && d2 sequence-0021-resource-identity.d2 sequence-0021-resource-identity.svg

...@style

shape: sequence_diagram

search: SearchResources {class: app}
merger: ResultMerger {class: app}
join: RepositoryJoin {class: app}
canon: "CanonicalUrl, ResourceId" {class: app}
writer: JdbcCatalogWriter {class: app}
db: "PostgreSQL\nresource, source_record" {class: data}
detail: GetResourceDetail {class: app}
page: "WhereFrom\n(resource page)" {class: app}

first: "search 1: npm answers, GitHub does not" {
  search -> merger: "merge(npm hit @acme/kit, repository github.com/acme/kit)"
  merger -> join: "of(npm hit)"
  join -> merger: "scope acme is the owner: github.com/acme/kit"
  merger -> canon: "identity of the group"
  canon -> merger: "github.com/acme/kit, id R"
  merger -> search: "one result, id R"
  search -> writer: "record(result), off the request path"
  writer -> db: "insert resource R; npm record -> R"
}

second: "search 2: GitHub answers too" {
  search -> merger: "merge(GitHub hit, npm hit)"
  merger -> canon: "identity of the group"
  canon -> merger: "the same address, id R"
  search -> writer: "record(result)"
  writer -> db: "ON CONFLICT (canonical_url): same row R,\nthe repository's record sets title and link;\nGitHub record -> R"
}

collection: "search 3: the MCP Registry lists two servers of one collection repository" {
  search -> merger: "merge(io.github.codespar/mcp-adyen, io.github.codespar/mcp-afip,\nboth stating github.com/codespar/mcp-dev-latam)"
  merger -> join: "of(each server)"
  join -> merger: "the name does not hold mcp-dev-latam: no join"
  merger -> search: "two results, ids of their registry names"
  search -> writer: "record(results)"
  writer -> db: "one resource per server; each record keeps its repository_url"
}

open: "a link made from the npm page" {
  detail -> db: "ownerOfRecordUrl(id of the npm address)"
  db -> detail: "resource R"
}

where: "the detail page of one server" {
  detail -> db: "recordsOf(server)"
  db -> detail: "the record and the repository it states"
  detail -> page: "SourceRecordInfo with repositoryUrl"
  page -> page: "the Repository link of the record"
}
