# Sequence: the owner opens the back office and follows a count into the filtered queue (ADR 0038).
# Source of truth: frontend/src/admin/AdminOverview.tsx, ReviewQueuePage.tsx,
#   backend/apps/backoffice/src/main/java/ai/searchavo/admin/usecase/GetOverview.java, admin/web/OverviewController.java,
#   catalog/ReviewQueue.java (openCountsByKind), scout/internal/CatalogEnrichmentStore.java, catalog/internal/JdbcEnrichmentCandidates.java (pendingCount),
#   catalog/internal/JdbcValidationIssues.java, examples/usecase/CountHomeExamples.java, examples/internal/JdbcHomeExamples.java (all), platform/llm/BudgetLedger.java,
#   admin/usecase/GetReviewEvidence.java, catalog/internal/JdbcReviewEvidence.java, frontend/src/admin/ReviewEvidence.tsx,
#   frontend/src/admin/EnrichmentQueuePage.tsx, admin/web/EnrichmentQueueController.java,
#   scout/usecase/PrioritiseEnrichment.kt, scout/internal/JdbcEnrichmentQueueControl.java,
#   admin/usecase/ResolveReviewItems.java, admin/usecase/ResearchedAcceptance.java, frontend/src/admin/ReviewBulk.tsx,
#   admin/usecase/ListReviewQueue.java, admin/usecase/ReviewItemViews.java, admin/web/ReviewItemMapper.java,
#   examples/usecase/ReadExampleDraft.java, scout/internal/ResourceCandidateJson.java (shown),
#   catalog/internal/KnownTargetProposalJson.java, frontend/src/admin/ReviewItemDetails.tsx.
# Render: cd docs/architecture/diagrams && d2 fmt sequence-0038-back-office.d2 && d2 sequence-0038-back-office.d2 sequence-0038-back-office.svg

...@style

shape: sequence_diagram

owner: "Owner\n(admin host)" {class: person}
spa: "Admin pages" {class: app}
api: "Back office\n(admin module)" {class: app}
db: PostgreSQL {class: data}
redis: Redis {class: data}

overview: Overview {
  owner -> spa: "/admin" {class: hot}
  spa -> api: "GET /api/v1/admin/overview"
  api -> db: "open items per kind, backlog count,\nlast runs, every home example,\nvalidation issues of the last 7 days"
  api -> redis: "today's count of each budget,\nweb credits"
  api -> spa: "counts, counted at T (kept one minute),\nand the Grafana link checked at startup:\nhost and path only, or null"
  spa -> owner: "12 User report · 420 waiting ·\nEnrichment 120 of 500 ·\nfield pricing: 812 runs"
}

follow: Follow a count {
  owner -> spa: "12 User report"
  spa -> api: "GET /api/v1/admin/review-items?status=OPEN&kind=USER_REPORT"
  api -> db: "page of open user reports"
  api -> spa: "items, each a view of ListReviewQueue:\nits details typed by shape (TEXT, CANDIDATE,\nKNOWN_TARGET_PROPOSAL), a drafted example\nwith its draft and its aiContent"
  spa -> owner: "/admin/review?kind=USER_REPORT"
}

review: Review with the evidence {
  spa -> api: "GET /api/v1/admin/review-items/{id}/evidence\n(the selected item)"
  api -> db: "the item's links and its run,\nthen fields and quotes (or the relationship)"
  api -> spa: "run, errors, fields with quotes,\naiContent"
  spa -> owner: "the item next to the list,\nAI values labelled"
  owner -> spa: "a (accept)" {class: hot}
  spa -> api: "PUT /api/v1/admin/review-items/{id}/resolution"
  api -> spa: "decided"
  spa -> owner: "next item focused,\n\"Accepted. 11 left.\""
}

act: Act on the enrichment queue {
  owner -> spa: "/admin/enrichment: Move to top"
  spa -> api: "POST /api/v1/admin/enrichment-queue/{id}/prioritise (CSRF)"
  api -> db: "lock the top (pg_advisory_xact_lock),\nwhere the resource stands,\nhow many at the top (backlog rule)"
  api -> db: "one transaction: control row\n+ audit PRIORITISE_ENRICHMENT"
  api -> spa: "204 (409 not-applicable with the reason)"
  spa -> api: "GET /api/v1/admin/enrichment-queue"
  api -> db: "page: at the top first"
  spa -> owner: "\"Acme MCP\" is at the top (focus on the result)"
}

bulk: Decide several at once {
  owner -> spa: "x on 12 rows, Accept,\nconfirm (focus on Cancel)" {class: hot}
  spa -> api: "POST /api/v1/admin/review-items/resolutions\n12 ids, ACCEPTED"
  api -> db: "per item: rule check (its run's conflicting fields,\nor a candidate's newest research: DONE, KEEP, no CONFLICT)"
  api -> db: "a researched candidate: its CONFIRMED changed values\ninto the candidate (EditCandidate, audit EDITED)"
  api -> db: "then its own transaction: decision, audit bulk:<batch>"
  api -> spa: "one outcome per item"
  spa -> owner: "\"11 done, 1 failed (already decided)\",\nthe failed item stays picked"
}
