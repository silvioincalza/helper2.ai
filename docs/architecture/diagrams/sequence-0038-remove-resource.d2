# Sequence: an admin removes a crypto list the AI check lists; a later Scout run finds the same address.
# Source of truth: frontend/src/admin/AiCheckPanel.tsx,
#   backend/apps/backoffice/src/main/java/ai/searchavo/admin/web/EnrichmentQueueController.java (removeResourceNotAboutAi),
#   backend/libs/core/src/main/java/ai/searchavo/catalog/usecase/RemoveResource.java,
#   backend/libs/core/src/main/java/ai/searchavo/catalog/internal/JdbcResourceRemoval.java,
#   backend/libs/core/src/main/java/ai/searchavo/catalog/internal/JdbcCatalogWriter.java (upsert), ResourceRemovalLock.java.
# Render: cd docs/architecture/diagrams && d2 fmt sequence-0038-remove-resource.d2 && d2 sequence-0038-remove-resource.d2 sequence-0038-remove-resource.svg

...@style

shape: sequence_diagram

person: "Admin" {class: person}
ui: "Back office\n(AiCheckPanel)" {class: app}
api: EnrichmentQueueController {class: app}
remove: RemoveResource {class: app}
db: "PostgreSQL\n(resource, candidate_decision,\nremoved_resource, admin_audit)" {class: data}
scout: "Scout\n(a later collector)" {class: ext}
store: "JdbcCatalogWriter\n(upsert)" {class: app}

person -> ui: "Remove, reason: A crypto list"
ui -> api: "POST /admin/ai-check/{id}/remove\n{reason}"
api -> remove: "remove(id, reason, admin)"
remove -> db: "SELECT canonical_url ... FOR UPDATE"
remove -> db: "lock removed_resource (alone);\ncandidate_decision REJECTED as a resource\nand as a course candidate;\nremoved_resource key"
remove -> db: "DELETE resource (cascades)"
remove -> db: "admin_audit REMOVE_RESOURCE\n(address, reason)"
api -> ui: "204; the row says Removed"
scout -> store: "upsert(result with the same address)"
store -> db: "lock removed_resource (shared);\nkey in removed_resource: dropped"
