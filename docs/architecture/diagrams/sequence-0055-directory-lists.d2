# Sequence: an administrator turns the reading of a directory host's lists on, discovery adds a list page, the awesome-list collector reads it, and the pages show it (ADR 0055).
# Source of truth: frontend/src/admin/DiscoveryHostsPanel.tsx,
#   backend/apps/backoffice/src/main/java/ai/helper2/admin/web/DiscoveryHostsController.java,
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/ManageDiscoveryHosts.kt (readLists), AddDiscoveredList.kt,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/DiscoveryCollector.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/WebPageLists.java, GitHubAwesomeCollector.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcDirectoryListIndex.java, JdbcResourceDetailReads.java,
#   frontend/src/features/resource/FoundInLists.tsx, frontend/src/admin/ReviewEvidence.tsx.
# Render: cd docs/architecture/diagrams && d2 fmt sequence-0055-directory-lists.d2 && d2 sequence-0055-directory-lists.d2 sequence-0055-directory-lists.svg

...@style

shape: sequence_diagram

admin: "Administrator\n(admin host)" {class: person}
spa: "Back office" {class: app}
api: "Admin API\n(scout use cases)" {class: app}
db: PostgreSQL {class: data}
discovery: "Discovery run\n(one category)" {class: app}
awesome: "Awesome-list\ncollector" {class: app}
reader: "Live web\npage reader" {class: ext}
sources: "Hub, arXiv, npm" {class: ext}
visitor: Visitor {class: person}
public: "Public API" {class: app}

on: Switch on {
  admin -> spa: "Read the lists of example-directory.com, reason" {class: hot}
  spa -> api: "POST /api/v1/admin/discovery-hosts/{host}/list-reading\n{read: true, reason}"
  api -> db: "UPDATE discovery_host SET reads_lists;\nINSERT admin_audit (READ_DIRECTORY_LISTS, ON)"
  api -> spa: "200 {host, kind, readsLists: true}"
}

find: Next discovery run {
  discovery -> db: "SELECT host, kind, reads_lists FROM discovery_host" {class: hot}
  discovery -> discovery: "classify: list page on the host = LIST_TO_READ"
  discovery -> api: "AddDiscoveredList.add(page, collector id)"
  api -> db: "INSERT list_seed (WEB_PAGE, origin DISCOVERY)\nwhen the rules and the cap of 100 allow"
  api -> discovery: "ADDED, or WAITS_FOR_REVIEW:\nthen an ARTICLE candidate"
}

read: Next pass of the awesome-list collector {
  awesome -> db: "SELECT list_seed, list_seed_last_read, discovery_host" {class: hot}
  awesome -> reader: "read the page (1 credit): due, host on,\nunder 10 discovered reads today"
  reader -> awesome: "Markdown"
  awesome -> db: "UPSERT list_seed_last_read"
  awesome -> sources: "model, paper, package by id"
  sources -> awesome: "facts, or not found"
  awesome -> db: "resources and candidates; directory_list_entry\n(no resource for the list page)"
}

show: The pages {
  visitor -> public: "GET /api/v1/resources/{id}" {class: hot}
  public -> db: "curated lists by name; count in directory_list_entry"
  public -> visitor: "foundIn {lists, more, directoryLists: 3}"
  admin -> spa: "opens a review item of the resource"
  spa -> api: "GET /api/v1/admin/review-items/{id}/evidence"
  api -> db: "directory lists that name the resource"
  api -> spa: "directoryLists [{title, page, headingPath}]"
}
