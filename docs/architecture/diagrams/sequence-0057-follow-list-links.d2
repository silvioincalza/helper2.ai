# Sequence: a pass of the awesome-list collector follows a link of a directory list through the directory's page of the item and a redirect to the item's own site, checks the page and hands the address to the rule of its kind (ADR 0057).
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/WebPageLists.java (read, followed), ListLinkFollower.java, ItemPageCheck.java, DirectoryRatingReader.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/pagestatus/LivePageStatusReader.java, PinnedTransport.java, RobotsRules.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/classifier/SpringAiItemPageJudge.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/JdbcListSeedStore.java (followed).
# Render: cd docs/architecture/diagrams && d2 fmt sequence-0057-follow-list-links.d2 && d2 sequence-0057-follow-list-links.d2 sequence-0057-follow-list-links.svg

...@style

shape: sequence_diagram

awesome: "Awesome-list\ncollector" {class: app}
db: PostgreSQL {class: data}
redis: "Redis\n(caps of the day)" {class: data}
reader: "Live web\npage reader" {class: ext}
status: "Status request\nof our own" {class: app}
site: "Site a link\nleads to" {class: ext}
llm: "Fast model" {class: ai}

follow: A link to the directory's page of the item {
  awesome -> db: "SELECT list_seed_last_read:\nthe list and what following gave" {class: hot}
  awesome -> awesome: "entry with no link to its item;\nlink not followed since the last read;\nhost check"
  awesome -> redis: "steps of the day under 100?\ncount the step"
  awesome -> reader: "step 1: read the directory's page\nof the item (1 credit)" {class: hot}
  reader -> awesome: "Markdown"
  awesome -> awesome: "the link whose address carries the name,\nelse the \"Visit website\" link; host check"
}

redirect: The link redirects {
  awesome -> status: "step 2: status of the address" {class: hot}
  status -> status: "host check, host not one never read"
  status -> redis: "requests of the day under 200,\nof the host under 30? count the try"
  status -> site: "GET /robots.txt (once a day per host),\nto the checked addresses only"
  site -> status: "rules for the path"
  status -> site: "HEAD the address: no cookie,\nno credential, no redirect followed" {class: hot}
  site -> status: "302, Location"
  status -> awesome: "Answered(302, Location)"
  awesome -> awesome: "host check of the Location;\nnot a directory host"
}

check: Is the page the item's? {
  awesome -> awesome: "name of the entry a whole part\nof the address? yes: decided by code"
  awesome -> reader: "else step 3: read the page reached (1 credit)"
  reader -> awesome: "Markdown"
  awesome -> awesome: "name in the first heading?\nyes: decided by code"
  awesome -> llm: "else: fixed instruction, the name,\n2,000 characters of the cleaned page" {class: ai-call}
  llm -> awesome: "\"yes\" or \"no\"; anything else is no answer" {class: ai-call}
}

keep: What following gave {
  awesome -> db: "UPDATE list_seed_last_read SET followed:\nlink, address found or nothing, steps, code or model" {class: hot}
  awesome -> awesome: "the address joins the links of the entry:\nthe rule of its kind decides"
  awesome -> awesome: "the rating of the entry is taken from the\npage of the item read in step 1, not read again"
}
