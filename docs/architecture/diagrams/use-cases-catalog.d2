# Use cases of the Catalog module: its actors and the use cases each one starts or serves.
# D2 twin of docs/use_cases/catalog/use_cases.puml: that file is the source of truth (AI Unified Process). Change it first,
# then this file, in the same pull request. Same actors, use cases, entities and relations: nothing added.
# Render: cd docs/architecture/diagrams && d2 fmt use-cases-catalog.d2 && d2 use-cases-catalog.d2 use-cases-catalog.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

visitor: "Visitor" {class: person}
admin: "Administrator" {class: person}

module: "Catalog" {
  class: group
  UC007: "UC-007\nView Resource Details" {
    class: app
    shape: oval
  }
  UC008: "UC-008\nFollow New Resources and Events" {
    class: app
    shape: oval
  }
  UC009: "UC-009\nReport Wrong Information" {
    class: app
    shape: oval
  }
  UC010: "UC-010\nManage Known Targets" {
    class: app
    shape: oval
  }
}

visitor -> module.UC007
visitor -> module.UC008
visitor -> module.UC009
admin -> module.UC010
