# Use cases of the Discovery module: its actors and the use cases each one starts or serves.
# D2 twin of docs/use_cases/discovery/use_cases.puml: that file is the source of truth (AI Unified Process). Change it first,
# then this file, in the same pull request. Same actors, use cases, entities and relations: nothing added.
# Render: cd docs/architecture/diagrams && d2 fmt use-cases-discovery.d2 && d2 use-cases-discovery.d2 use-cases-discovery.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

admin: "Administrator" {class: person}
scheduler: "Scheduler" {class: ext}
source_provider: "Source Provider" {class: ext}
scout: "Scout" {class: ext}

module: "Discovery" {
  class: group
  UC018: "UC-018\nCollect New Resources" {
    class: app
    shape: oval
  }
  UC019: "UC-019\nManage Discovery Hosts" {
    class: app
    shape: oval
  }
  UC020: "UC-020\nManage List Seeds" {
    class: app
    shape: oval
  }
  UC030: "UC-030\nRead Lists" {
    class: app
    shape: oval
  }
}

scheduler -> module.UC018
admin -> module.UC018
admin -> module.UC019
admin -> module.UC020
scout -> module.UC030
module.UC018 -> source_provider
module.UC030 -> source_provider
