# Use cases of the Review module: its actors and the use cases each one starts or serves.
# D2 twin of docs/use_cases/review/use_cases.puml: that file is the source of truth (AI Unified Process). Change it first,
# then this file, in the same pull request. Same actors, use cases, entities and relations: nothing added.
# Render: cd docs/architecture/diagrams && d2 fmt use-cases-review.d2 && d2 use-cases-review.d2 use-cases-review.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

admin: "Administrator" {class: person}
scheduler: "Scheduler" {class: ext}
llm: "Language Model" {class: ai}
source_provider: "Source Provider" {class: ext}

module: "Review" {
  class: group
  UC024: "UC-024\nReview Candidates" {
    class: app
    shape: oval
  }
  UC025: "UC-025\nDecide Relationship Targets by Name" {
    class: app
    shape: oval
  }
  UC026: "UC-026\nCurate Resource Fields" {
    class: app
    shape: oval
  }
  UC027: "UC-027\nResearch Review Items" {
    class: app
    shape: oval
  }
}

admin -> module.UC024
admin -> module.UC025
admin -> module.UC026
admin -> module.UC027
scheduler -> module.UC027
module.UC027 -> llm
module.UC027 -> source_provider
