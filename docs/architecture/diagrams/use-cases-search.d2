# Use cases of the Search module: its actors and the use cases each one starts or serves.
# D2 twin of docs/use_cases/search/use_cases.puml: that file is the source of truth (AI Unified Process). Change it first,
# then this file, in the same pull request. Same actors, use cases, entities and relations: nothing added.
# Render: cd docs/architecture/diagrams && d2 fmt use-cases-search.d2 && d2 use-cases-search.d2 use-cases-search.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

visitor: "Visitor" {class: person}
admin: "Administrator" {class: person}
scheduler: "Scheduler" {class: ext}
llm: "Language Model" {class: ai}
embedder: "Embedding Service" {class: ai}
source_provider: "Source Provider" {class: ext}

module: "Search" {
  class: group
  UC001: "UC-001\nSearch the AI Ecosystem" {
    class: app
    shape: oval
  }
  UC002: "UC-002\nCheck Source Coverage" {
    class: app
    shape: oval
  }
  UC003: "UC-003\nManage Home Examples" {
    class: app
    shape: oval
  }
  UC004: "UC-004\nManage Shadow Libraries" {
    class: app
    shape: oval
  }
}

visitor -> module.UC001
visitor -> module.UC002
admin -> module.UC003
scheduler -> module.UC003
admin -> module.UC004
module.UC001 -> source_provider
module.UC001 -> embedder
module.UC001 -> llm
module.UC003 -> llm
module.UC003 -> source_provider
