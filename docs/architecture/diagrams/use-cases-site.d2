# Use cases of the Site module: its actors and the use cases each one starts or serves.
# D2 twin of docs/use_cases/site/use_cases.puml: that file is the source of truth (AI Unified Process). Change it first,
# then this file, in the same pull request. Same actors, use cases, entities and relations: nothing added.
# Render: cd docs/architecture/diagrams && d2 fmt use-cases-site.d2 && d2 use-cases-site.d2 use-cases-site.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

visitor: "Visitor" {class: person}
scheduler: "Scheduler" {class: ext}
search_engine: "Search Engine" {class: ext}
payment: "Payment Provider" {class: ext}

module: "Site" {
  class: group
  UC014: "UC-014\nBrowse Hub Pages" {
    class: app
    shape: oval
  }
  UC015: "UC-015\nRead Mission, Privacy and Terms" {
    class: app
    shape: oval
  }
  UC016: "UC-016\nSupport helper2.ai" {
    class: app
    shape: oval
  }
  UC017: "UC-017\nNotify Search Engines of Changed Pages" {
    class: app
    shape: oval
  }
}

visitor -> module.UC014
search_engine -> module.UC014
visitor -> module.UC015
visitor -> module.UC016
module.UC016 -> payment
scheduler -> module.UC017
module.UC017 -> search_engine
