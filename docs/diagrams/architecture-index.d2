# Architecture, view 4 of 6: how the index grows. Scout runs collectors, enriches with evidence, and the catalog stores and embeds.
# Source of truth: backend/src/main/java/ai/helper2/admin/web/AdminController.java (back office),
#   backend/src/main/kotlin/ai/helper2/scout/Ports.kt, scout/Scout.kt, scout/Enrichment.kt,
#   scout/GapRound.kt (gap round ports, ADR 0043),
#   backend/src/main/java/ai/helper2/sources/config/SourcesConfiguration.java (collectors, ReadmeEvidence),
#   backend/src/main/java/ai/helper2/catalog/internal/CatalogConfiguration.java (index, embedder),
#   backend/src/main/java/ai/helper2/catalog/enrichment/ (EnrichmentCandidates, EnrichmentResults: the Scout's way in),
#   backend/src/main/java/ai/helper2/catalog/EnrichmentFacts.java, catalog/usecase/GetResourceDetail.java (the detail page's way out),
#   backend/src/main/java/ai/helper2/scout/internal/CatalogEnrichmentStore.java,
#   scout/usecase/IndexAcceptedCandidate.kt, scout/internal/ResourceCandidateJson.java, admin/usecase/ResolveReview.java.
# Render: cd docs/diagrams && d2 fmt architecture-index.d2 && d2 architecture-index.d2 architecture-index.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

admin: "Admin" {class: person}

scout: "scout (Kotlin domain)" {
  class: group
  core: "RunScout · EnrichResource\nEvidenceValidator\nGapTargets · ReadmeText (gap round)" {class: app}
  accept: "IndexAcceptedCandidate\n(accept a resource candidate,\nADR 0051)" {class: app}
  p_candidates: "CandidateReview\nCandidateDetails · CatalogLookup" {class: port}
  json: "ReviewQueueCandidateReview\nResourceCandidateJson" {class: app}
  core -> p_candidates: "candidates to review"
  accept -> p_candidates
  accept -> p_index
  json -> p_candidates: implements {class: config}
  p_collector: Collector {class: port}
  p_extra: "ExtraEvidence\nGapBudget" {class: port}
  p_index: CatalogIndex {class: port}
  p_enrich: EnrichmentModel {class: port}
  p_stores: "ScoutStore\nEnrichmentStore\nEnrichmentBacklog" {class: port}
  model: "SpringAiEnrichmentModel" {class: app}
  jdbc: "JdbcScoutStore\nCatalogEnrichmentStore" {class: app}
  core -> p_collector
  core -> p_extra: "gap round (ADR 0043)"
  core -> p_index
  core -> p_enrich: {class: ai-call}
  core -> p_stores
  model -> p_enrich: implements {class: config}
  jdbc -> p_stores: implements {class: config}
}

sources: "sources (collectors, gap evidence)" {
  class: group
  collectors: "McpRegistryCollector · TavilyCollector\nTavilyDiscoveryCollector × 34 categories\n(DiscoveryCollectorRegistrar) · LinkedInCollector\nCourseCollector · HuggingFaceTrendingCollector\nHuggingFaceProviderOrgsCollector\nGitHubAwesomeCollector · AiDeadlinesCollector" {class: app}
  classifier: "SpringAiRepoClassifier\n(or Heuristic)" {class: app}
  evidence: "ReadmeEvidence\n(README, model card)" {class: app}
  collectors -> classifier: "awesome-list entries" {class: ai-call}
}

catalog: "catalog (Java)" {
  class: group
  catalog: "IndexResources · ReviewQueue" {class: app}
  p_enrichment: "catalog::enrichment\nEnrichmentCandidates\nEnrichmentResults" {class: port}
  enrichment: "JdbcEnrichmentCandidates\nJdbcEnrichmentResults" {class: app}
  store: ResourceStore {class: app}
  enrichment -> p_enrichment: implements {class: config}
  detail: GetResourceDetail {class: app}
  p_facts: "EnrichmentFacts\n(detail page)" {class: port}
  detail -> p_facts
  detail -> store
  enrichment -> p_facts: implements {class: config}
  embed: "EmbeddingIndexer\nNvidiaEmbedder" {class: app}
  catalog -> store
  embed -> store: "pending texts, vectors"
}

pg: "PostgreSQL\nresources, facts with evidence,\nreview items, embeddings" {shape: cylinder; class: data}
nebius: "Nebius Token Factory\nNemotron 3 Super" {class: ai}
nvapi: "NVIDIA API catalog\nnemotron-3.5-embed-1b" {class: ai}
hosts: "registry.modelcontextprotocol.io\nhuggingface.co · api.github.com\nraw.githubusercontent.com · api.tavily.com" {class: ext}

backoffice: "admin module\nAdminController · ResolveReview\nPOST /admin/scout-runs\nPUT /admin/review-items/{id}/resolution\nGET /admin/enrichment-queue" {class: app}
admin -> backoffice: "trigger run, review"
backoffice -> scout.core
backoffice -> scout.jdbc: "enrichment queue (read)"
backoffice -> scout.accept: "accept a resource candidate"
scout.json -> catalog.catalog: "RESOURCE_CANDIDATE items"
sources.collectors -> scout.p_collector: implements {class: config}
sources.evidence -> scout.p_extra: implements {class: config}
catalog.catalog -> scout.p_index: implements {class: config}
sources.collectors -> hosts: HTTPS
sources.evidence -> hosts: "HTTPS: gap round\nREADMEs, model cards"
sources.classifier -> nebius: "classify repos" {class: ai-call}
scout.model -> nebius: "enrich" {class: ai-call}
scout.jdbc -> catalog.p_enrichment: "backlog, source text,\nrecord runs"
scout.jdbc -> pg: "JDBC: scout_run, cursors,\nsource.last_outcome"
catalog.store -> pg: JDBC
catalog.enrichment -> pg: JDBC
catalog.embed -> nvapi: "/embeddings" {class: ai-call}
