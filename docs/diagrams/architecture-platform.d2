# Architecture, view 6 of 6: the edge and the shared services. Identity, the request edge (rate limits, errors, SPA),
# and the platform services every module uses: llm, http, resilience, quota, shared cache and cluster locks.
# With the Redis keys and Postgres tables each one owns, and GitHub OAuth for the back office.
# Source of truth: backend/libs/platform/src/main/java/ai/helper2/platform/package-info.java (open module),
#   platform/RateLimitInterceptor.java, RedisRateLimiter.java (h2:v1:rate:*), ApiExceptionHandler.java,
#   ClusterLockConfiguration.java (shedlock), backend/apps/public/src/main/java/ai/helper2/pages/web/PageRoutes.java,
#   platform/llm/* (RedisCallCounter: h2:v1:budget:*), platform/http/ObservedHttp.java,
#   platform/resilience/* (RedisOutboundThrottle: h2:v1:outbound:*), platform/quota/* (QuotaKeys: h2:v1:quota:*),
#   platform/cache/* (JdbcSharedCache, SharedCacheRetention: ai_cache),
#   platform/settings/* (RuntimeSettings, JdbcRuntimeSettingStore: runtime_setting; ADR 0060),
#   backend/apps/public/src/main/java/ai/helper2/identity/config/PublicSecurityConfiguration.java, ContentSecurityPolicy.java,
#   CspHeaderWriter.java, backend/apps/backoffice/src/main/java/ai/helper2/identity/config/BackOfficeSecurityConfiguration.java,
#   BackOfficeEdge.java, backend/libs/identity/src/main/java/ai/helper2/identity/config/WebSecurity.java, SameOriginWrites.java,
#   SessionConfiguration.java, platform/CspNonce.java (ADR 0059),
#   identity/web/MeController.java, AuditController.java, identity/internal/*, identity/usecase/*,
#   identity/Users.java, Bookmarks.java, AuditLog.java, RetentionPeriods.java (ports), identity/config/IdentityUseCaseConfiguration.java,
#   backend/apps/{public,backoffice}/src/main/resources/application.yaml (spring.session.data.redis.namespace, oauth-github profile).
# Render: cd docs/diagrams && d2 fmt architecture-platform.d2 && d2 architecture-platform.d2 architecture-platform.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

browser: "Browser\nReact SPA" {class: person}
admin: "Admin\n(VPN, admin host)" {class: person}

edge: "Request edge (platform)" {
  class: group
  spa: "PageRoutes (public app):\nclient routes → the shell\n(the web image serves the files);\nAdminWebApp (back office): /admin/**" {class: app}
  rate: "RateLimitInterceptor\nRedisRateLimiter\n(in memory while Redis is down)" {class: app}
  errors: "ApiExceptionHandler\nproblem+json" {class: app}
}

identity: "identity (Java)" {
  class: group
  sec: "PublicSecurityConfiguration (never ADMIN)\nBackOfficeSecurityConfiguration (ADMIN allow-list)\nWebSecurity · SameOriginWrites: CSRF, Origin\n(identity.config, ADR 0069)" {class: app}
  csp: "CspHeaderWriter · ContentSecurityPolicy\npublic app: strict CSP; with AdSense on:\nnonce CSP (CspNonce per request);\nBackOfficeEdge: fixed strict CSP, headers, routes" {class: app}
  sec -> csp
  session: "SessionConfiguration\nfail-soft session store\n(identity.config)" {class: app}
  me: "MeController · AuditController\n(identity.web)" {class: app}
  usecase: "AddBookmark · ListBookmarks\nMergeLocalBookmarks · RemoveBookmark\nDeleteMyAccount · ListAuditEntries\nPurgeExpiredData\n(plain classes, wired in identity.config)" {class: app}
  ports: "Users · Bookmarks · AuditLog\nRetentionPeriods" {class: port}
  store: "JdbcUsers · JdbcBookmarks\nJdbcAuditLog\n(identity.internal)" {class: app}
  me -> usecase
  usecase -> ports
  store -> ports: implements {class: config}
}

modules: "search · guide · scout · catalog\nsources · setup" {class: app}

platform: "platform (open module)" {
  class: group
  llm: "llm: LlmSettings · NvidiaOnly\nDailyBudget · BudgetLedger · RedisCallCounter\nModelCallMetrics · LlmPolicies" {class: app}
  http: "http: ObservedHttp\n(pooled, observed RestClient;\nUser-Agent with build version)" {class: app}
  resilience: "resilience: Resilience\n(named policies on Resilience4j:\nredis, llm-chat, llm-embed,\nllm-embed-index, guide, …)\nOutboundThrottle" {class: app}
  quota: "quota: QuotaCounter (Redis Lua)\nQuotaKeys (HMAC)" {class: app}
  cache: "cache: SharedCaches\nJdbcSharedCache\nSharedCacheRetention (daily purge)" {class: app}
  locks: "ClusterLock · ClusterLocks\n(ShedLock, database time)" {class: app}
  settings: "settings: SettingsGroup · Setting\nRuntimeSetting (allow-list)\nRuntimeSettings (snapshot, 20 s refresh)" {class: app}
}

shared: "shared (open, Kotlin)\nCanonicalUrl · ResourceId · DateFact\nLanguageDetector · Vocabulary" {class: app}
api: "api (open)\ngenerated per app: public.yaml or\nadmin.yaml, + common.yaml" {class: app}

redis: "Redis 8 (disposable)\nh2:v1:rate:* · h2:v1:budget:*\nh2:v1:outbound:* · h2:v1:quota:*\nhelper2:session:* · helper2:backoffice:session:*" {shape: cylinder; class: data}
pg: "PostgreSQL 18\napp_user · bookmark · admin_audit\nai_cache · shedlock · runtime_setting" {shape: cylinder; class: data}
oauth: "github.com OAuth\n(profile oauth-github; off on\nstaging and prod)" {class: ext}

browser -> edge.spa: "pages, assets"
browser -> edge.rate: "/api/v1/*" {class: hot}
edge.rate -> modules: {class: hot}
browser -> identity.me: "/me, bookmarks, monetisation"
google: "In the browser only (ADR 0059):\nGoogle consent tool · AdSense\n(resource pages) · Google Analytics" {class: ext}
browser -> google: "TCF answer, one ad,\npage path" {class: config}
admin -> identity.sec: "/admin"
identity.sec -> oauth: "sign-in" {class: config}
identity.sec -> identity.session
modules -> edge.errors: "exceptions"
modules -> platform.llm: "model calls" {class: ai-call}
modules -> platform.http: "HTTP client" {class: config}
modules -> platform.quota: "daily web searches"
modules -> platform.cache: "model answers"
modules -> platform.locks: "Scout, embedding indexer"
modules -> shared
modules -> api: "controller interfaces, DTOs"
identity.usecase -> platform.quota: "delete counters\nwith the account"

edge.rate -> redis: "h2:v1:rate:*"
identity.session -> redis: "helper2:session:* · helper2:backoffice:session:*"
platform.llm -> redis: "h2:v1:budget:*"
platform.resilience -> redis: "h2:v1:outbound:*"
platform.quota -> redis: "h2:v1:quota:*"
identity.store -> pg: "app_user, bookmark,\nadmin_audit"
platform.cache -> pg: "ai_cache"
platform.locks -> pg: "shedlock"
platform.settings -> pg: "runtime_setting"
modules -> platform.settings: "spending limits\n(supplier per limit)"
