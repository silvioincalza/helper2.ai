# Architecture, C4 level 1: system context. helper2 as one box, the people who use it and the systems it talks to.
# What is inside the box is in architecture-containers.d2 (level 2) and architecture-context.d2 (level 3).
# Source of truth: api/public.yaml, api/admin.yaml (what people ask), deploy/helm/helper2/values.yaml (hosts, egress),
#   backend/libs/platform/src/main/resources/helper2-shared.yaml (base URLs of the models and the sources),
#   frontend/src/features/monetisation, frontend/src/lib/consent.ts, googleConsent.ts, analytics.ts (the browser's third parties),
#   .github/workflows/cd.yml, deploy.yml (delivery).
# Render: cd docs/diagrams && d2 fmt architecture-system-context.d2 && d2 architecture-system-context.d2 architecture-system-context.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

people: PEOPLE {
  class: group
  visitor: "Visitor\nsearches, asks the guide,\nsaves results (GitHub sign-in)" {class: person}
  crawler: "Crawler,\nlink preview" {class: person}
  admin: "Admin\nreviews the index\n(VPN, GitHub sign-in)" {class: person}
}

helper2: "helper2.ai\nmetasearch for the AI ecosystem:\none box, federated search,\nan AI guide that answers only\nfrom retrieved results;\nits own embedding model (ADR 0054)" {
  class: app
  style.bold: true
}

models: "NVIDIA MODELS, HOSTED" {
  class: group
  nebius: "Nebius Token Factory\nNemotron: guide, enrichment,\ntranslation, review research" {class: ai}
}

sources: "Public sources\nGitHub · Hugging Face · npm · arXiv\nMCP Registry · Tavily · deps.dev\nHacker News · news feeds" {class: ext}
oauth: "github.com OAuth\nsign-in" {class: ext}
thirdparty: "In the browser only\nGoogle consent tool · AdSense\nGoogle Analytics\nGitHub Sponsors · Stripe" {class: ext}

operations: "DELIVERY AND OPERATIONS" {
  class: group
  github: "GitHub Actions\nbuild, sign, deploy" {class: ext}
  cloudflare: "Cloudflare\nDNS, TLS, tunnel;\nR2: the off-site backup" {class: ext}
  monitoring: "Prometheus · Tempo · Grafana\nmetrics, traces, alerts" {class: app}
}

people.visitor -> helper2: "search, guide (SSE),\nresource pages, saved" {class: hot}
people.crawler -> helper2: "pages, sitemap.xml,\nrobots.txt"
people.admin -> helper2: "review, Scout runs,\nsettings"
people.visitor -> thirdparty: "consent, ads,\nanalytics, gifts"

helper2 -> models.nebius: "model calls" {class: ai-call}
helper2 -> sources: "HTTPS: live search,\nScout, setup guides"
helper2 -> oauth: "sign-in" {class: config}

operations.github -> helper2: "signed images,\nhelm upgrade" {class: config}
operations.cloudflare -> helper2: "public hosts" {class: config}
helper2 -> operations.monitoring: "metrics, traces" {class: config}
helper2 -> operations.cloudflare: "encrypted dump" {class: config}
