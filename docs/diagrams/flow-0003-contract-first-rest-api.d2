# Flowchart: a change to the contract, from api/public.yaml, admin.yaml or common.yaml to a green build: the generated server interfaces and
# DTOs, the generated TypeScript types, and the response checks in the API integration tests.
# Source of truth: api/*.yaml, backend/build-logic/src/main/kotlin/helper2.spring-app.gradle.kts (bundleContract, openApiGenerate, compileJava/compileKotlin dependsOn,
#   Test systemProperty openapi.spec), backend/build-logic/src/main/kotlin/ai/helper2/buildlogic/SpringContract.kt,
#   BundleContract.kt (bundle, generation), backend/libs/core/build.gradle.kts, frontend/package.json (gen:api, prebuild, pretypecheck, prelint, pretest),
#   backend/apps/public/src/test/java/ai/helper2/api/ContractValidator.java, GuideApiIT.java,
#   backend/apps/public/src/main/java/ai/helper2/guide/web/GuideStreamController.java.
# Render: cd docs/diagrams && d2 fmt flow-0003-contract-first-rest-api.d2 && d2 flow-0003-contract-first-rest-api.d2 flow-0003-contract-first-rest-api.svg

...@style

direction: down

change: "Edit api/public.yaml, admin.yaml\nor common.yaml\n(OpenAPI 3.1.0, servers /api/v1)" {class: person}

backend: Backend (Gradle) {
  class: group
  direction: down
  shared: "libs/core: openApiGenerate\non common.yaml alone, once" {class: app}
  stypes: "ai.helper2.api.common (SearchApi …)\nai.helper2.api.common.model (*Dto)" {class: data}
  bundle: "bundleContract (each app): one file,\none meaning per name?" {class: decision}
  e_bundle: "Build stops:\nsame name, two meanings" {class: fail}
  files: "contract.yaml: the whole contract (tests)\ngeneration.yaml: without the\npaths of common.yaml" {class: data}
  gen: "openApiGenerate on generation.yaml\n(spring, interfaceOnly, useSpringBoot4,\nuseJackson3, useTags); every schema\nof common.yaml mapped to its\nlibrary class, nested ones included" {class: app}
  types: "The app's own types: ai.helper2.api.generated,\nai.helper2.api.generated.model (*Dto)" {class: data}
  compile: "compileJava / compileKotlin:\ncontrollers implement the interfaces?" {class: decision}
  e_compile: "Compile error\n(same pull request)" {class: fail}
  shared -> stypes
  bundle -> e_bundle: no
  bundle -> files: yes
  files -> gen -> types -> compile
  stypes -> compile: "a dependency\nof both apps"
  compile -> e_compile: no
}

frontend: Frontend (npm) {
  class: group
  direction: down
  pre: "prebuild, pretypecheck,\nprelint, pretest" {class: app}
  ts: "gen:api: openapi-typescript --enum-values\n→ src/api/schema.ts, admin-schema.ts\n(types + enum values, not committed)" {class: data}
  tsc: "tsc --noEmit:\nclient.ts and pages fit the types?" {class: decision}
  e_tsc: "Type error" {class: fail}
  pre -> ts -> tsc
  tsc -> e_tsc: no
}

tests: API integration tests (*ApiIT) {
  class: group
  direction: down
  call: "Real request to the running app" {class: app}
  sse: "POST /guide/stream?\n(hand-written Flux<ServerSentEvent>,\nevent names from GuideStreamEventDto)" {class: decision}
  body: "ContractValidator.assertMatches:\nbody vs components/schemas\n(JSON Schema 2020-12)" {class: app}
  events: "GuideApiIT: each event's\ndata vs its schema" {class: app}
  valid: "Valid?" {class: decision}
  e_valid: "Test fails:\nschema violations listed" {class: fail}
  call -> sse
  sse -> events: yes
  sse -> body: no
  body -> valid
  events -> valid
  valid -> e_valid: no
}

green: "Build green: both sides\nmatch the one contract" {class: end}

change -> backend.bundle: {class: hot}
change -> backend.shared: "common.yaml"
change -> frontend.pre: {class: hot}
backend.compile -> tests.call: yes {class: hot}
frontend.tsc -> green: yes
tests.valid -> green: yes {class: hot}
