# Flowchart: a change to the contract, from api/openapi.yaml to a green build: the generated server interfaces and
# DTOs, the generated TypeScript types, and the response checks in the API integration tests.
# Source of truth: api/openapi.yaml, backend/build.gradle.kts (openApiGenerate, compileJava/compileKotlin dependsOn,
#   Test systemProperty openapi.spec), frontend/package.json (gen:api, prebuild, pretypecheck, prelint, pretest),
#   backend/src/test/java/ai/helper2/api/ContractValidator.java, GuideApiIT.java,
#   backend/src/main/java/ai/helper2/guide/web/GuideStreamController.java.
# Render: cd docs/diagrams && d2 fmt flow-0003-contract-first-rest-api.d2 && d2 flow-0003-contract-first-rest-api.d2 flow-0003-contract-first-rest-api.svg

...@style

direction: down

change: "Edit api/openapi.yaml\n(OpenAPI 3.1.0, servers /api/v1)" {class: person}

backend: Backend (Gradle) {
  class: group
  direction: down
  gen: "openApiGenerate (spring, interfaceOnly,\nuseSpringBoot4, useJackson3, useTags)\n→ build/generated/openapi" {class: app}
  types: "Interfaces ai.helper2.api.generated (SearchApi …)\nDTOs ai.helper2.api.generated.model (*Dto)" {class: data}
  compile: "compileJava / compileKotlin:\ncontrollers implement the interfaces?" {class: decision}
  e_compile: "Compile error\n(same pull request)" {class: fail}
  gen -> types -> compile
  compile -> e_compile: no
}

frontend: Frontend (npm) {
  class: group
  direction: down
  pre: "prebuild, pretypecheck,\nprelint, pretest" {class: app}
  ts: "gen:api: openapi-typescript --enum-values\n→ src/api/schema.ts\n(types + enum values, not committed)" {class: data}
  tsc: "tsc --noEmit:\nclient.ts and pages fit the types?" {class: decision}
  e_tsc: "Type error" {class: fail}
  pre -> ts -> tsc
  tsc -> e_tsc: no
}

tests: API integration tests (*ApiIT) {
  class: group
  direction: down
  call: "Real request to the running app" {class: app}
  sse: "POST /guide/stream?\n(hand-written SseEmitter,\nevent names from GuideStreamEventDto)" {class: decision}
  body: "ContractValidator.assertMatches:\nbody vs components/schemas\n(JSON Schema 2020-12)" {class: app}
  events: "GuideApiIT: each event's\ndata vs its schema" {class: app}
  valid: "Valid?" {class: decision}
  e_valid: "Test fails:\nschema violations listed" {class: fail}
  call -> sse
  sse -> events: yes
  sse -> body: no
  body -> valid
  events -> valid
  valid -> e_valid: no
}

green: "Build green: both sides\nmatch the one contract" {class: end}

change -> backend.gen: {class: hot}
change -> frontend.pre: {class: hot}
backend.compile -> tests.call: yes {class: hot}
frontend.tsc -> green: yes
tests.valid -> green: yes {class: hot}
