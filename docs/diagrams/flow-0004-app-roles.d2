# Flowchart: who migrates, how an app waits for the schema, and what each app may reach in Postgres and Redis (ADR 0004).
# Source of truth: backend/libs/schema (MigrateStep, AppLogins, SchemaCheck, V1__schema.sql: its last section, the app roles),
#   backend/apps/public/src/main/java/ai/helper2/PublicApplication.java, backend/libs/identity (SessionConfiguration),
#   deploy/helm/helper2/templates/ (migrate.yaml, app.yaml, backoffice.yaml, redis.yaml),
#   deploy/helm/helper2/files/redis-users.acl, deploy/k8s/Makefile (env-secret, deploy), deploy/k8s/check-app-env.sh.
# Render: cd docs/diagrams && d2 fmt flow-0004-app-roles.d2 && d2 flow-0004-app-roles.d2 flow-0004-app-roles.svg

...@style

direction: down

start: "A process starts\nfrom the public or\nback office image" {class: end}

mode: "First argument\n`migrate`?" {class: decision}

step: Migrate step (Job, owner) {
  class: group
  direction: down
  flyway: "Flyway migrate\nas the owner (V1, last:\nroles NOLOGIN, row grants)" {class: app}
  pw: "Both role passwords\nset?" {class: decision}
  logins: "AppLogins: LOGIN +\nSCRAM password per role,\nstatement_timeout per role\n(h2_public 5 s, h2_backoffice 60 s)" {class: app}
  done: "exit 0" {class: end}
  failed: "exit 1: the Job fails,\nhelm rolls back" {class: fail}
  flyway -> pw
  pw -> logins: yes
  pw -> failed: no
  logins -> done
}

app: App startup (its own role) {
  class: group
  direction: down
  dev: "H2_SCHEMA_MIGRATE?\n(dev profile, compose)" {class: decision}
  migrate: "migrate itself\n(as the owner, local only)" {class: app}
  validate: "validate the schema" {class: app}
  result: "Result?" {class: decision}
  wait: "wait 5 s\n(up to H2_SCHEMA_WAIT, 4 min)" {class: app}
  over: "Wait over?" {class: decision}
  serve: "start: rows only,\nits own Redis user" {class: end}
  stop: "fail startup:\nchanged migration,\nor no Job ran" {class: fail}
  dev -> migrate: "true"
  dev -> validate: "false (a deployment)"
  migrate -> serve
  validate -> result
  result -> serve: valid {class: hot}
  result -> wait: "migrations missing,\nor login refused"
  result -> stop: "anything else"
  wait -> over
  over -> validate: no
  over -> stop: yes
}

reach: What each app reaches {
  class: group
  direction: right
  pg: "Postgres: grants per table (V1):\npublic app writes the rows a visit,\nsign-in or report needs; back office\nall rows. No DDL, TRUNCATE, temp tables;\nhistory read only" {class: data}
  redis: "Redis: shared counters and caches,\nits own cache and sessions (JSON),\nthe exact commands of\nredis-users.acl" {class: data}
}

start -> mode
mode -> step.flyway: yes
mode -> app.dev: no
app.serve -> reach.pg
app.serve -> reach.redis
