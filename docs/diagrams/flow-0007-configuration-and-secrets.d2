# Flowchart: how a secret travels from OpenBao to the app's environment, and how the app reads it.
# OpenBao helper2/kv ci/<env> (field app_env) -> CI deploy job -> <env>/app.env -> check -> kubectl ->
# Secret helper2-app-env -> pod env -> application.yaml -> typed record -> bean. Helm gets only hashes for
# the restart annotations.
# Source of truth: deploy/k8s/Makefile (credentials, env-secret, deploy), deploy/k8s/check-app-env.sh,
#   .github/workflows/deploy.yml, .github/actions/bao-login/action.yml,
#   deploy/helm/helper2/templates/_helpers.tpl (helper2.envSecret, helper2.redisPasswordFrom),
#   templates/app.yaml, templates/redis.yaml, backend/src/main/resources/application.yaml,
#   backend/src/main/java/ai/helper2/<module>/config/*Properties.java,
#   backend/src/test/java/ai/helper2/architecture/ConfigurationAccessTest.java.
# Render: cd docs/diagrams && d2 fmt flow-0007-configuration-and-secrets.d2 && d2 flow-0007-configuration-and-secrets.d2 flow-0007-configuration-and-secrets.svg

...@style

direction: down

owner: Owner workstation {
  class: group
  login: "bao login -method=oidc\nrole=helper2-operator" {class: person}
  put: "make ENV=<env> credentials:\nbao kv put -mount=helper2/kv ci/<env>\nkubeconfig=@... app_env=@<env>/app.env" {class: app}
  login -> put
}

bao: "OpenBao\nhelper2/kv ci/<env>\nfields: app_env, kubeconfig" {
  shape: cylinder
  class: data
}

job: CI deploy job (self-hosted runner) {
  class: group
  direction: down
  oidc: "bao-login: GitHub OIDC token\n→ auth/helper2/jwt/login\nrole deploy-<env>" {class: app}
  allowed: "Role bound to\nthis repo + environment?" {class: decision}
  denied: "Login refused:\nno secrets" {class: fail}
  get: "bao kv get -field=app_env ci/<env>\n> <env>/app.env (umask 077)" {class: app}
  helm: "make deploy:\nenv-secret, then helm upgrade\nwith hashes of app.env\n(--history-max 3)" {class: app}
  clean: "Always: rm app.env\nand the kubeconfig" {class: end}

  oidc -> allowed
  allowed -> denied: no
  allowed -> get: yes {class: hot}
  get -> helm: {class: hot}
}

chart: "make env-secret" {
  class: group
  direction: down
  parse: "check-app-env.sh: KEY=value lines\n(# comments skipped), keys ^H2_[A-Z0-9_]+\$" {class: app}
  dbpw: "H2_DATABASE_PASSWORD\npresent?" {class: decision}
  readsredis: "Rendered chart reads\nH2_REDIS_PASSWORD from this Secret?\n(not with redis.auth.existingSecret\nor redis.auth.enabled=false)" {class: decision}
  redispw: "H2_REDIS_PASSWORD =\n32+ letters and digits?" {class: decision}
  fail: "Deploy stops:\nnothing is applied" {class: fail}
  secret: "Secret helper2-app-env\n(kubectl server-side apply;\nnever a Helm value)" {class: data}
  sum: "Pod annotations from the hashes:\nchecksum/env-revision, checksum/auth\n(redis.auth.existingSecret: checksum/redis-auth-revision\n= redis.auth.revision, on app and redis)" {class: config}

  parse -> dbpw
  dbpw -> fail: no
  dbpw -> readsredis: yes {class: hot}
  readsredis -> redispw: yes {class: hot}
  readsredis -> secret: "no (--no-redis-password)"
  redispw -> fail: no
  redispw -> secret: yes {class: hot}
  secret -> sum
}

pods: Namespace helper2-<env> {
  class: group
  changed: "Hash changed?" {class: decision}
  restart: "Pod restarts with\nthe new values" {class: app}
  same: "Pods keep running" {class: end}
  app: "app: envFrom helper2-app-env\n+ chart env (H2_PROFILES,\nH2_DATABASE_URL, ...)" {class: app}
  others: "postgres: POSTGRES_PASSWORD\nredis: REDISCLI_AUTH → requirepass\npg-backup: PGPASSWORD" {class: app}

  changed -> restart: yes
  changed -> same: no
  restart -> app
}

spring: "Spring Boot startup (ADR 0007 point 8)" {
  class: group
  direction: down
  yaml: "application.yaml: H2_* variable\nor its default → helper2.* key\n(spring.profiles.active = H2_PROFILES)" {class: config}
  bind: "Bind each @ConfigurationProperties\nrecord (Duration, DataSize, URI, lists)" {class: app}
  valid: "Every key present\nand valid?" {class: decision}
  stop: "Startup fails,\nnaming the property" {class: fail}
  bean: "Record bean injected\n(secrets masked in toString)" {class: end}

  yaml -> bind: {class: hot}
  bind -> valid
  valid -> stop: no
  valid -> bean: yes {class: hot}
}

owner.put -> bao: "write" {class: config}
bao -> job.get: "read app_env" {class: hot}
job.helm -> chart.parse: {class: hot}
chart.sum -> pods.changed: "helm upgrade --wait" {class: hot}
chart.secret -> pods.others: "secretKeyRef" {class: config}
pods.app -> spring.yaml: {class: hot}
job.helm -> job.clean
