# Flowchart: how a secret travels from OpenBao to the app's environment, and how the app reads it.
# OpenBao helper2/kv ci/<env> (field app_env) -> CI deploy job -> <env>/app.env -> Helm -> Secret
# helper2-env -> pod env -> Spring property. Shows the chart's checks and the restart checksum.
# Source of truth: deploy/k8s/Makefile (credentials, deploy), .github/workflows/deploy.yml,
#   .github/actions/bao-login/action.yml, deploy/helm/helper2/templates/_helpers.tpl (helper2.env,
#   helper2.redisPasswordFrom), templates/secret.yaml, templates/app.yaml, templates/redis.yaml,
#   backend/src/main/resources/application.yaml.
# Render: cd docs/diagrams && d2 fmt flow-0007-configuration-and-secrets.d2 && d2 flow-0007-configuration-and-secrets.d2 flow-0007-configuration-and-secrets.svg

...@style

direction: down

owner: Owner workstation {
  class: group
  login: "bao login -method=oidc\nrole=helper2-operator" {class: person}
  put: "make ENV=<env> credentials:\nbao kv put -mount=helper2/kv ci/<env>\nkubeconfig=@... app_env=@<env>/app.env" {class: app}
  login -> put
}

bao: "OpenBao\nhelper2/kv ci/<env>\nfields: app_env, kubeconfig" {
  shape: cylinder
  class: data
}

job: CI deploy job (self-hosted runner) {
  class: group
  direction: down
  oidc: "bao-login: GitHub OIDC token\n→ auth/helper2/jwt/login\nrole deploy-<env>" {class: app}
  allowed: "Role bound to\nthis repo + environment?" {class: decision}
  denied: "Login refused:\nno secrets" {class: fail}
  get: "bao kv get -field=app_env ci/<env>\n> <env>/app.env (umask 077)" {class: app}
  helm: "make deploy:\nhelm --set-file envFile=<env>/app.env" {class: app}
  clean: "Always: rm app.env\nand the kubeconfig" {class: end}

  oidc -> allowed
  allowed -> denied: no
  allowed -> get: yes {class: hot}
  get -> helm: {class: hot}
}

chart: Helm chart render {
  class: group
  direction: down
  parse: "helper2.env: KEY=value lines\n(# comments skipped)" {class: app}
  dbpw: "H2_DATABASE_PASSWORD\npresent?" {class: decision}
  redispw: "H2_REDIS_PASSWORD =\n16+ letters and digits?" {class: decision}
  fail: "Render fails:\nnothing is deployed" {class: fail}
  secret: "Secret helper2-env\n(one key per line)" {class: data}
  sum: "Pod annotations:\nchecksum/env, checksum/auth" {class: config}

  parse -> dbpw
  dbpw -> fail: no
  dbpw -> redispw: yes {class: hot}
  redispw -> fail: no
  redispw -> secret: yes {class: hot}
  secret -> sum
}

pods: Namespace helper2-<env> {
  class: group
  changed: "Checksum changed?" {class: decision}
  restart: "Pod restarts with\nthe new values" {class: app}
  same: "Pods keep running" {class: end}
  app: "app: envFrom helper2-env\n+ chart env (H2_PROFILES,\nH2_DATABASE_URL, ...)" {class: app}
  others: "postgres: POSTGRES_PASSWORD\nredis: REDISCLI_AUTH → requirepass\npg-backup: PGPASSWORD" {class: app}

  changed -> restart: yes
  changed -> same: no
  restart -> app
}

spring: "Spring Boot: H2_* variables → properties\n(spring.profiles.active = H2_PROFILES)" {class: app}

owner.put -> bao: "write" {class: config}
bao -> job.get: "read app_env" {class: hot}
job.helm -> chart.parse: {class: hot}
chart.sum -> pods.changed: "helm upgrade --wait" {class: hot}
chart.secret -> pods.others: "secretKeyRef" {class: config}
pods.app -> spring: {class: hot}
job.helm -> job.clean
