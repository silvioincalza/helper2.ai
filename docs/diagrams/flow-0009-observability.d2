# Flowchart: where each kind of telemetry goes, and the switches that decide it.
# Shows the actuator filter, trace export and sampling, the context wrapper for search threads,
# structured logs on stdout, the pull of meters on the management port, the Grafana dashboard and the alert rules.
# Source of truth: backend/libs/platform/src/main/resources/helper2-shared.yaml
#   (management.*: the application tag, logging.structured),
#   backend/libs/platform/src/main/java/ai/helper2/platform/observability/ObservabilityConfiguration.java,
#   backend/libs/core/src/main/java/ai/helper2/search/config/SearchConfiguration.java, MicrometerSearchMetrics.java,
#   backend/libs/platform/src/main/java/ai/helper2/platform/llm/ModelCallMetrics.java, LlmConfiguration.java,
#   backend/libs/platform/src/main/java/ai/helper2/platform/http/ObservedHttp.java, backend/libs/core/src/main/java/ai/helper2/sources/config/LiveSourcesConfiguration.java, backend/apps/backoffice/src/main/java/ai/helper2/sources/config/scout/CollectorsConfiguration.java,
#   backend/apps/public/src/main/java/ai/helper2/guide/web/GuideStreamController.java (helper2.guide.first_useful),
#   deploy/helm/helper2/templates/app.yaml, prometheusrule.yaml, deploy/helm/helper2/values.yaml, deploy/grafana/helper2.json, helper2-backoffice.json,
#   deploy/monitoring/helper2-rules.yaml.
# Render: cd docs/diagrams && d2 fmt flow-0009-observability.d2 && d2 flow-0009-observability.d2 flow-0009-observability.svg

...@style

direction: down

req: "HTTP request" {class: end}
act: "Path under /actuator?\n(probes, scrapes)" {class: decision}
noobs: "No observation:\nno span, no http.server.requests" {class: end}
obs: "Server observation:\nspan + http.server.requests" {class: app}

work: Inside the request {
  class: group
  direction: down
  ctx: "searchExecutor wrapped by\nContextExecutorService:\nsource calls keep the trace" {class: app}
  client: "ObservedHttp RestClient\n(sources, embedder; bounded URI):\nclient span, http.client.requests,\ntrace headers" {class: app}
  model: "ModelCallMetrics.observe\n(guide steps, translate, tool-guide,\nenrich, classify): span +\nhelper2.llm.call, tokens" {class: app}
  meters: "Domain meters: helper2.search.*,\nhelper2.source.*, helper2.cache.events,\nhelper2.catalog.*, helper2.embedding.*,\n*.budget.remaining gauges …" {class: app}
  useful: "Guide stream: first retrieved\nor clarify event sent?\n→ helper2.guide.first_useful{intent}\n(target p50 3 s, p95 8 s)" {class: app}
  useful -> meters
  ctx -> client
  ctx -> meters
  model -> meters
}

traces: Traces {
  class: group
  direction: down
  export: "H2_TRACING_EXPORT=true?\n(chart: true; default false)" {class: decision}
  drop: "Not exported" {class: end}
  sample: "Sampled? (H2_TRACING_SAMPLING, 1.0)" {class: decision}
  otlp: "OTLP/HTTP to H2_OTLP_TRACES_ENDPOINT\n(Alloy :4318 → Tempo)" {class: ext}
  export -> drop: no
  export -> sample: yes
  sample -> otlp: yes {class: hot}
  sample -> drop: no
}

logs: "Structured logs on stdout\n(H2_LOG_FORMAT=logstash JSON,\ntraceId and spanId; no OTLP copy)" {class: app}

metrics: Metrics {
  class: group
  direction: down
  registry: "Micrometer registry\n(tags application = helper2 or\nhelper2-backoffice, environment;\nbuckets for latency timers)" {class: app}
  endpoint: "/actuator/prometheus on\nH2_MANAGEMENT_PORT 8081" {class: app}
  scrape: "Alloy scrapes (pod annotations)\n→ remote write to Prometheus" {class: ext}
  grafana: "Grafana: helper2.json (public app:\nHTTP, search, guide, runtime) and\nhelper2-backoffice.json (Scout, budgets,\nindexer, admin); latency from _bucket" {class: ext}
  alerts: "Alert rules deploy/monitoring/helper2-rules.yaml\n(rule file, or PrometheusRule with\nmonitoring.prometheusRule.enabled):\nper app by the application tag; first\nuseful p95 > 8 s for 15 min warns" {class: config}
  registry -> endpoint
  endpoint -> scrape: {class: hot}
  scrape -> grafana: {class: hot}
  scrape -> alerts: {class: config}
}

req -> act
act -> noobs: yes
act -> obs: no {class: hot}
obs -> work.ctx: {class: hot}
obs -> work.model
obs -> traces.export
work.client -> traces.export
work.model -> traces.export
obs -> logs
work.meters -> metrics.registry: {class: hot}
obs -> metrics.registry
