# Flowchart: how one query is ranked, from query analysis through the two-stage index query to the final fusion.
# Shows type hints and synonyms, the retrieval rule (any word OR similar title), stage 1 (cheap order, 300 rows),
# stage 2 (full text score), and Ranking.rank (reciprocal-rank fusion, boosts, bounded popularity).
# Source of truth: backend/src/main/kotlin/ai/helper2/search/QueryAnalyzer.kt, Ranking.kt,
#   backend/src/main/java/ai/helper2/catalog/internal/ResourceStore.java (searchSql, search, withFacts),
#   backend/src/main/resources/db/migration/V1__schema.sql (h2_resource_popularity, source_record_popularity).
# Render: cd docs/diagrams && d2 fmt flow-0009-ranking.d2 && d2 flow-0009-ranking.d2 flow-0009-ranking.svg

...@style

direction: down

q: "Query: \"mcp server postgres\"" {class: end}

analyze: QueryAnalyzer.analyze {
  class: group
  direction: down
  type: "\"server\" next to \"mcp\"?" {class: decision}
  hint: "typeHints += MCP_SERVER\n(word leaves required words)" {class: app}
  syn: "Synonym groups:\npostgres ↔ postgresql" {class: app}
  variants: "requiredVariants (max 4):\n\"mcp postgres\", \"mcp postgresql\"" {class: app}
  type -> hint: yes
  type -> syn: no
  hint -> syn
  syn -> variants
}

index: "ResourceStore.searchSql (helper2-index)" {
  class: group
  direction: down
  retrieve: "Row matches any word\n(english, simple, query language)\nOR title % query and similarity > 0.35?" {class: decision}
  skip: "not retrieved" {class: fail}
  stage1: "Stage 1: order by all words of a variant,\nthen popularity + similarity;\nkeep 300 (PRESELECT)" {class: data}
  stage2: "Stage 2: 2 (all words) + popularity\n+ 0.5 × min((ts_rank_cd × 3 + sim) / 10, 1)" {class: data}
  facts: "withFacts: labels in one query,\npopularity metrics in one query" {class: data}
  retrieve -> skip: no
  retrieve -> stage1: yes {class: hot}
  stage1 -> stage2: {class: hot}
  stage2 -> facts: {class: hot}
}

others: "Other sources rank their own hits\n(GitHub, Hugging Face, npm, semantic …)" {class: ext}
merge: "ResultMerger: one result\nper resource, hits kept" {class: app}

rank: Ranking.rank (k = 60) {
  class: group
  direction: down
  rrf: "Σ over sources: 1 / (60 + rank + 1)" {class: app}
  title: "Title equals query?" {class: decision}
  exact: "+0.05" {class: app}
  words: "Title has every word\nof the first variant?" {class: decision}
  some: "+0.02" {class: app}
  boosts: "+0.01 audience, +0.005 path type,\n+0.005 type hint" {class: app}
  pop: "+0.008 × strongest metric\nmin(1, ln(1+v) / ln(1+ref))" {class: app}
  rrf -> title
  title -> exact: yes
  title -> words: no
  words -> some: yes
  words -> boosts: no
  exact -> boosts
  some -> boosts
  boosts -> pop
}

out: "Sorted by score, then title, then id" {class: end}

q -> analyze.type: {class: hot}
analyze.variants -> index.retrieve: {class: hot}
index.facts -> merge: {class: hot}
others -> merge
merge -> rank.rrf: {class: hot}
rank.pop -> out: {class: hot}
