# Flowchart: the daily purges, one per owning module, and the rules of each in code order. Each rule deletes the
# parent row; foreign keys cascade to its children or set links to NULL. Periods are helper2.retention.* (H2_RETENTION_*).
# Source of truth: backend/libs/platform/src/main/java/ai/helper2/platform/DailyJobs.java, DailyJob.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/usecase/PurgeExpiredData.java, catalog/internal/JdbcCatalogRetention.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/catalog/schedule/CatalogRetentionSchedule.java, backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/PurgeExpiredData.kt,
#   scout/internal/ScoutRetentionSchedule.java, JdbcScoutStore.java, identity/usecase/PurgeInactiveAccounts.java,
#   PurgeExpiredAuditEntries.java, apps/public/.../identity/schedule/AccountRetentionSchedule.java,
#   apps/backoffice/.../identity/schedule/AuditRetentionSchedule.java, identity/Users.java, AuditLog.java (ports),
#   identity/internal/JdbcUsers.java, JdbcAuditLog.java,
#   backend/libs/core/src/main/kotlin/ai/helper2/search/usecase/PurgeExpiredData.kt, search/config/SearchRetentionSchedule.java,
#   search/internal/JdbcWebResultStore.java, platform/cache/SharedCacheConfiguration.java, SharedCacheRetention.java,
#   backend/apps/public/src/main/kotlin/ai/helper2/guide/usecase/PurgeExpiredData.kt, guide/schedule/GuideRetentionSchedule.java,
#   guide/internal/JdbcSimilarQuestionIndex.java, db/migration/V1__schema.sql.
# Render: cd docs/diagrams && d2 fmt flow-0010-data-retention.d2 && d2 flow-0010-data-retention.d2 flow-0010-data-retention.svg

...@style

direction: down

cron: "DailyJobs: each DailyJob on\nRetentionSchedule.cron\n(default 0 17 3 * * *, UTC),\non every replica" {class: end}
lock: "ClusterLocks.keptAlive: this module's\nlock free? (retention-catalog,\nretention-scout, retention-accounts,\nretention-audit, retention-search,\nretention-guide, retention-shared-cache,\nretention-runtime-settings)" {class: decision}
skip: "Another replica purges today" {class: end}

catalog: "catalog.usecase.PurgeExpiredData (in this order)" {
  class: group
  direction: down
  rev: "review_item resolved > 180 d,\nnot tied to a report\n(candidate_decision stays)" {class: data}
  rep: "issue_report whose review items\nall resolved > 365 d (with them)" {class: data}
  runs: "enrichment_run > 90 d, not the latest\nof its resource, cited by nothing" {class: data}
  news: "tavily / live-web-scout NEWS, ARTICLE\nrecords > 180 d; then resources\nleft without a record" {class: data}
  events: "EVENT resources ended\n(or started) > 10 years ago:\nOBSERVED, INDEXED, CURATED;\nthe quote of a curated\nevent's days goes with it" {class: data}
  observed: "OBSERVED resources unseen > 180 d,\nnot linked from a stronger origin,\nno field set by an admin" {class: data}
  ref: "Every resource rule: no issue report\nand no review item points at it?" {class: decision}
  later: "Kept: goes in a later\npurge, after its report\nor review item" {class: end}
  rev -> rep -> runs -> news -> events -> observed
  observed -> ref
}

scout: "scout purge" {
  class: group
  direction: down
  sruns: "scout.usecase.PurgeExpiredData:\nscout_run started > 90 d\n(RUNNING stays)" {class: data}
}

identity: "identity purges" {
  class: group
  direction: down
  users: "PurgeInactiveAccounts (public app):\napp_user last sign-in > 730 d\n(bookmarks cascade)" {class: data}
  audit: "PurgeExpiredAuditEntries (back office):\nadmin_audit at > 730 d; V1 refuses\na row younger than 729 d" {class: data}
}

search: "search purge" {
  class: group
  direction: down
  sets: "search.usecase.PurgeExpiredData:\nlive_web_query_result fetched > 7 d" {class: data}
}

shared: "shared cache purge (platform)" {
  class: group
  direction: down
  expired: "SharedCacheRetention:\nai_cache expires_at ≤ now\n(reads already skip them)" {class: data}
}

guide: "guide purge" {
  class: group
  direction: down
  questions: "guide.usecase.PurgeExpiredData:\nguide_similar_question\npast expires_at" {class: data}
}

cascade: "ON DELETE CASCADE: records, labels, embeddings,\nevidence, assertions, claims of a resource;\nON DELETE SET NULL: links that outlive their target;\nNO ACTION: a run a current row cites stays" {class: data}
logged: "Each logs what it deleted;\na failure is logged, the next\nday's run catches up" {class: end}

cron -> lock: {class: hot}
lock -> skip: no
lock -> catalog.rev: "yes (catalog)" {class: hot}
lock -> scout.sruns: "yes (scout)"
lock -> identity.users: "yes (accounts)"
lock -> identity.audit: "yes (audit)"
lock -> search.sets: "yes (search)"
lock -> shared.expired: "yes (shared cache)"
lock -> guide.questions: "yes (guide)"
catalog.ref -> cascade: "yes: deleted" {class: hot}
catalog.ref -> catalog.later: no
scout.sruns -> logged
identity.users -> logged
identity.audit -> logged
search.sets -> logged
shared.expired -> logged
guide.questions -> logged
cascade -> logged
