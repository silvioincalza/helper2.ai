# Flowchart: what each Scout collector does in collect(), after RunScout has called it.
# Shows the shared gates (enabled, token, run interval) and the decisions inside each collector,
# with the awesome-list classifier in detail.
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/sources/ (mcp/McpRegistryCollector,
#   huggingface/scout/HuggingFaceTrendingCollector, huggingface/scout/HuggingFaceProviderOrgsCollector,
#   tavily/scout/LiveWebNewsCollector, tavily/scout/CourseCollector, tavily/scout/DiscoveryCollector,
#   github/scout/GitHubAwesomeCollector, classifier/SpringAiRepoClassifier, classifier/RepoClassifier,
#   aideadlines/AiDeadlinesCollector, config/scout/CollectorsConfiguration),
#   backend/libs/core/src/main/java/ai/helper2/sources/support/RunInterval.java,
#   backend/libs/platform/src/main/resources/helper2-shared.yaml, backend/apps/backoffice/src/main/resources/application.yaml (helper2.scout.*, helper2.sources.*).
# Render: cd docs/diagrams && d2 fmt flow-0012-scout-collectors.d2 && d2 flow-0012-scout-collectors.d2 flow-0012-scout-collectors.svg

...@style

direction: down

call: "collect(checkpoint,\nresumeCursor, maxItems)" {class: app}
enabled: "Enabled? (Tavily needs\nH2_LIVE_WEB_API_KEY, awesome\nlists need H2_GITHUB_TOKEN)" {class: decision}
skipped: "SKIPPED by RunScout" {class: end}
due: "RunInterval: no checkpoint,\ninterval passed, or resume?" {class: decision}
notDue: "CollectedBatch.notDue()" {class: end}
which: "Which collector?" {class: decision}

mcp: "MCP Registry (1 h;\nread daily with the cron):\n/v0.1/servers?updated_since,\nlatest versions only, cursor pages" {class: ext}
hft: "HF trending (1 d):\ntop 100 by trendingScore,\nlikes ≥ 20" {class: ext}
hfo: "HF provider orgs (1 d):\n20 newest models per org,\norg added as a tag; a failed\norg is skipped, checkpoint stays" {class: ext}
tav: "Tavily (5 d): 7 news queries,\nstart_date = last pass day\n(first run: last week)" {class: ext}
courses: "Courses (7 d): one Tavily search\nper platform (include_domains);\nkeep pages on the platform,\nabout AI, course-like" {class: ext}
disc: "Tavily discovery: 34 categories,\none collector each (7 d, staggered,\n39 searches); lists → ARTICLE,\nproduct sites → candidates;\nevery category's tag (ADR 0013)" {class: ext}
both: "CollectedBatch(list hits,\ncheckpoint, candidates)" {class: end}
aid: "ai-deadlines (1 d): one YAML\nper conference, raw host only,\nnext edition not ended" {class: ext}

awesome: GitHub awesome lists (1 d) {
  class: group
  direction: down
  lists: "Topic search: repos named\n\"awesome…\", ≥ 1000 stars,\ntop 10 lists" {class: ext}
  slice: "README links → entries;\n≤ 1000 per pass and per run\nfrom the offset cursor" {class: app}
  facts: "GraphQL facts, 50 per call;\n≥ 50 stars (collection scope);\narchived and fork are stated" {class: ext}
  model: "LLM configured\nand fast model set?" {class: decision}
  classify: "SpringAiRepoClassifier:\nbatches of 25, own budget\n(300 calls per UTC day)" {class: ai}
  answered: "Model answered\nthis id?" {class: decision}
  heuristic: "RepoClassifier.Heuristic\n(keyword rules)" {class: app}
  keep: "Keep ai=true, with the given type\nand its vitality (RunScout refuses\nan archived one, ADR 0020)" {class: app}

  lists -> slice -> facts -> model
  model -> classify: yes
  model -> heuristic: no
  classify -> answered
  answered -> keep: yes
  answered -> heuristic: "no (error, budget,\nmissing id)"
  heuristic -> keep
}

batch: "CollectedBatch(hits,\nnextCursor, checkpoint)" {class: end}
candidates: "CollectedBatch(no hits, checkpoint,\ncandidates): RunScout sends them\nto the review list" {class: end}

call -> enabled
enabled -> skipped: no
enabled -> due: yes {class: hot}
due -> notDue: no
due -> which: yes {class: hot}
which -> mcp
which -> hft
which -> hfo
which -> tav
which -> courses
which -> disc
which -> aid
which -> awesome.lists
mcp -> batch
hft -> batch
hfo -> batch
tav -> batch
courses -> candidates
disc -> both
aid -> batch
awesome.keep -> batch
