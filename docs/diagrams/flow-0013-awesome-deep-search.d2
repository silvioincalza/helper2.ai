# Flowchart: how a pass reads nested awesome lists, which links become review items, and where categories come from (ADR 0013).
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/AwesomeCrawl.java, ProductLinks.java,
#   AwesomeListParser.java (Link, Entry.pointsAtList), GitHubAwesomeCollector.java (read, candidates, candidate),
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/DiscoveryPages.java (productSite),
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java (propose with a daily cap),
#   backend/libs/kernel/src/main/kotlin/ai/helper2/shared/Categories.kt (CategoryMatcher, headings),
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/usecase/IndexAwesomeLists.java, catalog/internal/JdbcCatalogWriter.java.
# Render: cd docs/diagrams && d2 fmt flow-0013-awesome-deep-search.d2 && d2 flow-0013-awesome-deep-search.d2 flow-0013-awesome-deep-search.svg

...@style

direction: down

seeds: "Seed lists: top 10 by stars\n(depth 0, queued first)" {class: end}

crawl: "AwesomeCrawl (breadth first)" {
  class: group
  direction: down
  budget: "Time (15 min) or README\nbytes (50 MB) spent?" {class: decision}
  unread: "Lists left wait for the next pass\n(skip: time-budget / size-budget)" {class: end}
  nested: "Nested list?" {class: decision}
  facts: "GET /repos/{owner}/{repo}:\nnot archived, not a fork, 50+ stars,\nAI words in name, description, topics?" {class: decision}
  dropped: "Not followed\n(skip: nested-archived, -fork,\n-few-stars, -not-ai, -unavailable)" {class: end}
  readme: "GET README (5 MB, 60 s)\nparse: entries, headings, links" {class: app}
  limited: "Rate limited?" {class: decision}
  stop: "Seed: the pass fails.\nNested: stop following,\nkeep what was read" {class: fail}
  listlinks: "For each entry that points at a list\n(name says awesome, or a section of lists)" {class: decision}
  queue: "Queue at depth + 1" {class: app}
  skipped: "Skip: nested-depth (depth 2 reached),\nnested-seen (read or queued: cycle guard),\nnested-cap (30 tried this run)" {class: end}
  budget -> unread: "yes"
  budget -> nested: "no"
  nested -> readme: "no (seed)"
  nested -> facts: "yes"
  facts -> dropped: "no"
  facts -> readme: "yes"
  readme -> limited
  limited -> stop: "yes"
  limited -> listlinks: "no"
  listlinks -> queue: "new, under depth and cap"
  listlinks -> skipped: "otherwise"
  queue -> budget: "next in queue"
}

lists: "Every list read: a list resource (ARTICLE,\nawesome-list) and its text for the list index;\nits entries join the pass (lists read left out)" {class: app}

product: "ProductLinks: first link of an entry, outside GitHub" {
  class: group
  direction: down
  safe: "https, a public name: no IP, user info,\nport, private name, punycode?" {class: decision}
  redirect: "Redirect, shortener, GitHub page\nor excluded domain?" {class: decision}
  site: "DiscoveryPages.productSite:\nhome page or one-level page?\n(no docs, blogs, articles)" {class: decision}
  skip: "Skipped (skip: link-<reason>)" {class: end}
  keep: "Product site, no query, no fragment;\nonce per pass, at most 500" {class: app}
  safe -> skip: "no"
  safe -> redirect: "yes"
  redirect -> skip: "yes"
  redirect -> site: "no"
  site -> skip: "no"
  site -> keep: "yes"
}

tags: "CategoryMatcher: heading path as an input,\neach heading alone (id or words; never\nhealth or legal alone); at most 12 tags" {class: app}

review: "ReviewQueueCandidateReview" {
  class: group
  direction: down
  cap: "Fewer than 50 items opened\nby github-awesome today (UTC)?" {class: decision}
  open: "Open a RESOURCE_CANDIDATE\n(foundBy: list URL, section)\nor join the OPEN item of the site" {class: data}
  join: "Only join the OPEN item\nof the site, if one waits" {class: data}
  cap -> open: "yes"
  cap -> join: "no"
}

assign: "IndexAwesomeLists: after a list's entries are written,\nassign their categories again; JdbcCatalogWriter reads\nthe heading paths of awesome_list_entry" {class: data}

seeds -> crawl.budget
crawl.readme -> lists
crawl.readme -> product.safe: "first run of a pass"
product.keep -> tags
tags -> review.cap
lists -> assign: "after the hits are indexed"
