# Flowchart: an admin adds a host to discovery's lists, and how a discovery run uses the lists (ADR 0013).
# Source of truth: backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/DiscoveryHosts.kt (HostNames.check),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/ManageDiscoveryHosts.kt (add, remove),
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/DiscoveryCollector.java (collect),
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/DiscoveryPages.java (productSite, isWritingPage).
# Render: cd docs/diagrams && d2 fmt flow-0013-discovery-hosts.d2 && d2 flow-0013-discovery-hosts.d2 flow-0013-discovery-hosts.svg

...@style

direction: down

admin: "Admin adds a host\n(Settings page, VPN)" {class: person}
reason: "Reason one plain line,\nat most 500 characters?" {class: decision}
name: "Only a host name?\nnot \"com\", \"co.uk\", an IP\naddress or github.com" {class: decision}
listed: "In a list already\n(either kind)?" {class: decision}
full: "500 hosts already?" {class: decision}
refused: "400: nothing changes,\nno audit row" {class: fail}
duplicate: "409 duplicate\n(audit: ALREADY_LISTED)" {class: fail}
stored: "Row in discovery_host;\naudit ADD_DISCOVERY_HOST\n(one transaction)" {class: data}

run: "Discovery run starts\n(Tavily or awesome lists)" {class: app}
read: "Lists read?" {class: decision}
failed: "Run fails before any search;\ncheckpoint stays" {class: fail}
pages: "DiscoveryPages for this run\n(the lists as they are now)" {class: app}
directory: "Host in DIRECTORY?" {class: decision}
dropped: "Never a product,\nnever a post" {class: end}
writing: "Host in WRITING?" {class: decision}
article: "A post there:\nARTICLE candidate" {class: end}
rules: "Rules by address\n(home page, /blog/, a post's slug …)" {class: end}

admin -> reason: {class: hot}
reason -> refused: no
reason -> name: yes {class: hot}
name -> refused: no
name -> listed: yes {class: hot}
listed -> duplicate: yes
listed -> full: no {class: hot}
full -> refused: "yes (400)"
full -> stored: no {class: hot}
stored -> run: next run {class: hot}

run -> read: {class: hot}
read -> failed: no
read -> pages: yes {class: hot}
pages -> directory: {class: hot}
directory -> dropped: yes
directory -> writing: no {class: hot}
writing -> article: yes {class: hot}
writing -> rules: no
