# Flowchart: how Compatibility.of turns one merged result into "works with" flags.
# Shows the TYPE rule, the per-hit tag loop with normalization, TAG versus FORMAT, first source wins,
# and the fixed display order. Also where catalog tags come from (labels rebuilt on every upsert).
# Source of truth: backend/src/main/kotlin/ai/helper2/search/Compatibility.kt,
#   backend/src/main/java/ai/helper2/search/web/CardMapper.java,
#   backend/src/main/java/ai/helper2/catalog/internal/ResourceStore.java (replaceLabels, MAX_TAGS).
# Render: cd docs/diagrams && d2 fmt flow-0013-works-with-flags.d2 && d2 flow-0013-works-with-flags.d2 flow-0013-works-with-flags.svg

...@style

direction: down

labels: "Catalog hits: tags = resource_label TAG rows,\nrebuilt from current source_record.extra\non every upsert (≤ 20, ≤ 60 chars)" {class: data}
live: "Live hits: tags as the\nsource API returned them" {class: ext}
card: "CardMapper.card(result)" {class: app}

rules: Compatibility.of(result) {
  class: group
  direction: down
  mcp: "type == MCP_SERVER?" {class: decision}
  typeflag: "flag mcp, basis TYPE,\nevidence MCP_SERVER, source null" {class: app}
  loop: "For each hit, each tag:\nnormalize (trim, lower case,\n_ and space → -)" {class: app}
  has: "Tool already flagged?" {class: decision}
  next: "next tool" {class: end}
  tag: "Tag in tool's tag set?" {class: decision}
  tagflag: "basis TAG,\nevidence = raw tag,\nsource = hit.sourceId" {class: app}
  fmt: "Tag in tool's formats\n(gguf → Ollama, llama.cpp)?" {class: decision}
  fmtflag: "basis FORMAT" {class: app}
  order: "Return flags in the order\nof Compatibility.TOOLS" {class: app}

  mcp -> typeflag: yes
  mcp -> loop: no
  typeflag -> loop
  loop -> has
  has -> next: yes
  has -> tag: no
  tag -> tagflag: yes {class: hot}
  tag -> fmt: no
  fmt -> fmtflag: yes
  fmt -> next: no
  tagflag -> order
  fmtflag -> order
  next -> order: "all tags done"
}

none: "No flag: nothing stated\n(not \"incompatible\")" {class: end}
out: "card.compatibleWith[]" {class: end}

labels -> card
live -> card
card -> rules.mcp: {class: hot}
rules.order -> out: "flags" {class: hot}
rules.order -> none: "empty"
