# Flowchart: every guard a guide question passes before it may spend model calls, in code order.
# Rate limit (interceptor) → slot and deadline (GuideLimits) → answer cache → single-flight → client quota
# → global daily budget (taken before each model attempt) → an answer with no AI pick, a failed or timed-out
#   question, or a shared answer gives its question back (AskGuide.settle, in one finally).
# Source of truth: backend/libs/platform/src/main/java/ai/helper2/platform/RateLimitInterceptor.java, ClientKey.java,
#   backend/apps/helper2/src/main/java/ai/helper2/guide/web/GuideLimits.java (guide bulkhead), GuideStreamController.java (keep-alive),
#   backend/apps/helper2/src/main/resources/application.yaml (resilience4j.bulkhead.instances.guide, llm-chat circuit),
#   backend/apps/helper2/src/main/kotlin/ai/helper2/guide/usecase/AskGuide.kt (AskGuide.ask),
#   backend/apps/helper2/src/main/kotlin/ai/helper2/guide/GuideCost.kt (ClientQuota, GuideAnswerCache),
#   backend/apps/helper2/src/main/java/ai/helper2/guide/internal/SharedGuideAnswerStore.java, GuideConfiguration.java.
#   Normalised keys and the reuse of a similar question's answer: flow-0041.
#   The searches of a question take the asker's daily web searches (flow-0037), not drawn here.
# Render: cd docs/diagrams && d2 fmt flow-0017-guide-cost-guard.d2 && d2 flow-0017-guide-cost-guard.d2 flow-0017-guide-cost-guard.svg

...@style

direction: down

ask: "POST /api/v1/guide/stream" {class: person}
rate: "Rate limit: 10 per minute\nper client (IPv6 by /64),\nshared with the tool guide" {class: decision}
r429: "429 Too Many Requests\n+ Retry-After" {class: fail}
slot: "GuideLimits: free slot in\nthe guide bulkhead?\n(H2_GUIDE_MAX_CONCURRENT 8)" {class: decision}
busy: "503 Guide busy\n(error event on the stream)" {class: fail}
key: "Cache key: SHA-256 of normalised\ntext | path | config hash (ADR 0041)" {class: app}
cache: "Answer cache hit?\n(shared cache guide-answer,\nPostgreSQL)" {class: decision}
cached: "Cached answer\n(same generatedAt)" {class: end}
flight: "Same key already\nbeing answered?" {class: decision}
shared: "Wait for that answer\n(single-flight; the stream\ngets only :keep-alive)" {class: end}
quota: "ClientQuota.reserve: fresh question\nleft today for this ClientKey?\n(H2_GUIDE_CLIENT_DAILY_QUESTIONS 30)" {class: decision}
searchOnly: "Search-only answer\n+ notice GUIDE_DAILY_QUOTA" {class: end}
run: "Plan; a similar question's\ncached answer (ADR 0041), or\nsearch → choose → validate →\nreason check" {class: ai}
circuit: "llm-chat circuit closed?\n(each model attempt)" {class: decision}
budget: "Global daily budget unit\nbefore each model attempt?\n(H2_GUIDE_DAILY_MODEL_CALLS 600)" {class: decision}
degraded: "Degraded answer\n(top search results)" {class: fail}
deadline: "Deadline passed?\n(H2_GUIDE_QUESTION_DEADLINE 90 s)" {class: decision}
timeout: "504 Guide timed out,\nworker interrupted" {class: fail}
error: "Error escapes ask\n(error event on the stream)" {class: fail}
spends: "AI pick, comparison or\nexplanation in the answer?" {class: decision}
free: "Free answers left today?\n(no pick, failed and shared\nshare one cap)\n(H2_GUIDE_CLIENT_DAILY_FREE_ANSWERS,\ndefault the daily questions)" {class: decision}
giveBack: "Give the question back, once\nper reservation, never below 0\n(model calls stay in the global cap)" {class: data}
cacheable: "Cacheable? AI pick, no reason\nNOT_CHECKED, web results it used\nstill fresh" {class: decision}
store: "Store in the shared cache for\nmin(24 h, freshness left of its\nweb results, ADR 0037)" {class: data}
answer: "Last event: the answer,\nor the error or timeout" {class: end}

ask -> rate
rate -> r429: over
rate -> slot: ok {class: hot}
slot -> busy: no
slot -> key: "yes (stream: :keep-alive\nevery 15 s from now)" {class: hot}
key -> cache
cache -> cached: hit
cache -> flight: miss {class: hot}
flight -> shared: yes
flight -> quota: no {class: hot}
quota -> searchOnly: no
quota -> flight2: yes {class: hot}
flight2: "Same key started\nmeanwhile?" {class: decision}
flight2 -> free: "yes: shared answer"
flight2 -> run: no {class: hot}
run -> error: throws
error -> free: failed
run -> circuit
circuit -> degraded: "open: circuit_open"
circuit -> budget: closed {class: hot}
budget -> degraded: no
budget -> deadline: yes {class: hot}
deadline -> timeout: yes
timeout -> free: failed
deadline -> spends: no {class: hot}
spends -> cacheable: yes {class: hot}
spends -> free: "no (no pick, question back,\nmodel down)"
free -> giveBack: yes
free -> answer: "no: it counts"
giveBack -> answer
cacheable -> store: yes
cacheable -> answer: no
store -> answer: {class: hot}
