# Flowchart: EnrichResource.enrich for one resource, from loading its source text to stored assertions and review items.
# Shows the UNCHANGED skip, the daily cap, the error outcomes, EvidenceValidator's rules and what is written.
# Source of truth: backend/src/main/kotlin/ai/helper2/scout/usecase/EnrichResource.kt (EnrichResource),
#   backend/src/main/kotlin/ai/helper2/scout/Enrichment.kt (EvidenceValidator),
#   backend/src/main/java/ai/helper2/scout/internal/SpringAiEnrichmentModel.java, JdbcEnrichmentStore.java,
#   backend/src/main/java/ai/helper2/catalog/ReviewQueue.java.
# Render: cd docs/diagrams && d2 fmt flow-0019-evidence-gated-enrichment.d2 && d2 flow-0019-evidence-gated-enrichment.d2 flow-0019-evidence-gated-enrichment.svg

...@style

direction: down

start: "enrich(resourceId)" {class: app}
load: "Source records loaded?\n(title + description)" {class: decision}
noMat: "REJECTED\n(nothing to cite)" {class: fail}
same: "Same input fingerprint as\nthe last VALIDATED/PARTIAL run?" {class: decision}
unchanged: "UNCHANGED: no model call,\nnothing recorded;\nrun slot given back" {class: end}
budget: "Enrichment daily budget\nunit left? (300)" {class: decision}
call: "Reasoning model, enrich-v3,\nthinking off, 8192 max tokens" {class: ai}
callOk: "Provider answered?" {class: decision}
unavail: "LLM_UNAVAILABLE run saved;\nresource back in backlog;\nrun stops enriching" {class: fail}
json: "Answer is the\nrequested JSON?" {class: decision}
failed: "FAILED run saved\n(retried, at most 3 failures)" {class: fail}

rules: EvidenceValidator, per proposed item {
  class: group
  direction: down
  allowed: "Field and value\nin the allowed list?" {class: decision}
  cites: "Cites a retrieved evidence id;\nexcerpt 20–300 chars\nfound verbatim in it?" {class: decision}
  fact: "Differs from a value\nthe source states?" {class: decision}
  states: "license / openSource /\nplatforms: excerpt states\nthe value?" {class: decision}
  rejected: REJECTED {class: fail}
  conflicting: CONFLICTING {class: fail}
  unverified: UNVERIFIED {class: fail}
  verified: VERIFIED {class: end}

  allowed -> rejected: no
  allowed -> cites: yes
  cites -> rejected: no
  cites -> fact: yes
  fact -> conflicting: yes
  fact -> states: no
  states -> unverified: no
  states -> verified: "yes (or other field)"
}

outcome: "Run outcome:\nREJECTED (nothing accepted),\nVALIDATED (no error) or PARTIAL" {class: app}
save: "Save run; delete older\nAI_EXTRACTED field assertions;\ninsert non-rejected items" {class: data}
review: "Errors or CONFLICTING → ENRICHMENT_VALIDATION;\nUNVERIFIED relationship → RELATIONSHIP_CANDIDATE\n(ReviewQueue)" {class: data}

start -> load
load -> noMat: no
load -> same: yes {class: hot}
same -> unchanged: yes
same -> budget: no {class: hot}
budget -> unavail: no
budget -> call: yes {class: ai-call}
call -> callOk
callOk -> unavail: "no (timeout, 429, 5xx)"
callOk -> json: yes {class: hot}
json -> failed: "no (or 4xx)"
json -> rules.allowed: yes {class: hot}
rules.verified -> outcome
rules.rejected -> outcome
rules.conflicting -> outcome
rules.unverified -> outcome
outcome -> save: {class: hot}
save -> review
