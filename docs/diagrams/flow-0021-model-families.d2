# Flowchart: how curated model-family specs get into the database, and how GET /api/v1/model-families builds its answer.
# Source of truth: scripts/model-families-seed.mjs, docs/research/model-families-2026-10-27.json,
#   backend/src/main/resources/db/migration/R__model_families.sql,
#   backend/src/main/java/ai/helper2/catalog/usecase/ListModelFamilies.java,
#   backend/src/main/java/ai/helper2/catalog/web/ResourcesController.java (listModelFamilies),
#   frontend/src/pages/ModelsPage.tsx.
# Render: cd docs/diagrams && d2 fmt flow-0021-model-families.d2 && d2 flow-0021-model-families.d2 flow-0021-model-families.svg

...@style

direction: down

seed: Build time (by hand) {
  class: group
  direction: down
  research: "Research file: every fact with\nprovider URL + verbatim excerpt\n(read 2026-10-27)" {class: data}
  known: "Provider in the\nscript's FAMILIES list\nand models page set?" {class: decision}
  stop: "Script fails:\nno SQL written" {class: fail}
  fact: "Fact has a value\nand a URL?" {class: decision}
  absent: "No assertion:\nshown \"Not stated\"" {class: end}
  sql: "R__model_families.sql:\nupsert resource, curated source\nrecord, model_family row;\nreplace CURATED assertions" {class: data}

  research -> known
  known -> stop: no
  known -> fact: yes
  fact -> absent: no
  fact -> sql: yes
}

flyway: "Flyway re-runs the repeatable\nseed when its checksum changes;\nfamilies not in the file are deleted" {class: data}

read: Request time {
  class: group
  direction: down
  get: "GET /api/v1/model-families" {class: person}
  rows: "model_family rows\nby position (9 today)" {class: data}
  detail: "GetResourceDetail.find\n(family resource) present?" {class: decision}
  dropped: "Family left out" {class: fail}
  specs: "Specs = CURATED assertions\nwithout a source id,\neach with URL, excerpt, date" {class: app}
  tags: "Family has provider tags?\n(Anthropic: none)" {class: decision}
  none: "No listed models" {class: end}
  listed: "5 newest MODEL records of\nhf-provider-orgs with that tag\n(never merged with specs)" {class: app}
  out: "200, Cache-Control:\npublic, max-age 5 min" {class: end}

  get -> rows -> detail
  detail -> dropped: no
  detail -> specs: yes {class: hot}
  specs -> tags
  tags -> none: no
  tags -> listed: yes {class: hot}
  listed -> out: {class: hot}
  none -> out
}

seed.sql -> flyway -> read.rows: "at startup" {class: config}
