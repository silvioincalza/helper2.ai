# Flowchart: the one box. What typed text does: live search, or "Ask the guide".
# Shows the 3-character minimum and the 700 ms pause for live search, the two buttons (Search, Ask the guide), Enter
# (always a search), Shift+Enter (always asks the guide), Enter in an empty box, and what each choice writes to the URL. The box itself: line breaks become
# spaces, it grows up to six lines, Enter during IME composition is left alone, × or Esc empties it (results stay),
# "/" from anywhere puts the cursor in it.
# Every writer goes through the URL: HomePage (frontend/src/pages/HomePage.tsx) renders from it
# (useSearchParams + parseSearchParams), so live search, Search and Ask only change the URL.
# Source of truth: frontend/src/components/OneBox.tsx, frontend/src/pages/HomePage.tsx,
#   frontend/src/lib/searchState.ts, frontend/src/components/results/Results.tsx, frontend/src/hooks/useApi.ts,
#   frontend/src/hooks/useGuideStream.ts.
# Render: cd docs/diagrams && d2 fmt flow-0025-frontend-one-box.d2 && d2 flow-0025-frontend-one-box.d2 flow-0025-frontend-one-box.svg

...@style

direction: down

slash: "\"/\" on the page\n(not while typing in a field)" {class: person}
type: "User types in the box" {class: person}
norm: "Line breaks become spaces;\nthe box grows (≤ 6 lines, animated);\n\"N left\" from 50 characters left" {class: app}
emptybox: "× or Esc:\nempty the box, keep the results,\ncursor stays" {class: end}

live: Live search (onType) {
  class: group
  direction: down
  min: "At least 3 characters\n(after trim, ≤ 200)?" {class: decision}
  wait: "Wait 700 ms after\nthe last key" {class: app}
  home: "On /search and\nq differs from the URL?" {class: decision}
  replace: "Replace URL ?q=…\n(keeps ask, clar, drop and filters)" {class: app}
  nothing: "Nothing yet" {class: end}
  min -> nothing: no
  min -> wait: yes
  wait -> home
  home -> replace: yes {class: hot}
  home -> nothing: no
}

key: "Enter or Shift+Enter" {class: app}
shift: "Shift held?" {class: decision}
sbutton: "Search button" {class: app}
gbutton: "Ask the guide button" {class: app}
ime: "Composing (IME)?" {class: decision}
imeend: "Ignored: the input method\nkeeps the key" {class: end}
empty: "Enter in an empty box?" {class: decision}
clear: "Back to the empty home page" {class: end}
nothing: "Nothing to send?\n(empty, or under 3 characters to ask)" {class: decision}
focus: "Cursor in the box" {class: end}
search: "Search: ?q=… (cancel live timer)" {class: app}
ask: "Ask the guide: ?q=…&ask=…\n(question ≤ 500 chars;\na new question drops clar and drop)" {class: app}

page: "HomePage on /search: Results" {
  class: group
  direction: down
  results: "useApi: GET /api/v1/search\n(old request aborted; previous results\nstay, dimmed, aria-busy; a key answered\n< 5 min ago renders from memory, no request)" {class: app}
  guide: "GuidePicks + useGuideStream:\nPOST /api/v1/guide/stream\n(picks bar: how it read the question,\nhow many results, then picks)" {class: app}
}

url: "URL on /search: ?q=… (&ask=…)\nHomePage reads it (useSearchParams)" {class: app}

other: "On another page: navigate to /search\nwith the same parameters" {class: app}

slash -> type: "cursor in the box"
type -> norm: "each key or paste"
norm -> live.min
type -> emptybox: "× / Esc"
type -> key: "Enter"
type -> sbutton: "click"
type -> gbutton: "click"
live.replace -> url: {class: hot}
key -> ime
ime -> imeend: yes
ime -> empty: no
empty -> clear: yes
empty -> shift: no
shift -> search: no {class: hot}
shift -> ask: yes
sbutton -> nothing
gbutton -> nothing
nothing -> focus: yes
nothing -> search: "no (Search)"
nothing -> ask: "no (Ask the guide)"
search -> url: {class: hot}
ask -> url: "&ask=…"
search -> other: "not on /search"
ask -> other: "not on /search"
other -> url: "same parameters"
url -> page.results: {class: hot}
url -> page.guide: "ask set" {class: ai-call}
