# Flowchart: what one search (or one search of a guide question) does with the metered web source, Tavily.
# Store first; a live call only inside the asker's daily web searches; every live call counts on the global counter
# (the credits of the day, capped only when set) and gives it back when the source-live-web policy refuses the call;
# a web search with no live answer (failed, timed out, refused) gives the asker's own web search back;
# a live answer replaces the stored set.
# Source of truth: backend/libs/core/src/main/kotlin/ai/helper2/search/usecase/SourceFanOut.kt (Run.start, Run.quotaAllows, Run.settleWebSearches, Run.save, stale),
#   backend/libs/core/src/main/kotlin/ai/helper2/search/WebSearch.kt (IntentClass, WebFreshness, WebSearchQuota, refund, giveBack, answered, creditsToday),
#   backend/libs/core/src/main/kotlin/ai/helper2/search/usecase/ListSources.kt (webCredits),
#   backend/libs/core/src/main/java/ai/helper2/search/internal/JdbcWebResultStore.java, catalog/internal/CatalogResultObserver.java (recordedHits),
#   backend/libs/platform/src/main/java/ai/helper2/platform/quota/RedisQuotaCounter.java, QuotaKeys.java,
#   backend/apps/public/src/main/kotlin/ai/helper2/guide/usecase/AskGuide.kt (find, forAsker), guide/GuideCost.kt (GuideAnswerCache.ttlOf).
# Render: cd docs/diagrams && d2 fmt flow-0027-tavily-store-and-quota.d2 && d2 flow-0027-tavily-store-and-quota.d2 flow-0027-tavily-store-and-quota.svg

...@style

direction: down

req: "Search or guide question\n(Asker: feature, client)" {class: person}
intent: "IntentClass: time-bound (news, courses,\nhackathons, conferences, events; guide:\nNEWEST, WHEN, LEARN) or general" {class: app}
lookup: "live_web_query_result by HMAC(query)\n(no intent class in the key);\nevery hit still in the catalog?" {class: decision}
fresh: "Fetched less than 24 h ago\n(time-bound) or 48 h (general)?" {class: decision}
served: "SUCCEEDED, served CACHE\nno live call, no quota used" {class: end}
asked: "This action already took\nits web search?" {class: decision}
quota: "Redis Lua, one step:\nown counter < 3 (every visitor,\nby client address) and global\ncounter < cap (none if unset)?\n→ both +1" {class: decision}
down: "Redis down or\nredis circuit open" {class: fail}
gcheck: "Global counter < cap?\n(H2_LIVE_WEB_DAILY_CREDITS;\nnone if unset) → +1" {class: decision}
skip: "SKIPPED: DAILY_LIMIT or\nQUOTA_UNAVAILABLE" {class: fail}
stale: "Stored set younger\nthan 7 days?" {class: decision}
stalehit: "served STALE_CACHE" {class: end}
nothing: "served NONE; the other\nsources still answer" {class: fail}
live: "source-live-web policy → live call\nhelper2.live-web.credits{feature} +1" {class: ext}
ok: "SUCCEEDED, LIVE: replace the\nstored set (one row per query, upsert);\nhits go to the catalog\nin the background" {class: end}
failed: "FAILED / TIMED_OUT / RATE_LIMITED\nthe call left: the global\ncounter keeps its credit" {class: fail}
refused: "SKIPPED: CIRCUIT_OPEN or BUSY\nthe call never left:\nglobal counter -1 (refund)" {class: fail}
unanswered: "Every live call of this action\nis back and none answered?" {class: decision}
back: "own counter -1 (giveBack);\nthe action takes its web search\nagain at its next live call\n(Redis down: it stays taken\nand the action keeps it)" {class: data}
reply: "Response: webSearches\n{limit, remaining} for this\nasker and feature" {class: end}
credits: "GET /api/v1/sources:\nwebCredits {usedToday, dailyCap}\nfrom the global counter, no count" {class: data}
ttl: "Guide answer cached for\nmin(24 h, freshness left of the\nweb results it used); none if stale" {class: data}

req -> intent
intent -> lookup
lookup -> fresh: found
lookup -> asked: "no / incomplete"
fresh -> served: yes {class: hot}
fresh -> asked: no
asked -> gcheck: "yes (allowed)"
asked -> skip: "yes (refused)"
asked -> quota: no
gcheck -> live: yes
gcheck -> skip: no
gcheck -> down: error
quota -> live: yes {class: hot}
quota -> skip: no
quota -> down: error
down -> skip: "fail closed"
skip -> stale
stale -> stalehit: yes
stale -> nothing: no
live -> ok: answer {class: hot}
live -> failed: error
live -> refused: "policy refuses"
refused -> unanswered
failed -> unanswered
unanswered -> back: yes
unanswered -> stale: no
back -> stale
served -> reply
ok -> reply: {class: hot}
stalehit -> reply
nothing -> reply
reply -> ttl: guide only
gcheck -> credits: "read by"
