# Flowchart: the reason check that runs after GuideValidator, and the verdict each kept pick gets.
# Source of truth: backend/apps/public/src/main/kotlin/ai/helper2/guide/steps/ReasonCheckStep.kt (verdicts), guide/Guide.kt (ReasonCheck, GuideValidator.namesUnstatedSecret), guide/HostileText.kt (SecretWords), guide/GuideCost.kt (GuideAnswerCache.isCacheable),
#   backend/apps/public/src/main/java/ai/helper2/guide/internal/SpringAiGuideModel.java (verifyReasons),
#   backend/apps/public/src/main/resources/prompts/guide/verify-reasons.txt, security.txt.
# Render: cd docs/diagrams && d2 fmt flow-0031-guide-reason-check.d2 && d2 flow-0031-guide-reason-check.d2 flow-0031-guide-reason-check.svg

...@style

direction: down

kept: "Picks kept by\nGuideValidator" {class: app}
anyKept: "At least one\nkept pick?" {class: decision}
skip: "No reason check,\nno checked event\n(answer is PARTIAL)" {class: end}
claims: "One ReasonClaim per pick:\nreason, quote, candidate text,\nCONFIRMED constraint checks" {class: app}
budget: "Guide daily budget\nhas a unit?" {class: decision}
call: "verifyReasons: reasoning model,\nthinking off, 4096 max tokens,\nJSON schema" {class: ai}
callOk: "Call ok and\nJSON readable?" {class: decision}
secretOnly: "Reason names a secret\nits evidence does not?\n(code, SecretWords)" {class: decision}
allNot: "NOT_CHECKED\n(no pick removed)" {class: fail}
fits: "fitsNeed false?" {class: decision}
offNeed: "Pick dropped\n(OFF_NEED, trail\nOFF_NEED)" {class: fail}
secret: "Reason names a secret\n(password, key, token, card,\nlogin) its evidence does not?\n(code, SecretWords)" {class: decision}
verdict: "claimsSupported\nfor this key?" {class: decision}
supported: "SUPPORTED:\nreason shown" {class: end}
removed: "REMOVED: reason blanked,\npick and quote stay" {class: end}
notChecked: "NOT_CHECKED (also when the\nquestion ran out of time):\nUI says it was not checked" {class: fail}
event: "event: checked\n(supported, removed, notChecked)" {class: config}
cache: "Answer cached only when\nno AI pick is NOT_CHECKED" {class: data}

kept -> anyKept
anyKept -> skip: no
anyKept -> claims: yes {class: hot}
claims -> budget
budget -> secretOnly: "no (GuideBudgetExhausted)"
budget -> call: yes {class: ai-call}
call -> callOk
callOk -> secretOnly: no
callOk -> fits: yes {class: hot}
fits -> offNeed: "yes (picks only)"
fits -> secret: no
secret -> removed: yes
secret -> verdict: no
offNeed -> event
verdict -> supported: "true"
verdict -> removed: "false"
verdict -> notChecked: "missing or unknown key"
supported -> event
removed -> event
notChecked -> event
secretOnly -> removed: yes
secretOnly -> allNot: no
allNot -> event
event -> cache
