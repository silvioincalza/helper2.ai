# Flowchart: GET /resources/{id}/setup and POST /resources/{id}/guide, from the resource to snippets or checked steps.
# Shows the registry-first choice, the README fallback (also when the registry is down), the document cache and
# hourly fetch budget, the model's daily cap and the Redis answer cache.
# Source of truth: backend/src/main/java/ai/helper2/setup/usecase/GetResourceSetup.java, AskAboutResource.java,
#   backend/src/main/kotlin/ai/helper2/setup/SetupGuides.kt, ToolGuides.kt, ToolGuideValidator.kt,
#   backend/src/main/java/ai/helper2/setup/internal/RegistryMcpServerSpecs.java, HttpToolMaterials.java,
#   HourlyFetchBudget.java, RedisToolGuideCache.java, SpringAiToolGuideModel.java.
# Render: cd docs/diagrams && d2 fmt flow-0031-setup-guide.d2 && d2 flow-0031-setup-guide.d2 flow-0031-setup-guide.svg

...@style

direction: down

setup: GET /setup (GetResourceSetup) {
  class: group
  direction: down
  found: "Resource in the catalog?" {class: decision}
  notFound: "404" {class: fail}
  hasName: "MCP Registry record?" {class: decision}
  cached: "Registry answer cached\n(H2_SETUP_CACHE_TTL, 500 names)?" {class: decision}
  read: "Registry answered?" {class: decision}
  usable: "Entry has an option\nRunOptionRules accepts?" {class: decision}
  readme: "MCP server with a README\nconfig example (point 8)?" {class: decision}
  down: "Registry was down?" {class: decision}
  unavailable: "503" {class: fail}
  none: "Empty guide:\npage offers the steps" {class: end}
  snippets: "Options + one snippet\nper client (19)" {class: end}

  found -> notFound: no
  found -> hasName: yes {class: hot}
  hasName -> readme: no
  hasName -> cached: yes {class: hot}
  cached -> usable: yes
  cached -> read: no
  read -> usable: "yes (a missing entry too)"
  read -> readme: "no (kept as down)"
  usable -> snippets: yes {class: hot}
  usable -> readme: no
  readme -> snippets: yes
  readme -> down: no
  down -> unavailable: yes
  down -> none: no
}

docs: Documents (HttpToolMaterials) {
  class: group
  direction: down
  inCache: "Documents cached?\n(TTL, 32 MB of text)" {class: decision}
  budget: "Hourly fetch unit left?\n(H2_SETUP_HOURLY_FETCHES, Redis)" {class: decision}
  fetch: "GitHub README, else npm README;\nHugging Face card (512 KB cap)" {class: ext}
  refused: "Skipped, answer not cached;\nfetches.refused + 1" {class: fail}
  keep: "Cache the documents" {class: data}

  inCache -> budget: no
  budget -> fetch: yes {class: hot}
  budget -> refused: no
  fetch -> keep
}

guide: POST /guide (AskAboutResource) {
  class: group
  direction: down
  material: "Any document?" {class: decision}
  noMaterial: "NO_MATERIAL" {class: fail}
  model: "Model configured?" {class: decision}
  redis: "Answer in Redis\n(resource, documents,\nquestion, prompt)?" {class: decision}
  cap: "Tool guide daily\nunit left? (300)" {class: decision}
  call: "Fast model picks passages\n(one retry on a bad answer)" {class: ai}
  unavailable: "LLM_UNAVAILABLE\n(budget or error)" {class: fail}
  validate: "ToolGuideValidator: quotes and\ncommands copied exactly" {class: app}
  store: "Store the checked steps,\nwithout question or text (7 days)" {class: data}
  answer: "OK or NO_STEPS" {class: end}

  material -> noMaterial: no
  material -> model: yes {class: hot}
  model -> unavailable: no
  model -> redis: yes
  redis -> answer: yes
  redis -> cap: "no (or entry unreadable)"
  cap -> unavailable: no
  cap -> call: yes {class: ai-call}
  call -> unavailable: "provider error\nor two bad answers"
  call -> validate: answer {class: hot}
  validate -> store
  store -> answer
}

setup.readme -> docs.inCache: "reads the README"
guide.material -> docs.inCache: "reads the documents"
