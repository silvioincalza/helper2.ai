# Flowchart: the supply-chain checks in CI (ADR 0033): an SBOM and a Grype scan per image, report-only until 18 Nov 2026.
# Source of truth: .github/workflows/cd.yml (image, scan), release.yml (sbom), image-scan.yml,
#   .github/actions/install-scanners, grype-db, upload-sarif, deploy/k8s/Makefile (sbom, postgres-sbom), .grype.yaml.
# Pull requests build no image (ci.yml): every image is built, pushed and scanned on main.
# Render: cd docs/diagrams && d2 fmt flow-0033-supply-chain.d2 && d2 flow-0033-supply-chain.d2 flow-0033-supply-chain.svg

...@style

direction: down

push: "Push to main (cd.yml)" {class: end}
tag: "Release tag vX.Y.Z (release.yml)" {class: end}
weekly: "Monday (image-scan.yml)" {class: end}

install: "install-scanners: Syft tarball (SHA-256),\nGrype go install (Go checksum database)" {class: app}
db: "grype-db: today's database\n(cache; one retry)" {class: app}

scanjob: "cd.yml scan job (GitHub-hosted):\ndownloads this run's SBOMs" {class: app}
grype: "grype sbom:<file> --only-fixed\n(.grype.yaml exceptions)" {class: app}
report: "Job log + code scanning (SARIF,\nimage/app, image/postgres)" {class: data}
gate: "Critical with a fix?" {class: decision}
pass: "Staging deploy goes on\n(report-only until 18 Nov 2026)" {class: end}

pushed: "make image: pushed to Harbor" {class: app}
sbomcd: "make sbom, make postgres-sbom:\nSyft reads the pushed images from Harbor" {class: app}
artifact: "Artifacts sbom, sbom-postgres,\n90 days" {class: data}

staged: "The commit's CD run passed staging" {class: app}
attach: "helper2-vX.Y.Z.cdx.json\nattached to the GitHub release" {class: data}

latest: "SBOM of the latest release" {class: app}
fresh: "Fresh database (no cache)" {class: app}
weeklyreport: "Job summary + code scanning\n(release/app, on the tag)" {class: data}

artifact -> scanjob: {class: hot}
scanjob -> install -> db -> grype -> report -> gate
gate -> pass: "report-only: yes or no"

push -> pushed -> sbomcd -> artifact: {class: hot}
tag -> staged -> attach
artifact -> attach: "download from that run"

weekly -> latest
attach -> latest: "release asset"
latest -> fresh -> weeklyreport
