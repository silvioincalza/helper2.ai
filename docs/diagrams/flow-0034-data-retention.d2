# Flowchart: the daily purges, one per owning module, and the rules of each in code order. Each rule deletes the
# parent row; foreign keys cascade to its children or set links to NULL. Periods are helper2.retention.* (H2_RETENTION_*).
# Source of truth: backend/src/main/java/ai/helper2/catalog/usecase/PurgeExpiredData.java, catalog/internal/CatalogRetention.java,
#   catalog/CatalogRetentionSchedule.java, backend/src/main/kotlin/ai/helper2/scout/usecase/PurgeExpiredData.kt,
#   scout/internal/ScoutRetentionSchedule.java, JdbcScoutStore.java, identity/usecase/PurgeExpiredData.java,
#   identity/IdentityRetentionSchedule.java, identity/internal/Users.java, AuditLog.java,
#   backend/src/main/kotlin/ai/helper2/search/usecase/PurgeExpiredData.kt, search/config/SearchRetentionSchedule.java,
#   search/internal/JdbcWebResultStore.java, backend/src/main/kotlin/ai/helper2/guide/usecase/PurgeExpiredData.kt,
#   guide/internal/GuideRetentionSchedule.java, guide/internal/JdbcGuideAnswerStore.java, db/migration/V1__schema.sql.
# Render: cd docs/diagrams && d2 fmt flow-0034-data-retention.d2 && d2 flow-0034-data-retention.d2 flow-0034-data-retention.svg

...@style

direction: down

cron: "@Scheduled helper2.retention.cron\n(default 0 17 3 * * *, UTC),\non every replica" {class: end}
lock: "ClusterLocks.keptAlive: this module's\nlock free? (retention-catalog,\nretention-scout, retention-identity,\nretention-search, retention-guide)" {class: decision}
skip: "Another replica purges today" {class: end}

catalog: "catalog.usecase.PurgeExpiredData (in this order)" {
  class: group
  direction: down
  rev: "review_item resolved > 180 d,\nnot tied to a report" {class: data}
  rep: "issue_report whose review items\nall resolved > 365 d (with them)" {class: data}
  runs: "enrichment_run > 90 d, not the latest\nof its resource, cited by nothing" {class: data}
  news: "tavily / tavily-scout NEWS, ARTICLE\nrecords > 180 d; then resources\nleft without a record" {class: data}
  events: "EVENT resources ended\n(or started) > 365 d ago" {class: data}
  observed: "OBSERVED resources unseen > 180 d,\nnot linked from a stronger origin" {class: data}
  ref: "Every resource rule: no issue report\nand no review item points at it?" {class: decision}
  later: "Kept: goes in a later\npurge, after its report\nor review item" {class: end}
  rev -> rep -> runs -> news -> events -> observed
  observed -> ref
}

scout: "scout purge" {
  class: group
  direction: down
  sruns: "scout.usecase.PurgeExpiredData:\nscout_run started > 90 d\n(RUNNING stays)" {class: data}
}

identity: "identity purge" {
  class: group
  direction: down
  users: "identity.usecase.PurgeExpiredData:\napp_user last sign-in > 730 d\n(bookmarks cascade, reports keep\nreporter NULL)" {class: data}
  audit: "admin_audit at > 730 d" {class: data}
  users -> audit
}

search: "search purge" {
  class: group
  direction: down
  sets: "search.usecase.PurgeExpiredData:\ntavily_query_result fetched > 7 d" {class: data}
}

guide: "guide purge" {
  class: group
  direction: down
  answers: "guide.usecase.PurgeExpiredData:\nguide_similar_question and guide_answer\npast expires_at (indexed questions\ncascade with their answer)" {class: data}
}

cascade: "ON DELETE CASCADE: records, labels, embeddings,\nevidence, assertions, claims of a resource;\nON DELETE SET NULL: links that outlive their target;\nNO ACTION: a run a current row cites stays" {class: data}
logged: "Each logs what it deleted;\na failure is logged, the next\nday's run catches up" {class: end}

cron -> lock: {class: hot}
lock -> skip: no
lock -> catalog.rev: "yes (catalog)" {class: hot}
lock -> scout.sruns: "yes (scout)"
lock -> identity.users: "yes (identity)"
lock -> search.sets: "yes (search)"
lock -> guide.answers: "yes (guide)"
catalog.ref -> cascade: "yes: deleted" {class: hot}
catalog.ref -> catalog.later: no
scout.sruns -> logged
identity.audit -> logged
search.sets -> logged
guide.answers -> logged
cascade -> logged
