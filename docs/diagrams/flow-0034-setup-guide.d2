# Flowchart: the two answers of a resource page's "Set it up": the setup options and client snippets from source data
# (no model), and the step-by-step guide the model writes from the tool's own documents, checked against them.
# Source of truth: backend/apps/public/src/main/java/ai/helper2/setup/usecase/GetResourceSetup.java, GetToolGuide.java,
#   backend/apps/public/src/main/kotlin/ai/helper2/setup/SetupGuides.kt, RunOptionRules.kt, Launch.kt, Clients.kt, ToolGuides.kt,
#   ToolGuideValidator.kt, backend/apps/public/src/main/java/ai/helper2/setup/internal/RegistryMcpServerSpecs.java,
#   ReadmeMcpConfigs.java, HttpToolMaterials.java, HourlyFetchBudget.java, SpringAiToolGuideModel.java,
#   backend/apps/public/src/main/resources/prompts/setup/tool-guide.txt, setup/web/SetupController.java (aiContent),
#   prompts/setup/verify-steps.txt, setup/StepTexts.kt, StepTextMode.kt (step check or source only),
#   SharedToolGuideCache.java, platform/cache/JdbcSharedCache.java, platform/RateLimitInterceptor.java,
#   platform/quota/ClientBudgets.java, kernel shared/SingleFlight.kt, shared/LinkText.kt (step text links).
# Render: cd docs/diagrams && d2 fmt flow-0034-setup-guide.d2 && d2 flow-0034-setup-guide.d2 flow-0034-setup-guide.svg

...@style

direction: down

setup: "GET /api/v1/resources/{id}/setup (limiter setup, GetResourceSetup)" {
  class: group
  direction: down
  reg: "Source record from\nmcp-registry?" {class: decision}
  latest: "RegistryMcpServerSpecs.latest(name):\nin memory H2_SETUP_CACHE_TTL (1 h), else\nGET /v0.1/servers/{name}/versions/latest" {class: ext}
  usable: "Entry found with an option\nRunOptionRules.accepts?" {class: decision}
  mcp: "MCP_SERVER with a GitHub repo\nor npm package?" {class: decision}
  readme: "ReadmeMcpConfigs.of(ref):\nREADME config example,\nonly the entry naming this resource" {class: ext}
  down: "Registry was down?" {class: decision}
  none: "SetupGuide.none:\nno setup data, no invention" {class: end}
  shown: "Keep options RunOptionRules accepts;\nRemote, or stdio package / command\nwith a known launcher (Launches.of)" {class: app}
  snippets: "Clients.ALL (8): one snippet per client\nand option, secrets as <placeholder>,\nor \"not configurable here\"" {class: app}
  answer: "200 SetupGuide\n(sources with read time)" {class: end}
  e503: "503 SetupUnavailable\n(registry down, no README example;\nnot cached)" {class: fail}

  reg -> latest: yes {class: hot}
  reg -> mcp: no
  latest -> usable
  latest -> mcp: "error"
  usable -> shown: yes {class: hot}
  usable -> mcp: no
  mcp -> readme: yes
  mcp -> down: no
  readme -> shown: "example found"
  readme -> down: "nothing usable"
  down -> e503: yes
  down -> none: no
  shown -> snippets -> answer
}

guide: "POST /api/v1/resources/{id}/guide (limiter guide, GetToolGuide)" {
  class: group
  direction: down
  docs: "ToolMaterials.load(ref): GitHub (own token\nH2_SETUP_GITHUB_TOKEN, else anonymous),\njsDelivr, Hugging Face documents\nfrom checked identifiers" {class: ext}
  docCache: "Documents in memory?\n(H2_SETUP_CACHE_TTL,\nH2_SETUP_DOCUMENT_CACHE_MB)" {class: decision}
  budget: "Hourly fetch unit left?\n(H2_SETUP_HOURLY_FETCHES,\ncounted in Redis)" {class: decision}
  skipped: "Document skipped;\nanswer not cached" {class: fail}
  hasDocs: "Any document?" {class: decision}
  noMat: "NO_MATERIAL" {class: end}
  cached: "Readable tool-guide answer\nin ai_cache (resource, documents,\nprompt hash, step text mode;\n7 days, or 10 min for an\nunreadable model answer)?" {class: decision}
  hit: "Cached answer" {class: end}
  write: "ToolGuideModel.write: tool name and\ndocuments in escaped tags, data only;\nan instruction per step, with its\npassage and command (fast model,\ntool-guide daily budget)" {class: ai}
  unav: "LLM_UNAVAILABLE, not cached\n(no model, budget spent, provider\nerror or open llm-chat circuit);\nbudget: retryAt = next 00:00 UTC" {class: fail}
  unreadable: "LLM_UNAVAILABLE \"error\", cached\nH2_SETUP_UNREADABLE_TTL (10 min)" {class: fail}
  check: "ToolGuideValidator: a found quote\n(30 chars and 5 words, or a whole line)\nfor every step; whole command lines;\nno link; risky commands marked caution;\n≤ 8 per section" {class: app}
  verify: "ToolGuideModel.confirm: one call,\nevery kept step's text, quote and\ncommand in escaped tags; supported\nonly when the text says no more\n(same budget)" {class: ai}
  confirmed: "StepTexts: verdict true\nfor this step, none false?" {class: decision}
  textShown: "Step text kept, marked\nas AI in aiContent" {class: app}
  sourceOnly: "Text set to null, not stored:\nquote and command only,\n\"From the source\", not marked" {class: app}
  ok: "OK, cached; aiContent names\nthe model and the shown step texts\n(none shown: no marker)" {class: end}
  nosteps: "NO_STEPS, cached" {class: end}
  notChecked: "OK, not cached: every step\n\"From the source\", no marker;\nthe next visit writes and\nchecks again" {class: end}

  docCache -> hasDocs: yes
  docCache -> budget: no
  budget -> docs: yes {class: hot}
  budget -> skipped: no
  skipped -> hasDocs
  docs -> hasDocs
  hasDocs -> noMat: no
  hasDocs -> cached: yes {class: hot}
  cached -> hit: yes
  cached -> turn: no {class: hot}
  turn: "Network (200) and visitor (20)\nhave a new guide left today,\nthe same guide not being written,\na setup-guide slot free (2)?" {class: decision}
  refusedTurn: "LLM_UNAVAILABLE \"quota\" (retryAt =\nnext 00:00 UTC) or \"busy\",\nnot cached; an identical guide in\nprogress is waited for and shared" {class: fail}
  turn -> refusedTurn: no
  turn -> write: yes {class: hot}
  write -> unav: "fails"
  write -> unreadable: "two answers\nnot the requested JSON"
  write -> check: {class: ai-call}
  check -> anyKept
  anyKept -> mode: yes
  mode: "H2_SETUP_GUIDE_STEP_TEXT\n(StepTextMode)?" {class: decision}
  allSource: "StepTexts.sourceOnly: every text\nnull, no second call (one model\ncall a guide); every step\n\"From the source\", not marked" {class: app}
  mode -> verify: "VERIFIED (default)" {class: ai-call}
  mode -> allSource: "SOURCE_ONLY"
  allSource -> ok
  verify -> confirmed
  verify -> notChecked: "the check could not run\n(budget, provider, circuit,\ntwo unreadable answers)"
  confirmed -> textShown: yes
  confirmed -> sourceOnly: no
  textShown -> ok: {class: hot}
  sourceOnly -> ok
  anyKept -> nosteps: no

  anyKept: "Any step kept?" {class: decision}
}
