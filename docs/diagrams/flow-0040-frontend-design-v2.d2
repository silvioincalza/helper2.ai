# Flowchart: the design from the home page to the guide picks. An empty / is the home page (hero, News and Events
# boards); a search opens /search, and /?q= names /search as canonical. The list shows at once; the guide runs only
# for a question (4+ words or Shift+Enter): its picks bar is reserved, the answer arrives over SSE (picks or no pick),
# badges stay in place with no re-order, and the selected result is kept in the URL with replace.
# Source of truth: docs/adr/frontend/0040-frontend-design-v2.md; frontend/src/pages/HomePage.tsx, pages/Home.tsx,
#   components/home/HomeBoard.tsx, NewsBoard.tsx, EventsBoard.tsx, routes.tsx, components/OneBox.tsx,
#   components/results/Results.tsx, lib/selection.ts, components/ui/PicksBar.tsx, hooks/useGuideStream.ts.
# Render: cd docs/diagrams && d2 fmt flow-0040-frontend-design-v2.d2 && d2 flow-0040-frontend-design-v2.d2 flow-0040-frontend-design-v2.svg

...@style

direction: down

open: "Open /" {class: app}
empty: "Box empty?\n(no q, no ask)" {class: decision}

home: Home {
  class: group
  direction: down
  hero: "Hero: the one box\nand three examples" {class: app}
  boards: "News and Events boards\n(loop; pause on hover,\nfocus and tap)" {class: app}
  feeds: "GET /api/v1/recent\nGET /api/v1/events/upcoming" {class: ext}
  hero -> boards -> feeds
}

canonical: "/?q=…: the results,\ncanonical link to /search" {class: app}
start: "Search from the box or an example:\n/search?q=…" {class: app}
results: "GET /api/v1/search" {class: ext}
show: "Show the list at once" {class: app}
question: "A question?\n(4+ words or Shift+Enter)" {class: decision}
nobar: "No picks bar,\nno model call" {class: end}
reserve: "Reserve the picks bar:\n\"Guide is reading…\"" {class: app}
wide: "Screen wider than 860 px?" {class: decision}
preview: "Preview on the right" {class: app}
inline: "Preview inside the list,\nlink to /resource/:id" {class: app}
guide: "POST /api/v1/guide/stream (SSE)" {class: ext}
picks: "Guide found picks?" {class: decision}

answer: Picks {
  class: group
  direction: down
  bar: "Bar shows #1 #2 #3,\nlabelled AI-written" {class: app}
  badge: "Each pick gets \"Pick #n\"\nand its reason in its row" {class: app}
  still: "List order unchanged" {class: end}
  bar -> badge -> still
}

none: "Bar shrinks to one line;\nthe full answer opens under it" {class: end}

select: Selecting a result {
  class: group
  direction: down
  tap: "Click a row or a pick chip" {class: app}
  url: "replace ?q=…&id=…\n(no new Back step)" {class: app}
  known: "id in the results?" {class: decision}
  sel: "Select that row" {class: end}
  first: "Select the first row" {class: end}
  tap -> url -> known
  known -> sel: yes
  known -> first: no
}

start -> results -> show
show -> wide
wide -> preview: yes
wide -> inline: no
show -> question
question -> nobar: no
question -> reserve: yes {class: hot}
reserve -> guide: {class: hot}
guide -> picks
picks -> answer.bar: yes {class: hot}
picks -> none: no
show -> select.tap

open -> empty
empty -> home.hero: yes {class: hot}
empty -> canonical: no
canonical -> results
home.hero -> start: "Enter or an example" {class: hot}
