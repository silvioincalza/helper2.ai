# Flowchart: the design from the home page to the guide picks. An empty / is the home page (headline, box, News and Events
# boards); a search opens /search, and /?q= shows the same results. Both say noindex, follow to search engines. The
# list shows at once; the guide runs only when asked (Shift+Enter or the button; Enter searches): its picks bar is
# reserved, the answer arrives over SSE (picks or no pick),
# the picks move to the top of the list in one update and the preview opens on pick #1 unless the URL names a result;
# with no pick the bar offers the next steps. The selected result is kept in the URL with replace. Each row title is a
# link to /resource/:id: on a wide screen a plain click selects, a click with a modifier key opens the link; on a phone
# nothing is selected on load and a row opens the resource page.
# Source of truth: docs/adr/frontend/0040-frontend-design.md; frontend/src/pages/HomePage.tsx, pages/Home.tsx,
#   components/home/HomeBoard.tsx, NewsBoard.tsx, EventsBoard.tsx, routes.tsx, components/OneBox.tsx,
#   components/results/Results.tsx, lib/selection.ts, components/ui/PicksBar.tsx, components/ui/SelectableRow.tsx,
#   hooks/useGuideStream.ts.
# Render: cd docs/diagrams && d2 fmt flow-0040-frontend-design.d2 && d2 flow-0040-frontend-design.d2 flow-0040-frontend-design.svg

...@style

direction: down

open: "Open /" {class: app}
empty: "Box empty?\n(no q, no ask)" {class: decision}

home: Home {
  class: group
  direction: down
  hero: "Headline, the one box,\nfour examples" {class: app}
  boards: "New this week and Coming up\n(still; six rows, Show all),\nthen what helper2 does" {class: app}
  feeds: "GET /api/v1/recent\nGET /api/v1/events/upcoming" {class: ext}
  hero -> boards -> feeds
}

canonical: "/?q=…: the results;\nboth result pages noindex, follow" {class: app}
start: "Search from the box or an example:\n/search?q=…" {class: app}
results: "GET /api/v1/search" {class: ext}
show: "Show the list at once" {class: app}
question: "Asked the guide?\n(Shift+Enter or its button;\nEnter searches)" {class: decision}
nobar: "No picks bar,\nno model call" {class: end}
reserve: "Reserve the picks bar:\n\"Guide is reading…\"" {class: app}
wide: "Screen wider than 860 px?" {class: decision}
preview: "Preview on the right" {class: app}
inline: "Nothing selected on load;\na row opens /resource/:id" {class: app}
guide: "POST /api/v1/guide/stream (SSE)" {class: ext}
picks: "Guide found picks?" {class: decision}

answer: Picks {
  class: group
  direction: down
  bar: "Bar shows #1 #2 #3,\nlabelled AI-written" {class: app}
  moved: "Picks move to a \"Guide picks\" group\nat the top, in the guide's order;\nthe rest follow in search order" {class: app}
  onpick: "Preview opens on pick #1\n(an id in the URL wins)" {class: end}
  bar -> moved -> onpick
}

none: "Bar: one line that says why,\n\"Ask without …\" per requirement,\n\"Rephrase\"; list order unchanged" {class: end}

select: Selecting a result {
  class: group
  direction: down
  tap: "Click a row title (wide screen)\nor a pick chip" {class: app}
  newtab: "Ctrl, cmd, shift or middle click:\n/resource/:id opens as a link" {class: end}
  url: "replace ?q=…&id=…\n(no new Back step)" {class: app}
  known: "id in the results?" {class: decision}
  sel: "Select that row" {class: end}
  first: "Select pick #1,\nelse the first row" {class: end}
  tap -> url -> known
  tap -> newtab: "modifier key"
  known -> sel: yes
  known -> first: no
}

start -> results -> show
show -> wide
wide -> preview: yes
wide -> inline: no
show -> question
question -> nobar: no
question -> reserve: yes {class: hot}
reserve -> guide: {class: hot}
guide -> picks
picks -> answer.bar: yes {class: hot}
picks -> none: no
show -> select.tap

open -> empty
empty -> home.hero: yes {class: hot}
empty -> canonical: no
canonical -> results
home.hero -> start: "Enter or an example" {class: hot}
