# Flowchart: what a public page loads for Google AdSense and the consent tool (ADR 0042).
# Source of truth: backend/apps/public/src/main/java/ai/helper2/site/monetisation/Monetisation.java,
#   site/csp/ContentSecurityPolicy.java, CspHeaderWriter.java, CspNonce.java, site/pages/internal/PageHtml.java,
#   site/pages/web/CrawlerFiles.java, frontend/src/lib/googleConsent.ts, features/monetisation/AnalyticsConsent.tsx,
#   features/monetisation/AdSenseSlot.tsx, shell/Layout.tsx (Privacy choices).
# Render: cd docs/diagrams && d2 fmt flow-0042-adsense.d2 && d2 flow-0042-adsense.d2 flow-0042-adsense.svg

...@style

direction: down

req: "A public request" {class: end}
pub: "Publisher set?" {class: decision}
plain: "As before:\nno tag, /ads.txt 404" {class: data}
check: "Site check tag on every page,\n/ads.txt names Google" {class: hot}
unit: "Ad unit set too?" {class: decision}
strict: "CSP of ADR 0042,\nour own analytics bar" {class: data}
nonce: "Nonce CSP for the whole public site" {class: hot}
tool: "Resource page, or Privacy choices\npressed, in this page load?" {class: decision}
unknown: "Consent tool not loaded:\nno decision known, no analytics" {class: data}
fc: "Load Google's consent tool once\n(never on an address with q or ask);\nit stays for the visit" {class: hot}

ga: {
  class: group
  direction: down
  applies: "gdprApplies?" {class: decision}
  yes: "Purposes 1 + 8 and\nvendor 755 consented?" {class: decision}
  mode: "Consent mode:\nanalytics storage?" {class: decision}
  wait: "Wait for\nCONSENT_MODE_DATA_READY" {class: data}
  load: "Load Google Analytics" {class: hot}
  off: "ga-disable, delete _ga cookies" {class: data}
  applies -> load: no
  applies -> yes: yes
  yes -> mode: yes
  yes -> off: no
  mode -> load: "1 granted,\n3 not applicable"
  mode -> off: "2 denied,\n4 not configured"
  mode -> wait: "0 or no data yet"
  wait -> mode: "read again"
}
blocked: "Tool blocked: no analytics" {class: fail}

page: "Resource page?" {class: decision}
slot: "One AdSense box, Sponsored" {class: hot}
noslot: "No AdSense on this page" {class: data}

req -> pub
pub -> plain: no
pub -> check: yes
check -> unit
unit -> strict: no
unit -> nonce: yes
nonce -> tool
tool -> unknown: no
tool -> fc: yes
fc -> ga.applies: "TCF answer"
fc -> blocked: "no TCF API"
nonce -> page
page -> slot: yes
page -> noslot: no
