# Flowchart: what a public page loads for monetisation (ADR 0042).
# Source of truth: backend/apps/public/src/main/java/ai/helper2/site/monetisation/config/MonetisationConfiguration.java,
#   site/monetisation/web/SiteController.java, frontend/src/context/MonetisationContext.tsx,
#   site/csp/ContentSecurityPolicy.java, frontend/src/features/monetisation/AnalyticsConsent.tsx,
#   features/monetisation/SponsorSlot.tsx, features/search/Results.tsx, lib/analytics.ts.
# Render: cd docs/diagrams && d2 fmt flow-0042-monetisation.d2 && d2 flow-0042-monetisation.d2 flow-0042-monetisation.svg

...@style

direction: down

page: "A page opens\n(GET /api/v1/site: monetisation;\nall off until it answers)" {class: end}

admin: "Back office app\n(admin host, ADR 0043)?" {class: decision}
strict: "Strict CSP, nothing loads" {class: end}

ga: {
  class: group
  direction: down
  on: "GA4 ID set?" {class: decision}
  answered: "Answer in h2.consent?" {class: decision}
  ask: "Bar: Reject | Accept\n(search works meanwhile)" {class: app}
  yes: "Accepted?" {class: decision}
  load: "Load gtag: no auto page view,\nsignals and ad personalisation off" {class: hot}
  view: "page_view per route:\norigin + path, fixed page name" {class: hot}
  none: "Nothing sent;\n_ga cookies deleted" {class: data}
  on -> answered: yes
  answered -> yes: yes
  answered -> ask: no
  ask -> yes
  yes -> load: yes
  yes -> none: no
  load -> view
}
nothing: "No analytics" {class: data}

ads: {
  class: group
  direction: down
  set: "EthicalAds ID set?" {class: decision}
  search: "Search page with a query,\nno guide question?" {class: decision}
  slot: "One slot above the results:\nSponsored + why" {class: app}
  loading: "Search running?" {class: decision}
  bar: "Progress bar (6 s);\nresults replace it at once" {class: app}
  first: "First results\nfor these words (q)?" {class: decision}
  ad: "Empty the box,\nethicalads.load(): one ad per search" {class: hot}
  keep: "Keep the ad\n(filter, sort, timeline, Show more)" {class: data}
  set -> search: yes
  search -> slot: yes
  slot -> loading
  loading -> bar: yes
  loading -> first: no
  bar -> first: "results come"
  bar -> noad: "search fails, or\nthe words change first"
  first -> ad: yes
  first -> keep: no
}
noad: "No ad" {class: data}

page -> admin
admin -> strict: yes
admin -> ga.on: no
admin -> ads.set: no
ga.on -> nothing: no
ads.set -> noad: no
ads.search -> noad: no
