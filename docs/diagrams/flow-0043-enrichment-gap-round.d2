# Flowchart: the gap round inside EnrichResource.attempt, after the first run is validated: a model card.
# A GitHub README is read before the first run instead (README first, ADR 0056).
# Shows when it runs, where the extra text comes from, the cleaning, the budget, and which run is saved.
# Source of truth: backend/src/main/kotlin/ai/helper2/scout/usecase/EnrichResource.kt (climb, modelCard),
#   backend/src/main/kotlin/ai/helper2/scout/GapRound.kt (GapTargets.select, UntrustedPageText),
#   backend/src/main/java/ai/helper2/sources/evidence/ReadmeEvidence.java,
#   backend/src/main/java/ai/helper2/scout/internal/ScoutConfiguration.java (gapBudget).
# Render: cd docs/diagrams && d2 fmt flow-0043-enrichment-gap-round.d2 && d2 flow-0043-enrichment-gap-round.d2 flow-0043-enrichment-gap-round.svg

...@style

direction: down

first: "First run validated\n(source records; a GitHub README\nis in it already, ADR 0056)" {class: app}
weak: "Outcome PARTIAL\nor REJECTED?" {class: decision}
target: "A record names its own model?\n(hf-models, hf-trending,\nhf-provider-orgs)" {class: decision}
fetch: "Read the model card\n(+ card licence)" {class: app}
gotText: "Text after cleaning?\n(no comments, tags, link targets,\nhidden characters, emails)" {class: decision}
budget: "Gap budget left?\n(400 a day, inside the 500)" {class: decision}
second: "Second run: records + README + card\n(licence from the card is a fact;\nthe card may not support claims)" {class: ai}
better: "Keeps more accepted\nitems than the first?" {class: decision}
keepFirst: "Save the first run" {class: end}
keepGap: "Save the gap run;\nextra_evidence = hf-model-card:owner/model" {class: end}
fp: "Fingerprint = source records\n(+ GitHub README hash, ADR 0056):\nthe next unchanged run is UNCHANGED" {class: data}

first -> weak
weak -> keepFirst: "no (VALIDATED)"
weak -> target: yes {class: hot}
target -> keepFirst: no
target -> fetch: yes {class: hot}
fetch -> keepFirst: "source failed"
fetch -> gotText
gotText -> keepFirst: "no (404 or empty)"
gotText -> budget: yes {class: hot}
budget -> keepFirst: no
budget -> second: yes {class: ai-call}
second -> keepFirst: "model failed"
second -> better
better -> keepFirst: no
better -> keepGap: yes {class: hot}
keepFirst -> fp
keepGap -> fp
