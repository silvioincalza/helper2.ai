# Flowchart: a pull request to main merges only after Copilot reviewed its head commit (ADR 0044 §22). The ruleset
# asks Copilot to review every push and requires its job copilot-pull-request-reviewer next to ci-ok; every open
# review thread must be resolved.
# Source of truth: .github/settings/ruleset-main.json (copilot_code_review, required checks ci-ok and
#   copilot-pull-request-reviewer, required_review_thread_resolution), docs/recreate.md.
# Render: cd docs/diagrams && d2 fmt flow-0044-copilot-review.d2 && d2 flow-0044-copilot-review.d2 flow-0044-copilot-review.svg

...@style

direction: down

push: "Pull request opened,\nor a new push to it\n(Update branch too)" {class: person}
ask: "Ruleset: Copilot asked\nto review the push" {class: config}
job: "GitHub Actions job\ncopilot-pull-request-reviewer\non the head commit" {class: app}
reviewed: "Review posted,\njob green?" {class: decision}
waits: "Required check not green:\nthe merge button stays off" {class: fail}
fallback: "Owner requests the\nCopilot review again" {class: person}
threads: "Every review thread\nresolved?" {class: decision}
open: "Merge blocked until\nthe threads are resolved" {class: fail}
ci: "ci-ok green and the branch\nup to date with main?" {class: decision}
merge: "Owner merges\n(squash)" {class: end}

push -> ask: {class: hot}
ask -> job: {class: hot}
job -> reviewed
reviewed -> waits: no
waits -> fallback
fallback -> job
reviewed -> threads: yes {class: hot}
threads -> open: no
threads -> ci: yes {class: hot}
ci -> merge: yes {class: hot}
