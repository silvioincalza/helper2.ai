# Flowchart: how one guide answer gets its research trail: which queries are listed, which removed suggestions,
# and what a reused answer keeps.
# Source of truth: backend/src/main/kotlin/ai/helper2/guide/usecase/Question.kt (Question.ran, GuideSteps.find),
#   backend/src/main/kotlin/ai/helper2/guide/usecase/PickAnswer.kt (picks, insideWindow),
#   backend/src/main/kotlin/ai/helper2/guide/usecase/AskGuide.kt (answerByIntent, similarAnswer),
#   backend/src/main/kotlin/ai/helper2/guide/Guide.kt (ResearchTrail, GuideValidator.Rejection.trailCheck, removedOf),
#   backend/src/main/java/ai/helper2/guide/web/GuideDtoMapper.java (trail, AI_WRITTEN_FIELDS),
#   frontend/src/components/guide/GuideAnswer.tsx (PlannedQueries, RemovedList).
# Render: cd docs/diagrams && d2 fmt flow-0044-research-trail.d2 && d2 flow-0044-research-trail.d2 flow-0044-research-trail.svg

...@style

direction: down

search: "A search of the question\n(GuideSteps.find)" {class: app}
plannedText: "Its text is the planner's query\n(or cut from it)?" {class: decision}
recordText: "Record the query" {class: app}
webRead: "Planned web query sent, and a\nsource that reads it not skipped?" {class: decision}
recordWeb: "Record the web query" {class: app}
validate: "Validator, then the window check" {class: app}
rejected: "Rejected suggestion names\na real candidate?" {class: decision}
mapped: "Rejection is a failed check?\nquote → QUOTE_NOT_FOUND\nreason → REASON_NOT_SUPPORTED\nkind, period → CONSTRAINT_NOT_MET" {class: decision}
keptLater: "Same candidate kept\nas a pick?" {class: decision}
removed: "Removed item:\nsource title + code\n(never the model's reason)" {class: data}
skip: "Not listed" {class: end}
planRan: "Planner ran and did not fail?" {class: decision}
cap: "ResearchTrail.of: trimmed, no repeats,\n≤ 3 queries of ≤ 200 chars,\n≤ 12 removed of ≤ 200 chars" {class: app}
noQueries: "queries = []" {class: app}
reused: "Answer reused from a\nsimilar question (ADR 0041)?" {class: decision}
strip: "withoutQueries():\nanother asker's words" {class: app}
dto: "GuideResponse.trail\ntrail.queries[] in AI_WRITTEN_FIELDS" {class: end}
page: "Folded 'How the guide decided':\nqueries AI-marked and labelled;\n'title: check' lines or 'None removed'" {class: person}

search -> plannedText
plannedText -> recordText: yes {class: hot}
plannedText -> webRead: no
recordText -> webRead
webRead -> recordWeb: yes
webRead -> planRan: no
recordWeb -> planRan

validate -> rejected
rejected -> skip: no
rejected -> mapped: yes {class: hot}
mapped -> skip: no
mapped -> keptLater: yes {class: hot}
keptLater -> skip: yes
keptLater -> removed: no {class: hot}
removed -> cap

planRan -> cap: yes {class: hot}
planRan -> noQueries: no
noQueries -> cap
cap -> reused
reused -> strip: yes
reused -> dto: no {class: hot}
strip -> dto
dto -> page
