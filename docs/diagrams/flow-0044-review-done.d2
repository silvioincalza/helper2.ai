# Flowchart: a pull request to main merges only after a review of its head commit (ADR 0044 §22). The ruleset asks
# Copilot to review every push; the required check review-done passes when Copilot or the repository owner has
# reviewed the head commit, and every open review thread must be resolved.
# Source of truth: .github/workflows/review.yml, .github/scripts/review-done.sh,
#   .github/settings/ruleset-main.json (copilot_code_review, required checks ci-ok and review-done,
#   required_review_thread_resolution).
# Render: cd docs/diagrams && d2 fmt flow-0044-review-done.d2 && d2 flow-0044-review-done.d2 flow-0044-review-done.svg

...@style

direction: down

push: "Pull request opened,\nor a new push to it\n(Update branch too)" {class: person}
ask: "Ruleset: Copilot asked\nto review the push" {class: config}
check: "review.yml: review-done\n(on the push and on\nevery review posted or dismissed)" {class: app}
reviewed: "A review on the head commit\nby Copilot or the owner?\n(commented, approved or\nchanges requested)" {class: decision}
waits: "review-done fails:\nthe merge button stays off" {class: fail}
fallback: "Copilot does not come?\nRequest it again,\nor the owner reviews" {class: person}
threads: "Every review thread\nresolved?" {class: decision}
open: "Merge blocked until\nthe threads are resolved" {class: fail}
ci: "ci-ok green and the branch\nup to date with main?" {class: decision}
merge: "Owner merges\n(squash)" {class: end}

push -> ask
push -> check: {class: hot}
ask -> check: "review posted:\nthe check runs again" {class: hot}
check -> reviewed
reviewed -> waits: no
waits -> fallback
fallback -> check: "review posted"
reviewed -> threads: yes {class: hot}
threads -> open: no
threads -> ci: yes {class: hot}
ci -> merge: yes {class: hot}
