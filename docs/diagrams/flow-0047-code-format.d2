# Flowchart: the code format of the backend (ADR 0047): Spotless runs google-java-format and ktfmt (Google style).
# Source of truth: backend/build.gradle.kts (spotless {}), .github/workflows/ci.yml (backend: spotlessCheck),
#   .editorconfig, .idea/codeStyles/Project.xml.
# Render: cd docs/diagrams && d2 fmt flow-0047-code-format.d2 && d2 flow-0047-code-format.d2 flow-0047-code-format.svg

...@style

direction: down

dev: "Developer or assistant\nedits backend code" {class: end}
pr: "Pull request (ci.yml, backend)" {class: end}

apply: "./gradlew spotlessApply" {class: app}
check: "./gradlew spotlessCheck" {class: app}

which: "Which file?" {class: decision}
java: "src/**/*.java\ngoogle-java-format" {class: app}
kotlin: "src/**/*.kt\nktfmt googleStyle()" {class: app}
gradle: "*.gradle.kts\nktfmt googleStyle()" {class: app}
generated: "build/generated/openapi\nnot formatted" {class: data}

formatted: "Formatted in place" {class: data}
clean: "Every file formatted?" {class: decision}
tests: "./gradlew test" {class: app}
fail: "Job fails: run spotlessApply" {class: end}

dev -> apply -> which: {class: hot}
which -> java
which -> kotlin
which -> gradle
which -> generated: "generated code"
java -> formatted
kotlin -> formatted
gradle -> formatted

pr -> check -> clean: {class: hot}
clean -> tests: "yes"
clean -> fail: "no"
