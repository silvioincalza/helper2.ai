# Flowchart: the admin starts research on review items; a worker runs the agent; the admin confirms each attribute.
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/research/usecase/StartResearch.java (start, all open),
#   RunResearch.java (budget, claim, loop, retry, cancel), FailStaleResearch.java, ../CheckResearch.java (status),
#   ../internal/ResearchWorkers.java, ../internal/JdbcResearchRuns.java (claim, requeue).
# Render: cd docs/diagrams && d2 fmt flow-0048-review-research.d2 && d2 flow-0048-review-research.d2 flow-0048-review-research.svg

...@style

direction: down

start: "Admin: Research\n(one item, a selection, the page,\nor all open resource and course candidates)" {class: app}
all: "Every open candidate?" {shape: diamond; class: decision}
estimate: "Show the count and the most model calls\n(14 an item); the admin confirms" {class: app}
queue: "review_research: one row per item, QUEUED\n(all open skips items whose newest run is DONE;\nResearch again on one item runs it again)" {class: data}
budget: "Research on, and 14 model calls\n(one run's most) left today?" {shape: diamond; class: decision}
waiting: "No run is claimed: the rows stay QUEUED\nuntil the budget resets" {class: fail}
worker: "Worker (virtual thread):\noldest QUEUED row,\nFOR UPDATE SKIP LOCKED → RUNNING" {class: app}
cancelled: "Cancelled?" {shape: diamond; class: decision}
stopped: "CANCELLED: stops before its next step" {class: fail}
model: "MODEL_CALL: the item and the evidence so far\n(page text inside UntrustedText)" {class: app}
spent: "Budget spent during the run?" {shape: diamond; class: decision}
requeue: "Back to QUEUED, its steps removed;\nit starts again when the budget resets" {class: fail}
next: "Tool call or final answer?" {shape: diamond; class: decision}
limits: "3 minutes reached, or a tool call\nafter the answer-now call?" {shape: diamond; class: decision}
calls_left: "Tool calls left (12 per run),\nnot the same call again,\nand the tool's own limit not reached\n(web_search: 4 per run)?" {shape: diamond; class: decision}
notrun: "Not run: stored with the error \"not run\";\nthe model is told so" {class: fail}
answernow: "MODEL_CALL with no tools:\n\"answer now with what you have read\"" {class: app}
tool: "TOOL_CALL: read_page · web_search · find_package\ngithub_repo · huggingface · catalog_lookup · check_url\n(read only; shadow libraries and private addresses refused)" {class: app}
step: "review_research_step:\nrequest, response (≤ 200 KB), time, tokens" {class: data}
json: "The JSON asked for?" {shape: diamond; class: decision}
retried: "Already asked again once?" {shape: diamond; class: decision}
again: "\"Answer again with the JSON object only\"" {class: app}
check: "CHECK: EvidenceValidator on every citation;\nCONFIRMED · SINGLE_SOURCE · CONFLICT · NOT_FOUND\nper attribute" {class: app}
done: "DONE: verdict and attributes" {class: data}
failed: "FAILED: the reason; the admin can start it again" {class: fail}
review: "Admin: timeline of the steps (SSE)\nand the attribute table" {class: app}
decide: "Each changed attribute:\nConfirm · Edit · Keep current" {class: app}
accept: "Accept: the confirmed values go into the candidate,\nthen the existing accept path (0038)" {class: app}
reject: "Reject (one item), or batch reject:\nthe list with reasons first, then confirm" {class: app}

start -> all
all -> estimate: "yes"
all -> queue: "no"
estimate -> queue: "confirmed"
queue -> budget
budget -> waiting: "no"
waiting -> budget: "next tick"
budget -> worker: "yes"
worker -> cancelled
cancelled -> stopped: "yes"
cancelled -> model: "no"
model -> spent
spent -> requeue: "yes"
requeue -> queue
spent -> step: "no"
spent -> next: "no"
next -> limits: "tool call"
limits -> failed: "yes"
limits -> calls_left: "no"
calls_left -> tool: "yes"
calls_left -> notrun: "no"
tool -> step
tool -> cancelled: "the response, as evidence"
tool -> answernow: "after the 12th"
notrun -> answernow
answernow -> step
answernow -> next
next -> json: "final answer"
json -> check: "yes"
json -> retried: "no"
retried -> again: "no"
again -> cancelled
retried -> failed: "yes"
check -> step
check -> done
done -> review
failed -> review
review -> decide
decide -> accept: "every changed attribute decided"
review -> reject: "verdict: reject"
