# Flowchart: how an example gets on the home page, and when it leaves it (ADR 0049).
# Source of truth: backend/src/main/kotlin/ai/helper2/examples/ExampleCheck.kt, HomeExample.kt,
#   backend/src/main/java/ai/helper2/examples/usecase/CheckHomeExamples.java, AddHomeExample.java, ChangeHomeExample.java,
#   examples/internal/JdbcHomeExamples.java, SearchExampleSearch.java, HomeExampleCheckSchedule.java,
#   frontend/src/lib/examples.ts.
# Render: cd docs/diagrams && d2 fmt flow-0049-home-examples.d2 && d2 flow-0049-home-examples.d2 flow-0049-home-examples.svg

...@style

direction: down

write: "Admin adds or changes an example\n(label, query, path, 1 to 3 expected results)" {class: end}

rules: Rules {
  class: group
  direction: down
  text: "Texts: 2-32 / 3-200 chars,\nno < >, no web address,\nno control characters?" {class: decision}
  known: "Every new expected result\nin the catalog? (a kept one\nmay have left it)" {class: decision}
  unique: "Label and query unique\n(locale, any case; the index\ndecides, also between two writes)?" {class: decision}
  invalid: "400 invalid-request" {class: fail}
  dup: "409 duplicate" {class: fail}
  text -> known: yes
  text -> invalid: no
  known -> unique: yes
  known -> invalid: no
  unique -> dup: no
}

pending: "PENDING: stored, hidden\n(audit entry, same transaction)" {class: data}

check: "Quality check\n(PENDING every 5 min, every example each night,\none replica at a time)" {
  class: group
  direction: down
  search: "The example's search: its query and path,\n10 results, no web search" {class: app}
  degraded: "A source we asked failed,\nor the index was down?" {class: decision}
  keep: "Keep the last result" {class: end}
  rank: "Best rank of an\nexpected result" {class: decision}
  pass: "PASS: shown" {class: hot}
  weak: "WEAK: hidden" {class: fail}
  fail: "FAIL: hidden" {class: fail}
  same: "Search unchanged since read?" {class: decision}
  drop: "Not stored (a change came first)" {class: end}
  search -> degraded
  degraded -> keep: yes
  degraded -> rank: no
  rank -> pass: "1-3"
  rank -> weak: "4-10"
  rank -> fail: "none in 10"
}

home: "Home page\nGET /home/examples (ACTIVE and PASS, cached 5 min)\npicks 2 + 2 at random" {class: end}

write -> rules.text
rules.unique -> pending: yes
pending -> check.search
check.pass -> check.same
check.weak -> check.same
check.fail -> check.same
check.same -> check.drop: no
check.same -> home: "yes: stored"
