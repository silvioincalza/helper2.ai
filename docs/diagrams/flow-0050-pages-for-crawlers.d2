# Flowchart: what Spring answers for an address the client router owns (ADR 0050).
# Source of truth (to be written with the record): backend/src/main/java/ai/helper2/pages/web/PageController.java,
#   pages/PageTemplate.java, pages/usecase/RenderPage.java, backend/src/main/kotlin/ai/helper2/pages/PageHead.kt,
#   IndexPolicy.kt, JsonLd.kt, backend/src/main/resources/pages/routes.txt, platform/SinglePageApp.java.
# Render: cd docs/diagrams && d2 fmt flow-0050-pages-for-crawlers.d2 && d2 flow-0050-pages-for-crawlers.d2 flow-0050-pages-for-crawlers.svg

...@style

direction: down

req: "GET an address without a file extension\n(not /api, /oauth2, /login, /logout, /actuator)" {class: end}

route: "In pages/routes.txt?" {class: decision}
notfound: "404 + app shell\nnoindex, \"Page not found\"" {class: fail}

kind: "Which page?" {class: decision}

static: "/, /sources, /mission,\n/privacy, /terms" {class: app}
personal: "/search, /?q=, /saved,\n/account, /admin/**" {class: app}

res: "/resource/{id}" {
  class: group
  direction: down
  uuid: "id is a UUID?" {class: decision}
  find: "GetResourceDetail.find(id)" {class: app}
  found: "Found?" {class: decision}
  merged: "Found under another id\n(records merged)?" {class: decision}
  moved: "301 to /resource/{owner}" {class: end}
  gone: "404 + app shell\nnoindex, \"Resource not found\"" {class: fail}
  worthy: "IndexPolicy: index-worthy?\n(type, source description,\na fact or relationship)" {class: decision}
  index: "robots: index" {class: hot}
  noindex: "robots: noindex, follow" {class: data}
  head: "Head: title, source description\n(never AI-written), absolute canonical,\nOpen Graph, JSON-LD by type\nBody: h1, facts, source and related links" {class: app}
  uuid -> find: yes
  uuid -> gone: no
  find -> found
  found -> merged: yes
  found -> gone: no
  merged -> moved: yes
  merged -> worthy: no
  worthy -> index: yes
  worthy -> noindex: no
  index -> head
  noindex -> head
}

fixed: "Fixed title and description\nrobots: index" {class: hot}
quiet: "Fixed title\nrobots: noindex, follow" {class: data}

escape: "Every text HTML-escaped,\nJSON-LD with \\u003c \\u003e \\u0026" {class: app}
out: "200 + filled index.html (no-cache)\ntags marked data-h2-head;\nReact replaces the body" {class: end}

req -> route
route -> notfound: no
route -> kind: yes
kind -> static
kind -> personal
kind -> res.uuid
static -> fixed
personal -> quiet
fixed -> escape
quiet -> escape
res.head -> escape
escape -> out
