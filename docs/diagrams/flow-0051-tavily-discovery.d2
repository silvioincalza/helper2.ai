# Flowchart: one result of a Tavily discovery search, from the search to the catalog or the review list, and an
# admin's decision on a candidate.
# Source of truth: backend/src/main/java/ai/helper2/sources/tavily/TavilyDiscoveryCollector.java (collect, sort,
#   searchAll, shapeOf, tagEveryCategory, isListPage, productSite, siteTitle), backend/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java,
#   backend/src/main/kotlin/ai/helper2/scout/usecase/IndexAcceptedCandidate.kt,
#   backend/src/main/java/ai/helper2/admin/usecase/ResolveReview.java.
# Render: cd docs/diagrams && d2 fmt flow-0051-tavily-discovery.d2 && d2 flow-0051-tavily-discovery.d2 flow-0051-tavily-discovery.svg

...@style

direction: down

due: "Scout run: discovery due?\n(7 days since the last pass)" {class: decision}
notdue: "SKIPPED\n\"Not due yet\"" {class: end}
search: "33 Tavily searches\n(general, advanced, 10 results,\nno answer; social sites, directories\nand review sites excluded;\nonly pages since the last pass)" {class: ext}
outage: "Half or more of\nthe searches failed?" {class: decision}
failed: "Pass FAILED,\ncheckpoint stays" {class: fail}
score: "Score ≥ min-score (0.4)\nand about AI?" {class: decision}
drop: "Dropped" {class: end}
own: "GitHub repository\nor home page?" {class: decision}
list: "List-like title (\"12 best\", \"vs\",\n\"alternatives\")?" {class: decision}
article: "Indexed as ARTICLE\n(source tavily-discovery)" {class: data}
site: "One level below a home page\n(/en does not count), not /blog,\na post slug, blog. or docs. host,\nnot a publisher's or directory's host?" {class: decision}
candidate: "Candidate: a site page (/pricing)\nas its home page; any other page\n(aws.amazon.com/bedrock) as it is" {class: app}
tags: "Merged by URL across searches:\ntag of each category that found it\nor whose words it has; type = most\nspecific of the finding categories" {class: app}
known: "URL in the catalog or\nproposed before?" {class: decision}
skip: "Not proposed again" {class: end}
item: "RESOURCE_CANDIDATE review item\n(candidate as JSON)" {class: data}
admin: "Admin decides\n(back office, VPN)" {class: person}
reject: "REJECTED: decision only" {class: end}
valid: "ResourceCandidateJson reads it;\nknown source, URL, title,\nproduct type, tags?" {class: decision}
exists: "CatalogLookup: indexed by\nanother source since proposed?" {class: decision}
keep: "ACCEPTED: decision only,\nthe other source's entry stays" {class: end}
refused: "400: item stays open" {class: fail}
indexed: "Indexed as a tavily-discovery record\nwith its tags, item ACCEPTED (one\ntransaction); the next run enriches it" {class: end}

due -> notdue: no
due -> search: yes {class: hot}
search -> outage
outage -> score: no {class: hot}
outage -> failed: yes
score -> drop: no
score -> own: yes {class: hot}
own -> candidate: yes {class: hot}
own -> list: no
list -> article: yes
list -> site: no
site -> drop: no
site -> candidate: yes
article -> tags
candidate -> tags
tags -> known: candidate {class: hot}
known -> skip: yes
known -> item: no {class: hot}
item -> admin
admin -> reject: reject
admin -> valid: accept {class: hot}
valid -> refused: no
valid -> exists: yes {class: hot}
exists -> keep: yes
exists -> indexed: no {class: hot}
