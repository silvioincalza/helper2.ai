# Flowchart: what a hub address answers (ADR 0052).
# Source of truth: backend/apps/public/src/main/kotlin/ai/helper2/site/pages/Hub.kt, Pages.kt (hub),
#   site/pages/internal/CatalogSiteLists.java, site/pages/web/HubController.java,
#   site/pages/usecase/ListSitemap.java,
#   catalog/usecase/ListNewestIndexable.java, catalog/internal/JdbcResources.indexable,
#   frontend/src/lib/hubs.ts, features/hubs/HubPage.tsx.
# Render: cd docs/diagrams && d2 fmt flow-0052-hub-pages.d2 && d2 flow-0052-hub-pages.d2 flow-0052-hub-pages.svg

...@style

direction: down

req: "GET /mcp-servers (a hub address)\nor GET /api/v1/hubs/{type}" {class: end}
hub: "A type with a hub?\n(Hub.of)" {class: decision}
none: "API: 404 problem\n(unknown type: 400)" {class: fail}
kept: "List read less than\n10 minutes ago?" {class: decision}
mem: "The kept list" {class: data}
read: "ListNewestIndexable:\nindex-worthy of the type,\nnewest change first, at most 50" {class: app}
ok: "Read worked?" {class: decision}
last: "The last list, or empty" {class: data}
any: "The list has a resource?" {class: decision}
page: "Server page: index, title, description,\ncanonical, CollectionPage JSON-LD,\nbody with the list and the links\nto the site pages and hubs;\nlisted in /sitemaps/pages.xml" {class: hot}
thin: "Server page: noindex, follow,\nbody with the links only;\nnot in /sitemaps/pages.xml" {class: fail}
api: "HubResponse, public max-age=300" {class: hot}

req -> hub
hub -> none: no
hub -> kept: yes
kept -> mem: yes
kept -> read: no
read -> ok
ok -> mem: "yes, kept"
ok -> last: no
mem -> any: "a hub address"
mem -> api: "the API"
last -> any
last -> api
any -> page: yes
any -> thin: no
