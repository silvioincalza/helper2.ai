# Flowchart: what GET /api/v1/policy answers, and where each number comes from (ADR 0052).
# Source of truth: backend/src/main/java/ai/helper2/policy/web/PolicyController.java,
#   backend/src/main/kotlin/ai/helper2/search/SearchPolicy.kt, guide/GuidePolicy.kt,
#   backend/src/main/java/ai/helper2/identity/AccountPolicy.java, catalog/CatalogPolicy.java,
#   scout/ScoutPolicy.java, platform/config/PlatformRetentionProperties.java, platform/config/CategoriesProperties.java,
#   platform/RateLimitInterceptor.java, identity/config/SecurityConfiguration.java.
# Render: cd docs/diagrams && d2 fmt flow-0052-policy-endpoint.d2 && d2 flow-0052-policy-endpoint.d2 flow-0052-policy-endpoint.svg

...@style

direction: down

request: "GET /api/v1/policy\n(no sign-in, no cookie needed)" {class: end}
rate: "Under the public read limit\n(H2_RATE_LIMIT_RECENT_PER_MINUTE\nper client address)?" {class: decision}
limited: "429 rate-limited,\nRetry-After" {class: fail}

startup: "At startup" {
  class: group
  direction: down
  config: "application.yaml + H2_ variables" {class: config}
  bind: "@ConfigurationProperties records\n(validated: a bad value stops startup)" {class: config}
  facts: "One policy value per owning module:\nsearch, guide, identity, catalog, scout;\nplatform: counter lifetimes, backups, categories" {class: data}
  config -> bind -> facts
}

answer: "Policy\nguide: max candidates, max picks\ndaily limits: guide questions, free answers,\nweb searches (guest; registered or null)\nretention: periods in seconds\nsources: counts and sizes fixed in code" {class: app}
registered: "Registered tier on?" {class: decision}
reg: "registered: its limits" {class: data}
nul: "registered: null\n(everyone has the guest limits)" {class: data}
ok: "200, Cache-Control: public, max-age=300\nno personal data" {class: hot}

request -> rate
rate -> limited: no
rate -> answer: yes
startup.facts -> answer: "read, never counted"
answer -> registered
registered -> reg: yes
registered -> nul: no
reg -> ok
nul -> ok
