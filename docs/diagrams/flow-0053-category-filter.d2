# Flowchart: how a resource gets its categories (by code, no model), and how a search filters and counts them.
# Source of truth: backend/libs/kernel/src/main/kotlin/ai/helper2/shared/Categories.kt (CategoryMatcher, CategoryCatalog),
#   backend/libs/kernel/src/main/kotlin/ai/helper2/shared/CategoryWords.kt,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/ResourceStore.java (upsert, assignCategories),
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/usecase/BackfillCategories.java, IndexAwesomeLists.java,
#   backend/libs/search/src/main/kotlin/ai/helper2/search/ResultMerger.kt (categoriesOf),
#   backend/libs/search/src/main/kotlin/ai/helper2/search/Filtering.kt (the category facet),
#   backend/apps/helper2/src/main/java/ai/helper2/search/web/SearchController.java (categoryFilter).
# Render: cd docs/diagrams && ./render.sh

...@style

direction: down

when: "When are categories assigned?" {class: decision}
upsert: "Catalog upsert, any source (and after an\nawesome list's entries are indexed, ADR 0058):\nfor every resource touched, read its title,\nwhat its sources wrote (not AI text),\nevery tag, its type, its finders and the\nawesome-list headings it sits under" {class: data}
backfill: "Backfill: at startup when the words\nchanged (marker), or Admin action;\n500 resources a batch, one replica" {class: data}
merge: "Search merge (live web results too):\nthe same inputs from the merged hits,\nplus what the catalog stored" {class: app}

match: CategoryMatcher.match (per category) {
  class: group
  direction: down
  finder: "Found by discovery-<id>?" {class: decision}
  text: "One of its words in the\ntitle or description?" {class: decision}
  req: "Category requires a word\n(health, legal)?" {class: decision}
  tag: "A tag, or a list heading (each\nheading alone, ADR 0058), is its id\nor has one of its words?" {class: decision}
  type: "Type PROMPT or SKILL, and the\nonly category with that type?" {class: decision}
  yes: "Category given" {class: end}
  no: "Not given" {class: end}
  finder -> yes: yes
  finder -> text: no
  text -> yes: yes
  text -> req: no
  req -> no: yes
  req -> tag: no
  tag -> yes: yes
  tag -> type: no
  type -> yes: yes
  type -> no: no
}

labels: "CATEGORY labels (resource_label),\napart from the 20 TAG labels" {class: data}
request: "GET /search?category=..." {class: person}
valid: "Every value a configured id\nor \"unknown\"?" {class: decision}
bad: "400 problem details" {class: fail}
filter: "Keep a result in any of them (OR),\nwith the other filters (AND);\n\"unknown\" = no category yet" {class: app}
facet: "Facet counts in memory over the\nmerged results: every filter but\nthe category's own" {class: app}
page: "Filters panel: one group per family,\ncounts, \"No category yet\"" {class: person}

when -> upsert: indexed
when -> backfill: catalog-wide
when -> merge: search
upsert -> match.finder
backfill -> match.finder
merge -> match.finder
match.yes -> labels: stored
request -> valid
valid -> bad: no
valid -> filter: yes {class: hot}
labels -> filter: catalog hits carry them
match.yes -> filter: live hits
filter -> facet
facet -> page
