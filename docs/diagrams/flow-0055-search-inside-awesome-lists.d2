# Flowchart: how an awesome list's words reach the index, and how a search uses them (ADR 0055).
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/sources/github/AwesomeListParser.java, MarkdownText.java,
#   GitHubAwesomeCollector.java (read, searchText, listHits), backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/RunScout.kt
#   (indexListsQuietly), backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/AwesomeListIndex.java,
#   ResourceStore.java (searchSql, searchFound), CatalogSearchSource.java, search/web/CardMapper.java,
#   frontend/src/components/results/ResultRow.tsx.
# Render: cd docs/diagrams && d2 fmt flow-0055-search-inside-awesome-lists.d2 && d2 flow-0055-search-inside-awesome-lists.d2 flow-0055-search-inside-awesome-lists.svg

...@style

direction: down

readme: "README of a list read in this pass\n(top 10 lists, up to 5 MB)" {class: end}

parse: "AwesomeListParser" {
  class: group
  direction: down
  fence: "Inside a code fence?" {class: decision}
  skip: "Skipped" {class: end}
  kind: "Heading or list item?" {class: decision}
  heading: "Heading: plain words, at most 200 chars;\nopens its level, closes deeper ones" {class: app}
  entry: "Entry: GitHub link, not the list itself,\nnot a GitHub page; line as plain words\n(no links, badges, HTML, URLs, control\nor bidi chars), at most 500 chars;\nheading path from level 2 down, at most 200" {class: app}
  fence -> skip: yes
  fence -> kind: no
  kind -> heading: heading
  kind -> entry: item
}

caps: "Caps per list: at most max-entries-per-pass entries,\n256 KiB of entry text and heading path,\n16 KiB of headings" {class: decision}

hits: "Hits: this run's slice of entries (AI only)\n+ each list read, as an ARTICLE tagged awesome-list" {class: app}
index: "RunScout: hits indexed first,\nthen the list text to the list index" {class: app}

replace: "AwesomeListIndex.replace (one transaction per list)" {
  class: group
  direction: down
  listed: "List in the catalog?" {class: decision}
  nothing: "Nothing written" {class: end}
  rows: "Delete the list's entry rows;\ninsert one row per entry in the catalog:\ntsvector (line A, heading path B)\n+ heading path as text" {class: data}
  topics: "Upsert the list's row:\ntsvector of its headings" {class: data}
  listed -> nothing: no
  listed -> rows: yes
  rows -> topics
}

fail: "A failed list index: logged,\nthe pass goes on; the next one rebuilds it" {class: fail}

search: "Index query (helper2-index)" {
  class: group
  direction: down
  own: "Own text matches?" {class: decision}
  direct: "Direct row: every word +2,\npopularity, half the text score" {class: hot}
  inlist: "An entry line or a list's\nheadings match? (GIN)" {class: decision}
  half: "List-only row: counts half\n(every word +1, half popularity)" {class: app}
  none: "Not found" {class: end}
  own -> direct: yes
  own -> inlist: no
  inlist -> half: yes
  inlist -> none: no
}

card: "Card: \"Found in <list> under <heading>\"\nwhen every source found it only in a list" {class: end}

readme -> parse.fence
parse.heading -> caps
parse.entry -> caps
caps -> hits
hits -> index
index -> replace.listed
index -> fail: "throws"
replace.topics -> search.own: "later, a search"
search.half -> card
