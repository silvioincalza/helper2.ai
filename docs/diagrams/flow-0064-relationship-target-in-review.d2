# Flowchart: an admin changes the target of a relationship candidate in the review list, then decides it.
# Source of truth: backend/src/main/java/ai/helper2/catalog/usecase/ChangeRelationshipTarget.java,
#   backend/src/main/java/ai/helper2/catalog/usecase/AddCuratedResource.java,
#   backend/src/main/java/ai/helper2/catalog/internal/RelationshipTargets.java,
#   backend/src/main/java/ai/helper2/admin/web/ReviewController.java (target),
#   backend/src/main/java/ai/helper2/catalog/ReviewQueue.java (supersedeEnrichmentItems),
#   backend/src/main/java/ai/helper2/catalog/internal/JdbcEnrichmentResults.java (deleteUnreviewedAiRelationships).
# Render: cd docs/diagrams && d2 fmt flow-0064-relationship-target-in-review.d2 && d2 flow-0064-relationship-target-in-review.d2 flow-0064-relationship-target-in-review.svg

...@style

direction: down

admin: "Admin: Change the target\n(back office, VPN)" {class: person}
one: "Exactly one of resourceId,\nnewResource, title?" {class: decision}
bad: "400, nothing changes" {class: fail}
which: "Which one?" {class: decision}
checks: "https address, name,\na tool or a model?" {class: decision}
known: "Address in the catalog\n(resource or record)?" {class: decision}
existing: "That resource\n(no second one)" {class: data}
added: "New curated record:\nname, type, no description,\nNOT_RUN; ADD_RESOURCE" {class: data}
named: "Name 1-120 characters?" {class: decision}
lock: "Item locked: open\nrelationship candidate?" {class: decision}
conflict: "404 / 409:\nrolled back, nothing added" {class: fail}
target: "Target a resource in the\ncatalog, not the resource itself?" {class: decision}
taken: "Same kind and target already\non the resource?" {class: decision}
dup: "409 duplicate:\nrolled back" {class: fail}
changed: "Relationship: new target,\ntarget_origin CURATED,\norigin kept;\nCHANGE_RELATIONSHIP_TARGET" {class: app}
rerun: "Scout run on the resource\nbefore a decision?" {class: decision}
kept: "Item not superseded,\nrelationship not deleted" {class: app}
open: "Item stays open:\nevidence with the new target" {class: end}
accept: "Admin accepts:\nlink VERIFIED" {class: end}

admin -> one
one -> bad: no
one -> which: yes {class: hot}
which -> checks: newResource {class: hot}
checks -> bad: no
checks -> known: yes {class: hot}
known -> existing: yes
known -> added: no {class: hot}
which -> named: title
named -> bad: no
which -> lock: resourceId
named -> lock: yes
existing -> lock
added -> lock: {class: hot}
lock -> conflict: no
lock -> target: yes {class: hot}
target -> bad: "no (400, rolled back)"
target -> taken: yes {class: hot}
taken -> dup: yes
taken -> changed: no {class: hot}
changed -> open: {class: hot}
open -> rerun: {class: hot}
rerun -> kept: yes
kept -> accept
rerun -> accept: no {class: hot}
