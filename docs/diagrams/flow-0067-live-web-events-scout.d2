# Flowchart: one pass of the live web events scout, from the searches to an event in Coming up, and how its days are
# merged with a source's and shown.
# Source of truth: backend/src/main/java/ai/helper2/sources/tavily/LiveWebEventsCollector.java (collect, pagesToRead,
#   readAll, readPage, eventHit), backend/src/main/java/ai/helper2/sources/events/EventQuoteGate.java (check),
#   QuotedDays.java (find), SpringAiEventReader.java, backend/src/main/kotlin/ai/helper2/scout/GapRound.kt
#   (UntrustedPageText.clean), backend/src/main/kotlin/ai/helper2/search/ResultMerger.kt (eventSources, eventFacts),
#   backend/src/main/java/ai/helper2/catalog/internal/ResourceStore.java (refreshEventDates),
#   backend/src/main/java/ai/helper2/search/web/CardMapper.java (eventOrigin),
#   backend/src/main/java/ai/helper2/pages/usecase/RenderPage.java (view), frontend/src/components/home/TermList.tsx.
# Render: cd docs/diagrams && d2 fmt flow-0067-live-web-events-scout.d2 && d2 flow-0067-live-web-events-scout.d2 flow-0067-live-web-events-scout.svg

...@style

direction: down

on: "Source on?\n(H2_SOURCE_LIVE_WEB_EVENTS_SCOUT_ENABLED,\nkey and a model)" {class: decision}
off: "Off: not called" {class: end}
due: "Due?\n(7 days since the last pass)" {class: decision}
notdue: "SKIPPED: not due yet" {class: end}
cap: "Scout credits today\nunder the daily cap (40)?" {class: decision}
capped: "SKIPPED: cap reached,\nnext try tomorrow" {class: end}
search: "4 Tavily searches\n(general, basic, 10 results):\nhackathons, meetups and talks,\nconferences and summits, workshops" {class: ext}
keep: "About AI, plain https link;\nonce per URL; at most 20 pages" {class: app}
capagain: "Cap reached before\nthe next Extract call?" {class: decision}
stop: "Stop reading:\nkeep what was read" {class: end}
extract: "Tavily Extract, 4 pages a call\n(basic, markdown, no images)" {class: ext}
clean: "Clean the page: hidden text out,\nemails → [email], phones → [phone],\ninstruction-like lines out" {class: app}
model: "Model reads the page\n(reasoning model, thinking off,\nbudget 40 a day): events on it,\ndays + quote, kind, format, place + quotes" {class: ext}
nomodel: "No model now\n(budget, circuit)?" {class: decision}
gate: "EventQuoteGate" {class: decision}
reject: "Not listed\n(one event? quote 20-300 chars on the page?\ncode reads one range with its year?\nsame days as the model?\nstarts within 6 months? ≤ 31 days?)" {class: fail}
hit: "EVENT hit: days from the quote;\nkind, format, place only with\ntheir own quote on the page;\nquote, model, prompt in extra" {class: data}
merge: "Another source states\nthis event's days?" {class: decision}
theirs: "Their days, kind, format\nand place win;\nnot labelled" {class: app}
ours: "AI-read days are the event's:\neventOrigin AI_EXTRACTED" {class: app}
ui: "Coming up and Events page:\n\"Extracted by AI\" label,\ndata-ai-generated on date,\nkind and place" {class: person}
page: "Server page: days and place\nleft out (no label there)" {class: app}

on -> off: no
on -> due: yes
due -> notdue: no
due -> cap: yes
cap -> capped: no
cap -> search: yes
search -> keep -> capagain
capagain -> stop: yes
capagain -> extract: no
extract -> clean -> nomodel
nomodel -> stop: yes
nomodel -> model: no
model -> gate
gate -> reject: no
gate -> hit: yes
hit -> capagain: next pages
hit -> merge
merge -> theirs: yes
merge -> ours: no
ours -> ui
ours -> page
