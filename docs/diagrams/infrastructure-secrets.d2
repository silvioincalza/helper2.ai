# Infrastructure, the secrets: the two Secrets of the namespace, where their values come from, and which
# workload reads which key. No workload loads the passwords whole: each names only its own keys, so each
# application has its own database role and its own Redis user (ADR 0004).
# Source of truth: deploy/k8s/README.md, deploy/k8s/Makefile (env-secret, credentials), deploy/k8s/check-app-env.sh,
#   deploy/helm/helper2/templates/app.yaml, backoffice.yaml, migrate.yaml, postgres.yaml, redis.yaml, backup.yaml,
#   exporters.yaml, files/redis-users.acl.
# Render: cd docs/diagrams && d2 fmt infrastructure-secrets.d2 && d2 infrastructure-secrets.d2 infrastructure-secrets.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

source: "WHERE THE VALUES COME FROM" {
  class: group
  appenv: "app.env of the environment\n(owner workstation, never in the repo)" {
    shape: page
    class: config
  }
  openbao: "OpenBao helper2/kv\nci/<env>: app_env + deployer kubeconfig" {
    shape: cylinder
    class: data
  }
  appenv -> openbao: "make credentials"
}

secrets: "SECRETS OF THE NAMESPACE (written by kubectl, not by the chart)" {
  class: group
  env: "Secret helper2-app-env\nsettings and API keys,\nno passwords" {
    shape: page
    class: config
  }
  creds: "Secret helper2-credentials\nthe 8 passwords" {
    shape: page
    class: config
  }
}

apps: APPLICATIONS {
  class: group
  app: "helper2 (public app)\ndatabase role h2_public\nRedis user h2_public" {class: app}
  bo: "helper2-backoffice\ndatabase role h2_backoffice\nRedis user h2_backoffice" {class: app}
}

owners: "RUN AS THE OWNER" {
  class: group
  postgres: "postgres\nowner password" {
    shape: cylinder
    class: data
  }
  migrate: "helper2-migrate Job\nowner password + the roles' passwords\n(sets the roles' logins)" {class: app}
  backup: "pg-backup CronJob\nowner password" {class: app}
  redis: "redis\nrequirepass (admin) + an ACL user\nper app, read from stdin" {
    shape: cylinder
    class: data
  }
}

monitors: "READ STATISTICS ONLY" {
  class: group
  pgexp: "postgres-exporter\nrole h2_monitor (pg_monitor)" {class: app}
  redisexp: "redis-exporter\nRedis user h2_monitor (INFO, PING)" {class: app}
}

source.appenv -> secrets.env: "every key but the passwords" {class: config}
source.appenv -> secrets.creds: "the 8 passwords" {class: config}
secrets.env -> apps.app: "envFrom (whole)" {class: config}
secrets.env -> apps.bo: "envFrom (whole)" {class: config}
secrets.creds -> apps.app: "its role + its Redis user" {class: config}
secrets.creds -> apps.bo: "its role + its Redis user" {class: config}
secrets.creds -> owners.postgres: owner {class: config}
secrets.creds -> owners.migrate: "owner + roles" {class: config}
secrets.creds -> owners.backup: owner {class: config}
secrets.creds -> owners.redis: "admin + the 3 users" {class: config}
secrets.creds -> monitors.pgexp: "h2_monitor" {class: config}
secrets.creds -> monitors.redisexp: "h2_monitor" {class: config}
