# Runtime infrastructure of the hosted helper2 on Kubernetes, the overview: how a visitor's request gets in,
# the three applications, their two stores, and what they call outside. One line per relation, no ports,
# no secrets, no policies. The detail is in four views, each about one question:
#   infrastructure-workloads.d2 (what runs in the namespace and what each may reach),
#   infrastructure-secrets.d2 (who holds which password),
#   infrastructure-delivery.d2 (how an image gets to the cluster, and the canary of a release),
#   infrastructure-data.d2 (backups and monitoring).
# Source of truth: deploy/helm/helper2 (values*.yaml, templates/*.yaml), the platform repo outside this repo
#   (DNS, tunnel, ingress-nginx, the Ingresses helper2-public and helper2-admin).
# Render: cd docs/diagrams && d2 fmt infrastructure.d2 && d2 infrastructure.d2 infrastructure.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

visitor: Visitor {class: person}
owner: "Owner\n(VPN only)" {class: person}

edge: "CLOUDFLARE EDGE" {
  class: group
  cloudflare: "Proxied DNS + TLS,\nplatform tunnel" {class: ext}
}

cluster: "KUBERNETES · ns helper2-prod (helper2-staging: the same chart, smaller)" {
  class: group
  direction: right

  nginx: "ingress-nginx\n(its own namespace)" {class: app}

  apps: APPLICATIONS {
    class: group
    web: "helper2-web · 2 pods\nthe web app's files" {class: app}
    java: "the two Java applications" {
      class: group
      app: "helper2 · 3 pods\npublic site and API" {class: app}
      bo: "helper2-backoffice · 1 pod\nadmin, Scout, catalog jobs" {class: app}
    }
    embedder: "helper2-embedder · 1 pod\nembedding model, staging only\n(ADR 0054)" {class: ai}
    java -> embedder: "embeddings\n(staging)" {class: ai-call}
  }

  stores: STORES {
    class: group
    postgres: "PostgreSQL 18\n+ pgvector" {
      shape: cylinder
      class: data
    }
    redis: "Redis 8\ncache, sessions,\nrate limits" {
      shape: cylinder
      class: data
    }
  }

  nginx -> apps.web: files {class: hot}
  nginx -> apps.java.app: "site + API" {class: hot}
  nginx -> apps.java.bo: "admin hosts"
  apps.java -> stores: "each with its own\nrole and user"
}

outside: "INTERNET · TCP 443 only" {
  class: group
  grid-columns: 1
  grid-gap: 24
  nebius: "Nebius Token Factory\nNVIDIA Nemotron\n(guide, enrichment)" {class: ai}
  nvidia: "NVIDIA API catalog\nembeddings (production)" {class: ai}
  sources: "Public sources · search, Scout\nGitHub · Hugging Face · npm\narXiv · Tavily · MCP Registry" {class: ext}
}

visitor -> edge.cloudflare: HTTPS {class: hot}
edge.cloudflare -> cluster.nginx: "public hosts" {class: hot}
owner -> cluster.nginx: "admin hosts"
cluster.apps.java -> outside: "model calls\nand searches" {class: ai-call}
