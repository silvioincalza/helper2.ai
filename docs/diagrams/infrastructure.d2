# Runtime infrastructure of the hosted helper2 on Kubernetes: Cloudflare and the platform's ingress-nginx, the
# public and the in-network admin host, the two namespaces and their workloads (2 web pods and 3 public app pods on prod, 1 each on staging, one back office
# pod, rolling updates, disruption budget; ADR 0069),
# what the per-workload network policies let each workload reach and accept, Redis auth and its AOF volume,
# OpenBao and Harbor for delivery, Alloy -> Prometheus / Tempo for observability, and the prod backup
# with its optional off-site copy to Cloudflare R2 (off today).
# Source of truth: deploy/helm/helper2 (values*.yaml, templates/*.yaml), the platform repo outside this repo (DNS, tunnel,
#   ingress-nginx, Ingresses helper2-public (helper2-web for the web files) and helper2-admin, namespaces, deployer RBAC),
#   deploy/k8s/Makefile, deploy/k8s/CI.md, .github/workflows/deploy.yml,
#   backend/apps/public/src/main/resources/application.yaml, backend/apps/backoffice/src/main/resources/application.yaml (management, tracing).
# Render: cd docs/diagrams && d2 fmt infrastructure.d2 && d2 infrastructure.d2 infrastructure.svg

...@style

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

visitor: Visitor {class: person}

cloudflare: CLOUDFLARE EDGE {
  class: group
  dns: "Proxied DNS + TLS\nhelper2.ai · www.helper2.ai\n<staging host>" {class: ext}
  tunnel: "Platform tunnel\n(the platform repo)" {class: ext}
  dns -> tunnel: {class: hot}
}

cluster: KUBERNETES {
  class: group

  ingress: "ns ingress-nginx" {
    class: group
    nginx: "ingress-nginx\nIngress helper2-public: /assets/, /theme.js,\n/favicon.svg → Service helper2-web;\nthe rest → Service helper2\nIngress helper2-admin → Service helper2-admin\n(back office pods; private ranges only)" {class: app}
  }

  prod: "ns helper2-prod · ingress + egress default-deny\none policy per workload · ServiceAccount helper2: no RBAC, no token" {
    class: group
    app: "helper2 Deployment (public app) · 3 pods\nRollingUpdate: maxSurge 1, maxUnavailable 0\nPDB minAvailable 2 · spread by node\nJava 25 JRE, heap 60% of 1Gi\n:8080 site + /api/v1 (Service helper2)\n:8081 Actuator (in no Service)\nFlyway migrations" {class: app}
    web: "helper2-web Deployment (nginx) · 2 pods\nPDB minAvailable 1 · read-only root, user 101\n:8080 the web app's files (Service helper2-web)\n:8081 /healthz (in no Service) · no egress" {class: app}
    bo: "helper2-backoffice Deployment · 1 pod\nadmin API + admin web app, Scout,\ncatalog jobs · Flyway validate only\n:8080 (Service helper2-admin)\n:8081 Actuator (in no Service)" {class: app}
    postgres: "postgres StatefulSet\nPostgreSQL 18.6 + pgvector 0.8.6\nPVC 5Gi local-path" {
      shape: cylinder
      class: data
    }
    redis: "redis StatefulSet\nRedis 8.10.2 · requirepass (H2_REDIS_PASSWORD)\nAOF everysec, no RDB · 128mb LRU\nPVC 1Gi local-path\ncache, sessions, rate limits" {
      shape: cylinder
      class: data
    }
    backup: "pg-backup CronJob\n02:30 Europe/Zurich\npg_dump | gzip, 7 days" {class: app}
    backup_pvc: "PVC pg-backup\nnfs-k8s · kept on uninstall" {
      shape: cylinder
      class: data
    }
    secret: "Secret helper2-app-env\n(from OpenBao app_env,\nwritten by kubectl)" {
      shape: page
      class: config
    }

    app -> postgres: "JDBC :5432\n(data + shedlock locks)"
    app -> redis: ":6379 AUTH"
    bo -> postgres: "JDBC :5432"
    bo -> redis: ":6379 AUTH\n(own session namespace)"
    secret -> bo: envFrom {class: config}
    backup -> postgres: ":5432"
    backup -> backup_pvc: "dump"
    secret -> app: envFrom {class: config}
    secret -> redis: "requirepass via stdin" {class: config}
    secret -> postgres: {class: config}
  }

  staging: "ns helper2-staging" {
    class: group
    note: "Same chart and policies\n1 web pod, 1 public pod,\n1 back office pod (no PDB)\nScout off · no backup\nstaging host" {class: app}
  }

  observability: "ns observability" {
    class: group
    alloy: "Alloy\nscrapes :8081/actuator/prometheus\nreceives OTLP :4318" {class: app}
  }

  kubesystem: "ns kube-system" {
    class: group
    dns: "kube-dns :53\n(k8s-app=kube-dns)" {class: app}
  }

  ingress.nginx -> prod.app: ":8080\n(only allowed caller)" {class: hot}
  ingress.nginx -> prod.web: ":8080 (/assets/, /theme.js, /favicon.svg)" {class: hot}
  ingress.nginx -> prod.bo: ":8080 (admin hosts)"
  ingress.nginx -> staging.note: ":8080"
  observability.alloy -> prod.app: "scrape :8081" {class: config}
  observability.alloy -> prod.bo: "scrape :8081" {class: config}
  prod.app -> observability.alloy: "traces OTLP/HTTP :4318"
  prod.app -> kubesystem.dns: "DNS (every workload)" {class: config}
}

monitoring: MONITORING {
  class: group
  prometheus: Prometheus {class: data}
  tempo: Tempo {class: data}
  grafana: "Grafana\ndashboard helper2.json" {class: app}
  prometheus -> grafana
  tempo -> grafana
}

egress: "INTERNET · app egress TCP 443 only (private ranges excluded)" {
  class: group
  nebius: "Nebius Token Factory\nNVIDIA Nemotron" {class: ai}
  nvidia: "NVIDIA API catalog\nembeddings" {class: ai}
  sources: "Public sources\nGitHub · Hugging Face · npm · arXiv\nTavily · MCP Registry" {class: ext}
}

r2: "Cloudflare R2 bucket\n(backup.offsite, off today;\nrclone copy, never deletes)" {class: ext}

delivery: "DELIVERY (private network)" {
  class: group
  runner: "Self-hosted GitHub runner\n(one JIT job, no credentials)" {class: app}
  workstation: "Owner workstation\nmake, helm, bao" {class: person}
  openbao: "OpenBao\nhelper2/kv: ci/<env>, ci/harbor, backup/r2\nhelper2/jwt: GitHub OIDC roles" {
    shape: cylinder
    class: data
  }
  harbor: "Harbor registry\nhelper2/apps/helper2-web:<commit>\nhelper2/apps/helper2:<commit>\nhelper2/apps/helper2-backoffice:<commit>\nhelper2/apps/postgres:<tag>" {
    shape: cylinder
    class: data
  }
  runner -> openbao: "OIDC login, kv get"
  runner -> harbor: "push image"
  workstation -> openbao: "make credentials"
}

github: "GitHub Actions\n(cd.yml, deploy.yml)" {class: ext}

visitor -> cloudflare.dns: HTTPS {class: hot}
cloudflare.tunnel -> cluster.ingress.nginx: "public hosts" {class: hot}
delivery.workstation -> cluster.ingress.nginx: "admin hosts, DNS-only\n(VPN only)"
cluster.observability.alloy -> monitoring.prometheus: "remote write"
cluster.observability.alloy -> monitoring.tempo: "traces"
cluster.prod.app -> egress.nebius: "chat completions" {class: ai-call}
cluster.prod.app -> egress.nvidia: "/embeddings" {class: ai-call}
cluster.prod.app -> egress.sources: "search"
cluster.prod.bo -> egress.sources: "Scout + admin search"
cluster.prod.bo -> egress.nebius: "enrichment" {class: ai-call}
cluster.prod.backup -> r2: "HTTPS 443, only when\nbackup.offsite is on" {class: config}
github -> delivery.runner: "job (main only)"
delivery.runner -> cluster.prod: "helm upgrade --wait 12m\n(deployer ServiceAccount)" {class: config}
delivery.harbor -> cluster.prod.app: "image pull, and the web image\nof the same tag (init container: the shell)" {class: config}
delivery.harbor -> cluster.prod.bo: "image pull" {class: config}
delivery.harbor -> cluster.prod.web: "image pull" {class: config}
