# Sequence: one search request through the hexagon, in either app: a Java web adapter of the core library
# drives a Kotlin use case of the search library, which reaches the outside only through ports implemented by Java
# adapters in other modules.
# Source of truth: backend/libs/core/src/main/java/ai/helper2/search/web/SearchController.java,
#   backend/libs/core/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt, .../search/Ports.kt,
#   backend/libs/core/src/main/java/ai/helper2/sources/github/GitHubSource.java, .../catalog/internal/CatalogResultObserver.java,
#   .../search/cache/RedisSearchCache.java, .../search/internal/SpringAiQueryTranslator.java.
# Render: cd docs/diagrams && d2 fmt sequence-0002-modular-monolith-libraries-and-apps.d2 && d2 sequence-0002-modular-monolith-libraries-and-apps.d2 sequence-0002-modular-monolith-libraries-and-apps.svg

...@style

shape: sequence_diagram

ctrl: "SearchController\n(libs/core, search.web,\nJava, implements SearchApi;\nthe same class in both apps)" {class: app}
uc: "SearchResources\n(search.usecase, Kotlin)" {class: app}
rules: "QueryAnalyzer, ResultMerger,\nRanking (search, Kotlin)" {class: app}
cache: "SearchCache port\n← RedisSearchCache\n(search.cache)" {class: port}
tr: "QueryTranslator port\n← SpringAiQueryTranslator\n(search.internal)" {class: port}
src: "SearchSource port\n← GitHubSource, NpmSource …\n(sources)" {class: port}
obs: "ResultObserver port\n← CatalogResultObserver\n(catalog)" {class: port}

ctrl -> uc: "search(SearchRequest)" {class: hot}
uc -> rules: "analyze the query"
uc -> tr: "toEnglish(text, language)\n(only for a non-English query)"
uc -> cache: "get(key)"
cache -> uc: "CachedHits or miss"
uc -> src: "search(SourceQuery)\n(one virtual thread per source)" {class: hot}
src -> uc: "List<SourceHit>"
uc -> cache: "put(key, hits, ttl)"
uc -> rules: "merge and rank"
uc -> obs: "firstDiscovered(results)"
obs -> uc: "Map<ResourceId, Instant>"
uc -> obs: "record(live results only);\nthe catalog writes them\noff the request path"
uc -> ctrl: "SearchOutcome (Kotlin model)" {class: hot}
ctrl -> ctrl: "map to SearchResponseDto\n(generated once from common.yaml,\napi.common)"
