# Sequence: one REST request through the generated contract: enum binding by wire value, the generated interface,
# the controller, and the problem+json answer for a client mistake, a missing resource or a bug.
# Source of truth: backend/src/main/java/ai/helper2/platform/ContractEnumConverters.java,
#   backend/src/main/java/ai/helper2/platform/ApiExceptionHandler.java, .../search/web/SearchController.java,
#   .../catalog/web/ResourcesController.java, build/generated/openapi (SearchApi, ResourcesApi, *Dto).
# Render: cd docs/diagrams && d2 fmt sequence-0003-contract-first-rest-api.d2 && d2 sequence-0003-contract-first-rest-api.d2 sequence-0003-contract-first-rest-api.svg

...@style

shape: sequence_diagram

client: "SPA (client.ts,\nschema.ts types)" {class: person}
mvc: Spring MVC {class: app}
conv: ContractEnumConverters {class: app}
api: "Generated interface\n(SearchApi, ResourcesApi)" {class: port}
ctrl: "Controller\n(SearchController,\nResourcesController)" {class: app}
handler: ApiExceptionHandler {class: app}

ok: Valid request {
  client -> mvc: "GET /api/v1/search?q=rag&openSource=unknown" {class: hot}
  mvc -> conv: "bind \"unknown\""
  conv -> mvc: "TriStateDto.fromValue(\"unknown\")"
  mvc -> api: "search(q, …, TriStateDto.UNKNOWN, …)"
  api -> ctrl: "implementation"
  ctrl -> client: "200 SearchResponseDto (JSON)" {class: hot}
}

bad: Client mistake {
  client -> mvc: "GET /api/v1/search?openSource=maybe"
  mvc -> conv: "bind \"maybe\""
  conv -> mvc: "no such wire value"
  mvc -> handler: "MethodArgumentTypeMismatchException"
  handler -> client: "400 application/problem+json\n\"Invalid request parameters.\""
}

missing: Not found {
  client -> mvc: "GET /api/v1/resources/{id}"
  mvc -> ctrl: "getResource(id)"
  ctrl -> handler: "NotFoundException"
  handler -> client: "404 problem+json\n\"Resource not found in the Helper2 index.\""
}

bug: Anything else {
  ctrl -> handler: "RuntimeException"
  handler -> handler: "log.error with the cause"
  handler -> client: "500 problem+json, fixed text\n\"Something went wrong on our side.\"\n(cause never echoed)"
}
