# Sequence: a Redis outage seen by the search cache and the daily budget counter, then recovery.
# Shows the one redis circuit shared by every Redis adapter (open 30 s after half of the last calls failed, then
# trial calls in half-open) and the in-memory fallback of DailyBudget.
# Source of truth: backend/src/main/java/ai/helper2/search/cache/RedisSearchCache.java,
#   backend/src/main/java/ai/helper2/platform/resilience/Resilience4jPolicies.java (policy redis in application.yaml),
#   backend/src/main/java/ai/helper2/platform/llm/RedisCallCounter.java, DailyBudget.java,
#   backend/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt.
# Render: cd docs/diagrams && d2 fmt sequence-0005-redis-disposable-cache.d2 && d2 sequence-0005-redis-disposable-cache.d2 sequence-0005-redis-disposable-cache.svg

...@style

shape: sequence_diagram

search: SearchResources {class: app}
cache: RedisSearchCache {class: app}
budget: DailyBudget {class: app}
counter: RedisCallCounter {class: app}
policy: "Resilience\n(policy redis)" {class: app}
redis: Redis {class: data}
source: Live source {class: ext}

outage: Redis goes down {
  search -> cache: "get(key)"
  cache -> policy: "call(redis, GET)"
  policy -> redis: "GET h2:v1:src:..."
  redis -> policy: "error (command timeout 250 ms)"
  policy -> policy: "failure counted;\nhalf of the last calls (at least 3)\nfailed: circuit OPEN for 30 s"
  policy -> cache: "error"
  cache -> search: "IllegalStateException"
  search -> search: "notice CACHE_UNAVAILABLE"
  search -> source: "live call" {class: hot}
  source -> search: "hits" {class: hot}
}

open: Next 30 seconds {
  search -> cache: "get(key) / put(key)"
  cache -> policy: "call(redis, ...)"
  policy -> cache: "CallRefused CIRCUIT_OPEN,\nno Redis call"
  cache -> search: "fails at once"
  budget -> counter: "increment(name, day)"
  counter -> policy: "call(redis, Lua INCR)"
  policy -> counter: "CallRefused (the same circuit)"
  counter -> budget: "null"
  budget -> budget: "count in memory\nfrom last known value"
}

after: After 30 seconds: half-open, trial calls {
  search -> cache: "get(key)"
  cache -> policy: "call(redis, GET)"
  policy -> redis: "GET h2:v1:src:... (trial call)"
  redis -> policy: "entry or miss"
  policy -> policy: "trial calls succeed:\ncircuit CLOSED"
  policy -> cache: "entry or miss"
  budget -> counter: "increment(name, day)"
  counter -> policy: "call(redis, Lua script)"
  policy -> redis: "Lua: INCR h2:v1:budget:{name}:{day},\nPEXPIRE 2 days on first"
  redis -> counter: "count"
  counter -> budget: "count (Redis is the source again)"
}
