# Sequence: the secret steps of one deploy job: OIDC login, kubeconfig and app_env from OpenBao,
# kubectl writes the Secrets helper2-credentials and helper2-app-env, Helm gets hashes only, the app restarts, binds its H2_
# variables to typed records, clean-up.
# Source of truth: .github/workflows/deploy.yml, .github/actions/bao-login/action.yml,
#   deploy/k8s/Makefile (env-secret, deploy), deploy/k8s/check-app-env.sh,
#   deploy/helm/helper2/templates/{_helpers.tpl,app.yaml,backoffice.yaml},
#   backend/libs/platform/src/main/resources/helper2-shared.yaml, backend/apps/{public,backoffice}/src/main/resources/application.yaml, backend/{libs,apps}/*/src/main/java/ai/helper2/<module>/config/*Properties.java.
# Render: cd docs/diagrams && d2 fmt sequence-0007-configuration-and-secrets.d2 && d2 sequence-0007-configuration-and-secrets.d2 sequence-0007-configuration-and-secrets.svg

...@style

shape: sequence_diagram

job: "deploy job\n(self-hosted runner)" {class: app}
gh: GitHub OIDC provider {class: ext}
bao: "OpenBao\nhelper2/jwt, helper2/kv" {class: data}
helm: "make deploy\n(helm 4)" {class: app}
k8s: Kubernetes API {class: ext}
pod: "app pods\n(public, back office)" {class: app}

login: Login {
  job -> gh: "GET ACTIONS_ID_TOKEN_REQUEST_URL\n&audience=BAO_AUDIENCE"
  gh -> job: "JWT (sub = repo:...:environment:<env>)"
  job -> bao: "write auth/helper2/jwt/login\nrole=deploy-<env> jwt=..."
  bao -> job: "token (masked, in GITHUB_ENV)"
}

read: Read secrets {
  job -> bao: "kv get -field=kubeconfig ci/<env>"
  bao -> job: "deployer kubeconfig → file in RUNNER_TEMP"
  job -> bao: "kv get -field=app_env ci/<env>"
  bao -> job: "H2_ lines → <env>/app.env (umask 077)"
}

apply: Deploy {
  job -> helm: "make diff; make deploy"
  helm -> helm: "env-secret: check-app-env.sh\n(H2_ keys, database and\nRedis passwords)"
  helm -> k8s: "kubectl server-side apply:\nSecrets helper2-credentials,\nhelper2-app-env" {class: hot}
  helm -> k8s: "helm upgrade: Deployments\n(checksum/env-revision = hash of app.env)" {class: hot}
  k8s -> pod: "new pod if the hash changed"
  pod -> pod: "envFrom helper2-app-env, own\npasswords by key;\nH2_* variables → properties"
  pod -> pod: "bind + validate the\n@ConfigurationProperties records\n(bad value: startup fails)"
  pod -> pod: "context ready: beans\nget their records"
  k8s -> helm: "rollout ready (--wait, 12 min)"
}

cleanup: Clean up (always) {
  job -> job: "rm <env>/app.env\nand the kubeconfig"
}
