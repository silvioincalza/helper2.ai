# Sequence: one search across a LIVE source (GitHub), the Helper2 index, a slow source and a source whose circuit is
# open, with merge and catalog link. Shows the cache read, the parallel calls on virtual threads under each source's
# policy, a timeout and an open circuit rescued by stale entries, the merge, the one-read discovery dates and the
# background write of live hits.
# Source of truth: backend/src/main/java/ai/helper2/search/web/SearchController.java,
#   backend/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt, ResultMerger.kt, Ranking.kt, Filtering.kt,
#   backend/src/main/java/ai/helper2/search/cache/RedisSearchCache.java,
#   backend/src/main/java/ai/helper2/platform/resilience/Resilience4jPolicies.java,
#   backend/src/main/java/ai/helper2/catalog/ResourceCatalog.java, catalog/internal/ObservationQueue.java.
# Render: cd docs/diagrams && d2 fmt sequence-0008-federated-search.d2 && d2 sequence-0008-federated-search.d2 sequence-0008-federated-search.svg

...@style

shape: sequence_diagram

browser: Browser {class: person}
ctl: SearchController {class: app}
fs: SearchResources {class: app}
cache: RedisSearchCache {class: app}
gh: GitHubSource {class: app}
idx: "CatalogSearchSource\n(helper2-index)" {class: app}
hf: "HuggingFaceModelsSource\n(slow today)" {class: app}
npm: "NpmSource\n(down for an hour)" {class: app}
merger: ResultMerger {class: app}
catalog: ResourceCatalog {class: app}

browser -> ctl: "GET /api/v1/search?q=mcp postgres" {class: hot}
ctl -> fs: "search(SearchRequest)" {class: hot}

start: Start every source (own start time) {
  fs -> cache: "get(h2:v1:src:github:…)"
  cache -> fs: "miss"
  fs -> gh: "search(query) on a virtual thread" {class: hot}
  fs -> idx: "search(query) on a virtual thread" {class: hot}
  fs -> cache: "get(h2:v1:src:hf-models:…)"
  cache -> fs: "entry, 3 h old (older than 30 min)"
  fs -> hf: "search(query) on a virtual thread"
  fs -> cache: "get(h2:v1:src:npm:…)"
  cache -> fs: "entry, 2 h old"
  fs -> fs: "call(source-npm, …):\ncircuit OPEN, CallRefused"
}

collect: Collect, each until its own deadline {
  gh -> fs: "hits (within 2500 ms)" {class: hot}
  fs -> cache: "put(entry, TTL 24 h)"
  idx -> fs: "rows as hits (within 3 s)" {class: hot}
  fs -> fs: "future.get times out\n(2500 ms after its start)"
  fs -> hf: "cancel(true)"
  fs -> fs: "TIMED_OUT, served STALE_CACHE\n(entry younger than 24 h)"
  fs -> fs: "npm: SKIPPED CIRCUIT_OPEN,\nno call, served STALE_CACHE"
}

fs -> merger: "merge(hits, contexts)" {class: hot}
merger -> fs: "merged results, conflicts kept,\ndates CONFLICTING if days differ"
fs -> catalog: "firstDiscovered(results): one read"
catalog -> fs: "first-seen dates"
fs -> catalog: "record(LIVE hits only)"
catalog -> catalog: "ObservationQueue.offer\n(write in background, or drop)"
fs -> fs: "rank, filter, sort, facets, page,\ncoverage.partial = true"
fs -> ctl: "SearchOutcome"
ctl -> browser: "200, Cache-Control: no-store\nsources[], coverage, notices" {class: hot}
