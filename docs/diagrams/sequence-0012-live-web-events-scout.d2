# Sequence: a weekly pass of the live web events scout that keeps one hackathon, and a visitor who sees it in Coming up.
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/LiveWebEventsCollector.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/events/SpringAiEventReader.java, EventQuoteGate.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/ScoutLiveWebCredits.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcCatalogWriter.java (upsert), ProjectedReconciliation.java (event days), JdbcResources.java (upcomingEvents),
#   backend/libs/core/src/main/java/ai/helper2/search/web/CardMapper.java, frontend/src/features/home/TermList.tsx.
# Render: cd docs/diagrams && d2 fmt sequence-0012-live-web-events-scout.d2 && d2 sequence-0012-live-web-events-scout.d2 sequence-0012-live-web-events-scout.svg

...@style

shape: sequence_diagram

scout: "Scout\n(live-web-events-scout)" {class: app}
credits: "Scout credits\n(Redis counters)" {class: data}
tavily: "Tavily\n/search, /extract" {class: ext}
model: "NVIDIA Nemotron\n(Nebius, EU)" {class: ext}
gate: "EventQuoteGate\n(code)" {class: app}
db: "PostgreSQL\n(catalog)" {class: data}
visitor: "Visitor" {class: person}
api: "GET /api/v1/events/upcoming" {class: app}

pass: Weekly pass {
  scout -> credits: "cap reached?"
  credits -> scout: "no (12 of 40 today)"
  scout -> tavily: "4 searches: upcoming AI hackathons, …"
  tavily -> scout: "titles, links, excerpts (+4 credits)"
  scout -> credits: "spent 4"
  scout -> tavily: "extract 4 pages (markdown)"
  tavily -> scout: "page text (+1 credit)"
  scout -> scout: "clean: hidden text out, emails and phones masked"
  scout -> model: "read this page (untrusted data)"
  model -> scout: "events 1, 2027-03-12..14,\n\"When: 12–14 March 2027\", HACKATHON + quote"
  scout -> gate: "check page, reading, today"
  gate -> scout: "kept: quote on the page,\ncode reads 12–14 March 2027, same days,\nwithin 6 months"
  scout -> db: "upsert EVENT, extra.eventEvidence\n(quote, model, prompt version)"
  db -> db: "event days of the card: AI-read days only\nwhen no other record states a start"
}

view: Coming up {
  visitor -> api: "next 90 days"
  api -> db: "upcomingEvents"
  db -> api: "the hackathon, its start from live-web-events-scout"
  api -> visitor: "card: eventOrigin AI_EXTRACTED"
  visitor -> visitor: "row shows \"Extracted by AI\";\ndate, kind and place carry data-ai-generated" {class: hot}
}
