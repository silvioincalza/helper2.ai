# Sequence: one indexer tick under the cluster lock embedding-indexer, then one search through the semantic source.
# Shows the calls to the NVIDIA API catalog (passage vs query), the pgvector writes and the HNSW query.
# Source of truth: backend/src/main/java/ai/helper2/catalog/internal/EmbeddingIndexer.java, NvidiaEmbedder.java,
#   backend/src/main/java/ai/helper2/catalog/CatalogConfiguration.java (IndexerSchedule),
#   backend/src/main/java/ai/helper2/platform/ClusterLock.java,
#   backend/src/main/java/ai/helper2/catalog/internal/ResourceStore.java,
#   backend/src/main/java/ai/helper2/catalog/SemanticSearchSource.java, QueryVectorCache.java,
#   backend/src/main/java/ai/helper2/platform/cache/JdbcSharedCache.java,
#   backend/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt, Ranking.kt.
# Render: cd docs/diagrams && d2 fmt sequence-0012-vector-search-pgvector.d2 && d2 sequence-0012-vector-search-pgvector.d2 sequence-0012-vector-search-pgvector.svg

...@style

shape: sequence_diagram

sched: "IndexerSchedule\n(fixed delay 15 s)" {class: app}
lock: "ClusterLock\nembedding-indexer" {class: app}
idxr: EmbeddingIndexer {class: app}
fs: SearchResources {class: app}
sem: SemanticSearchSource {class: app}
emb: NvidiaEmbedder {class: app}
nv: "NVIDIA API catalog\n/v1/embeddings" {class: ai}
store: ResourceStore {class: app}
pg: "PostgreSQL\n(pgvector, ai_cache)" {class: data}

tick: Indexer tick {
  sched -> lock: "tryRun(indexer::tick)"
  lock -> pg: "take row in shedlock\nwhere lock_until <= db now"
  pg -> lock: "taken (if not: skip\nthis period)"
  lock -> idxr: "tick()"
  idxr -> store: "pendingEmbeddings(model, 50)"
  store -> pg: "resources without a current vector,\nORDER BY popularity DESC"
  pg -> store: "rows"
  store -> idxr: "50 tasks (text, md5)"
  idxr -> emb: "embed(texts, PASSAGE)" {class: ai-call}
  emb -> nv: "POST input_type=passage, dimensions=1024,\ntruncate=END (buffered body)" {class: ai-call}
  nv -> emb: "50 vectors" {class: ai-call}
  emb -> idxr: "vectors (count and size checked)"
  idxr -> store: "saveEmbeddings(model, tasks, vectors)"
  store -> pg: "delete other models' vectors;\nupsert resource_embedding"
  idxr -> store: "embeddingCoverage(model)"
  idxr -> idxr: "backlog = total − embedded;\nlast.success = now"
  idxr -> lock: "done"
  lock -> pg: "release: lock_until =\nlocked_at + 13.5 s"
}

query: One search {
  fs -> sem: "search(query as typed), deadline 3 s" {class: hot}
  sem -> pg: "SELECT query-vector, sha256(model, query),\nnot expired (db-cache, ≤ 1 s)"
  pg -> sem: "miss"
  sem -> emb: "embed([text], QUERY)" {class: ai-call}
  emb -> nv: "POST input_type=query" {class: ai-call}
  nv -> emb: "1 vector" {class: ai-call}
  emb -> sem: "vector"
  sem -> pg: "upsert Base64 floats,\nexpires in 7 days"
  sem -> store: "semanticSearch(vector, model,\norigins, 30, 0.65)" {class: hot}
  store -> pg: "SET LOCAL hnsw.iterative_scan\n= relaxed_order" {class: hot}
  store -> pg: "ORDER BY embedding <=> :v\n(HNSW), distance ≤ 0.65" {class: hot}
  pg -> store: "nearest rows"
  store -> pg: "labels + popularity (2 queries)"
  store -> sem: "rows with facts"
  sem -> fs: "SourceHit list, rank = distance order" {class: hot}
  fs -> fs: "merge with keyword hits;\nRanking adds 1/(60+rank+1)"
}
