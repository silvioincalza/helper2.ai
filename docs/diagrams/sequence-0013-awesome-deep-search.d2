# Sequence: a Scout pass that reads an added web page, follows a nested awesome list and sends each link of an entry to the rule of its kind.
# Source of truth: backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/RunScout.kt,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/GitHubAwesomeCollector.java, AwesomeCrawl.java, ListEntryLinks.java, ProductLinks.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/huggingface/scout/HuggingFaceModelReader.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/arxiv/scout/ArxivPaperReader.java, sources/npm/scout/NpmPackageReader.java,
#   backend/libs/platform/src/main/java/ai/helper2/platform/resilience/RedisOutboundThrottle.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/liveweb/scout/CoursePages.java,
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/ListSeeds.kt (ListSeedStore, ListReading, HostsNeverRead), scout/internal/JdbcListSeedStore.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/WebPageLists.java, WebPageReader.java, libs/core sources/config/CollectorDescriptors.java (curatedWebLists),
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/evidence/LiveWebPageReader.java, sources/liveweb/scout/ScoutLiveWebCredits.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java, ResourceCandidateJson.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/ReviewQueue.java (candidatesOpenedToday),
#   backend/libs/core/src/main/java/ai/helper2/catalog/usecase/IndexAwesomeLists.java, RefreshCategories.java, catalog/internal/JdbcCategoryLabels.java.
# Render: cd docs/diagrams && d2 fmt sequence-0013-awesome-deep-search.d2 && d2 sequence-0013-awesome-deep-search.d2 sequence-0013-awesome-deep-search.svg

...@style

shape: sequence_diagram

scout: RunScout {class: app}
collector: "GitHubAwesomeCollector\n+ AwesomeCrawl" {class: app}
pages: "WebPageLists" {class: app}
reader: "Live web page reader" {class: ext}
github: "api.github.com" {class: ext}
hub: "huggingface.co" {class: ext}
arxiv: "export.arxiv.org" {class: ext}
npm: "registry.npmjs.org" {class: ext}
redis: Redis {class: data}
catalog: "IndexResources /\nIndexAwesomeLists" {class: app}
review: "ReviewQueueCandidateReview" {class: app}
pg: PostgreSQL {class: data}

scout -> collector: "collect(cursor, 500)"
collector -> pg: "list_seed: the lists an administrator added"
pg -> collector: "small/llm-links (read first),\na web page with its last try"
collector -> pages: "read(budget)"
pages -> pages: "host not in the never-read setting;\nlast try 7 days ago or never;\nthe Scout's daily credits not spent"
pages -> pg: "list_seed: read_tried_at = now,\nread_failures + 1"
pages -> reader: "the page address (1 credit,\nscout-list-pages)"
reader -> pages: "the page as Markdown"
pages -> pg: "read_failures = 0; replace list_seed_last_read:\nheadings, entries, links, counts (never the text)"
pages -> collector: "the page as a seed: entries,\nheadings, links"
collector -> github: "GET /search/repositories (topic pairs)"
github -> collector: "seed lists with their facts"
collector -> github: "GET /repos/small/llm-links (an added list\nthe search did not find)"
github -> collector: "found, not archived"
collector -> github: "GET /repos/{seed}/readme"
github -> collector: "Markdown: entries, a section \"Related lists\",\nlinks to a model, a paper, a package,\na course, a product site"
collector -> github: "GET /repos/{nested} (facts)"
github -> collector: "alive, 700 stars, about AI"
collector -> github: "GET /repos/{nested}/readme"
github -> collector: "Markdown (a link back to the seed:\nalready read, not followed)"
collector -> github: "POST /graphql (facts of the entries)"
collector -> collector: "ListEntryLinks: each link by its kind;\nProductLinks: the safety checks;\nCategoryMatcher: tags from the heading"
collector -> hub: "GET /api/models/{owner}/{name}\n(at most 100 a pass)"
hub -> collector: "likes, tags, licence, dates, disabled"
collector -> redis: "SET h2:v1:outbound:arxiv NX PX 3000\n(the slot all machines share; wait 3 s\nand try again, at most 5 times)"
collector -> arxiv: "GET /api/query?id_list=… (50 ids a call,\nat most 200 papers a pass)"
arxiv -> collector: "Atom: title, summary, categories, dates"
collector -> npm: "GET /{name}/latest\n(at most 100 a pass)"
npm -> collector: "name, description, keywords,\nlicence, repository, deprecated"
collector -> scout: "CollectedBatch: hits + the lists read\n(2 GitHub lists, the web page) + MODEL, PAPER\nand package hits,\nlist texts, candidates (COURSE, PRODUCT,\nMODEL under 10 likes), newCandidatesPerDay = 50"
scout -> catalog: "index(merged hits) for github-awesome,\nthen for curated-web-lists (alsoWrites):\nthe web page's list resource"
catalog -> pg: "upsert resources; categories\nfrom title, records, headings"
scout -> catalog: "replace(list texts)"
catalog -> pg: "per list: entry rows with heading path;\nassign the entries' categories again"
scout -> review: "propose(github-awesome, candidates, 50)"
review -> pg: "candidatesOpenedToday(RESOURCE_CANDIDATE and\nCOURSE_CANDIDATE, github-awesome)"
pg -> review: "items opened since 00:00 UTC"
review -> pg: "INSERT review_item (COURSE_CANDIDATE for a course),\nor (already proposed) merge into the OPEN item:\nfoundBy += {github-awesome, awesome: {list, section}}"
