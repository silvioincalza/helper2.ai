# Sequence: a source drops a tag, the catalog rebuilds the labels, and the next card no longer shows the flag.
# Shows the write path (ResourceStore.upsert → replaceLabels) and the read path (CardMapper → Compatibility).
# Source of truth: backend/src/main/java/ai/helper2/catalog/internal/ResourceStore.java (upsert, replaceLabels, withFacts),
#   backend/src/main/java/ai/helper2/catalog/CatalogSearchSource.java,
#   backend/src/main/java/ai/helper2/search/web/CardMapper.java, SearchController.java,
#   backend/src/main/kotlin/ai/helper2/search/Compatibility.kt.
# Render: cd docs/diagrams && d2 fmt sequence-0013-works-with-flags.d2 && d2 sequence-0013-works-with-flags.d2 sequence-0013-works-with-flags.svg

...@style

shape: sequence_diagram

writer: "Scout run or\nObservationQueue" {class: app}
store: ResourceStore {class: app}
pg: PostgreSQL {class: data}
css: CatalogSearchSource {class: app}
ctl: SearchController {class: app}
cm: CardMapper {class: app}
compat: Compatibility {class: app}

write: A source no longer tags the repo "ollama" {
  writer -> store: "upsert(results, origin, sources)"
  store -> pg: "upsert source_record\n(extra.tags without \"ollama\")"
  store -> pg: "replaceLabels: DELETE resource_label\nfor touched resources"
  store -> pg: "INSERT labels from current\nsource_record.extra (TAG ≤ 20)"
}

read: Next search {
  css -> store: "search(…)"
  store -> pg: "rows + resource_label + metrics"
  store -> css: "ResourceRow (tags without \"ollama\")"
  css -> ctl: "SourceHit (via SearchResources)"
  ctl -> cm: "card(result)" {class: hot}
  cm -> compat: "of(result)" {class: hot}
  compat -> compat: "TYPE rule, then tags per hit\n(normalized), first source wins"
  compat -> cm: "flags (no Ollama flag now)"
  cm -> ctl: "ResultCard.compatibleWith"
}
