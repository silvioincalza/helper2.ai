# Sequence: the second model call that checks each kept reason against its own evidence.
# Source of truth: backend/src/main/kotlin/ai/helper2/guide/usecase/ReasonCheckStep.kt (verdicts),
#   backend/src/main/java/ai/helper2/guide/internal/SpringAiGuideModel.java (verifyReasons, call),
#   backend/src/main/java/ai/helper2/guide/web/GuideStreamController.java (Events.reasonsChecked).
# Render: cd docs/diagrams && d2 fmt sequence-0016-guide-reason-check.d2 && d2 sequence-0016-guide-reason-check.d2 sequence-0016-guide-reason-check.svg

...@style

shape: sequence_diagram

svc: "AskGuide\n(ReasonCheckStep)" {class: app}
model: SpringAiGuideModel {class: app}
budget: DailyBudget "guide" {class: app}
tf: "Token Factory\n(reasoning model)" {class: ai}
events: "GuideStreamController\n.Events" {class: app}
browser: Browser {class: person}

svc -> svc: "ReasonClaim per kept pick:\nkey, reason, quote, text,\nconfirmed checks"
svc -> model: "verifyReasons(request, claims)"
model -> budget: "tryAcquire()"
budget -> model: "true"
model -> tf: "verify-reasons.txt + PICKS\n(<pick key=cN>, text as ‹ ›),\nthinking off, JSON schema" {class: ai-call}
tf -> model: "{verdicts: [{key, supported}]}"
model -> model: "drop unknown keys;\nsame key twice: both must be true"
model -> svc: "Map key → supported"
svc -> svc: "SUPPORTED / REMOVED;\nmissing key → NOT_CHECKED"
svc -> events: "reasonsChecked(supported,\nremoved, notChecked)"
events -> browser: "event: checked"
