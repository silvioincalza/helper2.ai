# Sequence: one run of the AI libraries and SDKs collector, from the search to an accepted resource (ADR 0018).
# Source of truth: backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/RunScout.kt,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/github/scout/GitHubSdkCollector.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/depsdev/PackageFinder.java, DepsDevClient.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java, ResourceCandidateJson.java,
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/IndexAcceptedCandidate.kt,
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcCatalogWriter.java (refreshPackageTerms).
# Render: cd docs/diagrams && d2 fmt sequence-0018-package-catalog.d2 && d2 sequence-0018-package-catalog.d2 sequence-0018-package-catalog.svg

...@style

shape: sequence_diagram

scout: RunScout {class: app}
collector: GitHubSdkCollector {class: app}
github: "api.github.com" {class: ext}
finder: PackageFinder {class: app}
depsdev: "api.deps.dev" {class: ext}
review: "ReviewQueueCandidateReview" {class: app}
pg: PostgreSQL {class: data}
admin: Admin {class: person}
accept: IndexAcceptedCandidate {class: app}

scout -> collector: "collect(checkpoint, cursor)"
collector -> github: "GET /search/repositories?q=topic:llm language:\"Java\"\nstars:>=1000 fork:false archived:false&sort=stars&per_page=100\n(token: read-only PAT)"
github -> collector: "repositories (name, description, language, stars, topics, owner)"
collector -> github: "… page 2, 3 (2 s apart) and the next queries;\nstop early when X-RateLimit-Remaining <= 10"
collector -> pg: "known? (catalog or proposed before);\nroom today (500 minus opened)"
collector -> finder: "packagesOf(owner/repo, language)\n(new repos within the room, official first)"
finder -> depsdev: "GET /v3/projects/github.com%2Fowner%2Frepo:packageversions\n(no token, no user data)"
depsdev -> finder: "package versions with provenance\n(404 plain text = none)"
finder -> depsdev: "GET /v3/systems/{S}/packages/{name}\nthen …/versions/{default}"
depsdev -> finder: "published date, licences, source repo"
finder -> collector: "packages that point back to the repo"
collector -> scout: "CollectedBatch(candidates, cursor or checkpoint,\nnewCandidatesPerDay = 500)"
scout -> review: "propose(github-sdks, candidates, 500)"
review -> pg: "review item JSON keeps facts.package\nof each finder"
admin -> accept: "accept item"
accept -> pg: "record of the opening source: licence, updated,\nextra.package (only for github-sdks)"
pg -> pg: "package_terms from the records;\nsearch_vector adds them at weight B"
