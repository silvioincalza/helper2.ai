# Sequence: one enrichment of a changed resource that ends PARTIAL and opens a review item.
# Source of truth: backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/EnrichResource.kt (EnrichResource.attempt),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/Enrichment.kt (EvidenceValidator),
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/SpringAiEnrichmentModel.java, CatalogEnrichmentStore.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/enrichment/EnrichmentCandidates.java, EnrichmentResults.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/JdbcEnrichmentCandidates.java, JdbcEnrichmentResults.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/ReviewQueue.java.
# Render: cd docs/diagrams && d2 fmt sequence-0019-evidence-gated-enrichment.d2 && d2 sequence-0019-evidence-gated-enrichment.d2 sequence-0019-evidence-gated-enrichment.svg

...@style

shape: sequence_diagram

runner: RunScout {class: app}
svc: EnrichResource {class: app}
store: CatalogEnrichmentStore {class: app}
candidates: "EnrichmentCandidates\n(catalog)" {class: app}
model: SpringAiEnrichmentModel {class: app}
budget: DailyBudget "enrichment" {class: app}
tf: "Token Factory\n(reasoning model)" {class: ai}
val: EvidenceValidator {class: app}
results: "EnrichmentResults\n(catalog)" {class: app}
review: ReviewQueue {class: app}

runner -> svc: "enrich(resourceId)"
svc -> store: "load(resourceId)"
store -> candidates: "candidate(resourceId)"
candidates -> store: "title, type, open source, licence;\nsource records: title, line break,\ndescription (byte-identical SQL)"
store -> svc: "materials (one per source record),\nsource facts, text hash"
svc -> svc: "fingerprintFor(model):\ntext hash + prompt version + model"
svc -> store: "lastFingerprint(resourceId)"
store -> candidates: "lastJudgedFingerprint(resourceId)"
store -> svc: "different (text changed)"
svc -> model: "propose(input)"
model -> budget: "tryAcquire()"
budget -> model: "true"
model -> tf: "enrich-v4 prompt;\n<material evidenceId=… kind=…> text as ‹ ›\n(4000 chars per record)" {class: ai-call}
tf -> model: "JSON: fields, relationships,\nsummary, each with citations"
model -> svc: "EnrichmentProposal"
svc -> store: "resourcesTitled(relationship targets)"
store -> candidates: "titled(lower-case titles ≥ 4 chars)"
store -> svc: "known titles → ids"
svc -> val: "validate(input, proposal)"
val -> svc: "ValidationResult: PARTIAL,\nerrors, checked items"
svc -> store: "save(run, result, PARTIAL)"
store -> results: "record(run, checked items)"
results -> results: "INSERT enrichment_run"
results -> review: "supersedeEnrichmentItems:\nolder OPEN items → SUPERSEDED"
results -> results: "DELETE AI_EXTRACTED field_assertion\nand unreviewed AI relationships;\nINSERT fields, relationships,\nclaims, evidence"
results -> review: "open(ENRICHMENT_VALIDATION, errors)"
svc -> runner: "PARTIAL"
