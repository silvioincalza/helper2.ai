# Sequence: one search and one Scout run under the vitality rule (ADR 0020).
# Source of truth: backend/libs/core/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt, SourceFanOut.kt (Run.collect, Run.admitted),
#   backend/libs/core/src/main/kotlin/ai/helper2/search/Vitality.kt,
#   backend/libs/core/src/main/kotlin/ai/helper2/search/Ranking.kt,
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/RunScout.kt (collect, indexable, proposable),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/admission/Admission.kt (AdmissionPolicy.decide),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/Ports.kt (CandidateSignals.statedOn),
#   backend/libs/core/src/main/java/ai/helper2/sources/huggingface/HuggingFaceSpacesSource.java, github/GitHubSource.java.
# Render: cd docs/diagrams && d2 fmt sequence-0020-resource-vitality.d2 && d2 sequence-0020-resource-vitality.d2 sequence-0020-resource-vitality.svg

...@style

shape: sequence_diagram

browser: Browser {class: person}
search: SearchResources {class: app}
source: "Live source\n(github, hf-spaces …)" {class: app}
policy: VitalityPolicy {class: app}
cache: Redis {class: data}
ranking: Ranking {class: app}
scout: RunScout {class: app}
admission: AdmissionPolicy {class: app}
collector: Collector {class: app}
catalog: Catalog {class: data}
review: "Review list" {class: data}
github: "api.github.com" {class: ext}

browser -> search: "GET /api/v1/search?q=remove image background"
search -> source: "SourceQuery"
source -> search: "hits, each with its facts\n(archived, fork, running …)" {class: hot}
search -> policy: "admitted(hits)" {class: hot}
policy -> search: "admitted hits, consecutive ranks\n(each refusal counted by reason)"
search -> search: "first 30 (per-source limit)"
search -> cache: "put the admitted hits"
search -> ranking: "rank(merged results)"
ranking -> policy: "isUnmaintained(result)"
policy -> ranking: "yes: score − 0.008"
ranking -> search: "ordered results"
search -> browser: "results"

scout -> collector: "collect(cursor)"
collector -> scout: "batch of hits with their facts,\ncandidates with their signals"
scout -> admission: "decide(hit, collector profile)"
admission -> policy: "refusalOf(hit)"
policy -> admission: "refusal or none"
admission -> scout: "Refuse (counted by reason), Review\n(under the floor of its collector) or Index"
scout -> catalog: "index the hits with the outcome Index,\nconsecutive ranks; what each states is\nstored (extra.vitality, statedAt)"
scout -> admission: "decide(candidate, with its stars,\nlast push, archived, fork)"
admission -> scout: "Refuse (counted by reason),\nor not refused"
scout -> review: "propose the candidates not refused"

scout -> github: "enrichment: visit the repository a record names or links\n(README + repository facts)"
github -> scout: "README, licence, archived"
scout -> catalog: "record archived + checkedAt\non the source record (extra.vitality),\nunless its source stated archived later"
catalog -> search: "later searches: index and semantic hits\nstate the stored facts (the source's and the\nvisit's, newest wins); the rule refuses them"
