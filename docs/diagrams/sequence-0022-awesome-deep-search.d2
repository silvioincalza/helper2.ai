# Sequence: a Scout pass that follows a nested awesome list and proposes a product site linked from a list.
# Source of truth: backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/RunScout.kt,
#   backend/apps/backoffice/src/main/java/ai/helper2/sources/github/GitHubAwesomeCollector.java, AwesomeCrawl.java, ProductLinks.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java, ResourceCandidateJson.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/ReviewQueue.java (candidatesOpenedToday),
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/usecase/IndexAwesomeLists.java, catalog/internal/ResourceStore.java.
# Render: cd docs/diagrams && d2 fmt sequence-0022-awesome-deep-search.d2 && d2 sequence-0022-awesome-deep-search.d2 sequence-0022-awesome-deep-search.svg

...@style

shape: sequence_diagram

scout: RunScout {class: app}
collector: "GitHubAwesomeCollector\n+ AwesomeCrawl" {class: app}
github: "api.github.com" {class: ext}
catalog: "IndexResources /\nIndexAwesomeLists" {class: app}
review: "ReviewQueueCandidateReview" {class: app}
pg: PostgreSQL {class: data}

scout -> collector: "collect(cursor, 500)"
collector -> github: "GET /search/repositories (topic pairs)"
github -> collector: "seed lists with their facts"
collector -> github: "GET /repos/{seed}/readme"
github -> collector: "Markdown: entries, a section\n\"Related lists\", links to product sites"
collector -> github: "GET /repos/{nested} (facts)"
github -> collector: "alive, 700 stars, about AI"
collector -> github: "GET /repos/{nested}/readme"
github -> collector: "Markdown (a link back to the seed:\nalready read, not followed)"
collector -> collector: "ProductLinks: keep the product's\nhome page; CategoryMatcher:\ntags from the section heading"
collector -> github: "POST /graphql (facts of the entries)"
collector -> scout: "CollectedBatch: hits + 2 list ARTICLEs,\nlist texts, candidates,\nnewCandidatesPerDay = 50"
scout -> catalog: "index(merged hits)"
catalog -> pg: "upsert resources; categories\nfrom title, records, headings"
scout -> catalog: "replace(list texts)"
catalog -> pg: "per list: entry rows with heading path;\nassign the entries' categories again"
scout -> review: "propose(github-awesome, candidates, 50)"
review -> pg: "candidatesOpenedToday(RESOURCE_CANDIDATE,\ngithub-awesome)"
pg -> review: "items opened since 00:00 UTC"
review -> pg: "INSERT review_item, or (already proposed)\nmerge into the OPEN item: foundBy +=\n{github-awesome, awesome: {list, section}}"
