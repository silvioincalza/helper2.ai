# Sequence: the owner signs in on /admin with GitHub, gets ADMIN by numeric id, and local bookmarks move to the account.
# Only possible where profile oauth-github is active (not on staging or prod today).
# Source of truth: backend/src/main/java/ai/helper2/identity/SecurityConfiguration.java, CurrentUser.java, MeController.java,
#   backend/src/main/java/ai/helper2/identity/internal/Users.java, Bookmarks.java,
#   frontend/src/pages/AdminPage.tsx, frontend/src/components/SignIn.tsx,
#   frontend/src/context/MeContext.tsx, BookmarksContext.tsx, frontend/src/api/client.ts.
# Render: cd docs/diagrams && d2 fmt sequence-0023-identity-and-admin.d2 && d2 sequence-0023-identity-and-admin.d2 sequence-0023-identity-and-admin.svg

...@style

shape: sequence_diagram

owner: Owner {class: person}
spa: "AdminPage /\nMeContext" {class: app}
sec: "Spring Security\n(SecurityConfiguration)" {class: app}
gh: GitHub {class: ext}
cu: CurrentUser {class: app}
users: Users {class: app}
me: MeController {class: app}
bm: Bookmarks {class: app}

owner -> spa: "open /admin"
spa -> me: "GET /api/v1/me"
me -> spa: "authenticated=false,\nloginProviders=[github]"
spa -> owner: "SignIn button (only here)"
owner -> sec: "GET /oauth2/authorization/github" {class: hot}
sec -> gh: "redirect, scope read:user" {class: hot}
gh -> sec: "/login/oauth2/code/github?code=…" {class: hot}
sec -> gh: "token + user info"
gh -> sec: "id 1234567, login, name"
sec -> sec: "oauthUsers: \"github:1234567\" in H2_ADMINS\n→ ROLE_USER + ROLE_ADMIN"
sec -> cu: "AuthenticationSuccessEvent"
cu -> users: "ensure(github, 1234567, name)"
users -> cu: "app_user id (upsert)"
sec -> owner: "302 to /admin (session cookie:\nHttpOnly, Secure, SameSite=Lax)"
owner -> spa: "load /admin"
spa -> me: "GET /api/v1/me"
me -> spa: "authenticated, roles [USER, ADMIN]"
spa -> me: "POST /api/v1/me/bookmarks (local list)\nX-XSRF-TOKEN" {class: hot}
me -> cu: "id()"
cu -> users: "find(github, 1234567)"
me -> bm: "add(user, items)"
bm -> bm: "INSERT … ON CONFLICT DO NOTHING;\ncount ≤ 500 or 400 + rollback"
me -> spa: "200 account list"
spa -> spa: "clear h2.bookmarks.v1"
