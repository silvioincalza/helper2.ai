# Sequence: a first visit to a client route, a search, a POST with the CSRF token, and a client over the limit.
# Shows the path through the Cloudflare tunnel, the forwarded address, the cache headers of the SPA fallback,
# the CSRF cookie and header, the limiter counting in Redis (shared by all replicas), and the 429.
# Source of truth: deploy/helm/helper2/templates/cloudflared.yaml, app.yaml,
#   backend/src/main/java/ai/helper2/platform/SinglePageApp.java, RateLimitInterceptor.java, RateLimiter.java,
#   RedisRateLimiter.java, ClientKey.java,
#   backend/src/main/java/ai/helper2/identity/SecurityConfiguration.java, frontend/src/api/client.ts.
# Render: cd docs/diagrams && d2 fmt sequence-0024-http-edge-protection.d2 && d2 sequence-0024-http-edge-protection.d2 sequence-0024-http-edge-protection.svg

...@style

shape: sequence_diagram

browser: Browser {class: person}
cf: "Cloudflare edge\n+ cloudflared" {class: ext}
tomcat: "Tomcat\n(forward headers native)" {class: app}
sec: "Security filters\n(CSRF, CSP)" {class: app}
rl: "RateLimitInterceptor\n(RedisRateLimiter)" {class: app}
redis: Redis {class: data}
spa: SinglePageApp {class: app}
ctl: Controllers {class: app}

visit: Direct visit to /sources {
  browser -> cf: "GET https://helper2.ai/sources" {class: hot}
  cf -> tomcat: "GET /sources, X-Forwarded-For: client" {class: hot}
  tomcat -> sec: "remoteAddr = client address"
  sec -> spa: "no controller matched"
  spa -> browser: "index.html, Cache-Control: no-cache,\nCSP, Set-Cookie XSRF-TOKEN" {class: hot}
  browser -> spa: "GET /assets/index-<hash>.js"
  spa -> browser: "max-age 1 year, public, immutable"
}

search: Search {
  browser -> sec: "GET /api/v1/search?q=…" {class: hot}
  sec -> rl: "preHandle (handler: search)"
  rl -> redis: "EVAL INCR, PEXPIRE 60000 ms:\nh2:v1:rate:search:20010db800010002::/64\n(client 2001:db8:1:2::5 → its /64)"
  redis -> rl: "[1, ms left] → allowed"
  rl -> ctl: "search(…)"
  ctl -> browser: "200, no-store" {class: hot}
}

post: Report a resource (POST) {
  browser -> sec: "POST /api/v1/resources/{id}/reports\nX-XSRF-TOKEN = cookie value"
  sec -> sec: "CSRF token matches"
  sec -> rl: "preHandle (reportResource, 20/hour)"
  rl -> redis: "EVAL INCR h2:v1:rate:report:…"
  redis -> rl: "count ≤ 20"
  rl -> ctl: "reportResource(…)"
  ctl -> browser: "202"
}

over: 61st search in the same minute {
  browser -> sec: "GET /api/v1/search?q=…"
  sec -> rl: "preHandle (handler: search)"
  rl -> redis: "EVAL INCR (same key)"
  redis -> rl: "[61, ms left] → 61 > 60"
  rl -> browser: "429 problem+json, Retry-After: seconds left"
}
