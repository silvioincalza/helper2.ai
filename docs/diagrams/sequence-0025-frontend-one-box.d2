# Sequence: the guide stream as the browser sees it, with the 45 s idle timeout and the retry.
# Shows fetch + SseParser (no EventSource, no automatic reconnect), the idle timer re-armed on every chunk
# (keep-alive comments included), the picks bar while the guide reads, a stream that goes quiet, the retry and the
# refinement, both asked again by useGuideStream from the URL.
# Source of truth: frontend/src/components/results/ResultsV2.tsx, frontend/src/components/guide/GuidePicks.tsx
#   (GuidePicks, guideError), frontend/src/components/guide/reading.ts (progressOf), frontend/src/components/ui/PicksBar.tsx,
#   frontend/src/hooks/useGuideStream.ts, frontend/src/lib/searchState.ts (askedRefinement, refinedParams),
#   frontend/src/api/client.ts (askGuideStream), frontend/src/lib/sse.ts, frontend/src/components/guide/GuideAnswer.tsx,
#   backend/src/main/java/ai/helper2/guide/web/GuideStreamController.java.
# Render: cd docs/diagrams && d2 fmt sequence-0025-frontend-one-box.d2 && d2 sequence-0025-frontend-one-box.d2 sequence-0025-frontend-one-box.svg

...@style

shape: sequence_diagram

user: User {class: person}
gs: "GuidePicks\n(ResultsV2)" {class: app}
hook: useGuideStream {class: app}
client: "api.askGuideStream\n(client.ts)" {class: app}
parser: SseParser {class: app}
server: "POST /api/v1/guide/stream\n(GuideStreamController)" {class: app}

user -> gs: "?q=…&ask=…[&clar=…&drop=…]" {class: hot}
gs -> hook: "useGuideStream()"
hook -> client: "askGuideStream({request, clarification?, drop?},\nonStep, signal) (one per request + attempt)" {class: hot}
client -> client: "arm idle timer (45 s)"
client -> server: "fetch POST, X-XSRF-TOKEN,\nAccept: text/event-stream" {class: hot}

normal: Normal stream {
  server -> client: "chunk: event planned" {class: ai-call}
  client -> client: "re-arm idle timer"
  client -> parser: "push(text)"
  parser -> client: "{event: planned, data}"
  client -> hook: "onStep(planned)"
  hook -> gs: "steps = [planned], busy"
  gs -> user: "picks bar, role=status: the guide is reading the results"
  server -> client: "event understood" {class: ai-call}
  client -> hook: "onStep(understood)"
  gs -> user: "role=status: … · Understood as <intent, subjects, period>\n(plain labels, no ✕ while it works)"
  server -> client: "event retrieved" {class: ai-call}
  client -> hook: "onStep(retrieved)"
  gs -> user: "role=status: the guide is reading N candidates"
  server -> client: "chunk: \":keep-alive\" comment\n(every 15 s while the question runs)"
  client -> client: "re-arm idle timer"
  client -> parser: "push(text)"
  parser -> client: "nothing (comments are ignored)"
  server -> client: "chosen, validated, checked" {class: ai-call}
  client -> hook: "onStep(…) for each"
  server -> client: "event answer" {class: ai-call}
  client -> hook: "resolve(GuideResponse)"
  hook -> gs: "answer"
  gs -> user: "picks bar: #1… chips (badges on the rows),\nor GuideAnswer when there is no pick;\nweb searches left today (from the first one used)"
}

quiet: Stream goes quiet {
  server -> client: "event planned, then nothing\n(not even a keep-alive comment)"
  client -> client: "45 s without a byte:\nidle = true, abort, cancel reader"
  client -> hook: "ApiError(stream = IDLE_TIMEOUT)"
  hook -> gs: "error"
  gs -> user: "role=alert: guide.streamFailure.IDLE_TIMEOUT\n+ Retry button"
}

other: Other failures {
  server -> client: "event error {status 503 busy | 504 deadline}"
  client -> hook: "ApiError(status, problem)"
  hook -> gs: "error"
  gs -> user: "role=alert: problem.detail + Retry"
  client -> hook: "MALFORMED (bad JSON) or\nENDED_EARLY (closed, no answer)"
}

retry: Retry (no automatic reconnect) {
  user -> gs: "click Retry"
  gs -> hook: "retry(): attempt + 1"
  hook -> client: "askGuideStream(same request) again" {class: hot}
  client -> server: "new POST (rate limit: 10/min,\nshared with POST /guide)" {class: hot}
}

refine: Refine (reply to the question back, or remove a part) {
  user -> gs: "click an option, or × on a part"
  gs -> hook: "refine({clarification} | {drop})"
  hook -> user: "URL: clar=… / drop=… added (refinedParams)"
  hook -> client: "abort the old stream;\naskGuideStream(refined request)" {class: hot}
}
