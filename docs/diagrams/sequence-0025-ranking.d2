# Sequence: ranking calls for one search, from the query analysis to the ranked list.
# Shows the index query in two stages inside PostgreSQL, the batched facts, and the fusion in Ranking.
# Source of truth: backend/libs/search/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt, QueryAnalyzer.kt, Ranking.kt,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/CatalogSearchSource.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/JdbcCatalogSearch.java, ResourceRows.java.
# Render: cd docs/diagrams && d2 fmt sequence-0025-ranking.d2 && d2 sequence-0025-ranking.d2 sequence-0025-ranking.svg

...@style

shape: sequence_diagram

fs: SearchResources {class: app}
qa: QueryAnalyzer {class: app}
css: CatalogSearchSource {class: app}
store: JdbcCatalogSearch {class: app}
pg: PostgreSQL {class: data}
live: "Live sources\n(GitHub, npm …)" {class: ext}
merger: ResultMerger {class: app}
ranking: Ranking {class: app}

fs -> qa: "analyze(text)" {class: hot}
qa -> fs: "typeHints, requiredVariants,\nsynonyms, expandedTerms"
fs -> live: "search(query)"
fs -> css: "search(query)" {class: hot}
css -> store: "search(text, variants, expansions,\nsynonyms, language, origins, 30)" {class: hot}

sql: One SQL statement (searchSql) {
  store -> pg: "matched: any word OR title % :raw\n(GIN full-text + GIN trigram)" {class: hot}
  pg -> pg: "pre: all words DESC,\npopularity + sim DESC, LIMIT 300"
  pg -> pg: "score = 2·all + popularity\n+ 0.5·min((ts_rank_cd·3 + sim)/10, 1)"
  pg -> store: "≤ 30 rows, best first"
}

store -> pg: "resource_label for all row ids"
store -> pg: "popularity metrics from\nsource_record.extra, all row ids"
store -> css: "ResourceRow list with labels\nand metrics"
css -> store: "statedEventFacts(rows): for events, the days, place,\nkind and format each source_record states"
css -> fs: "SourceHit list, rank = row order" {class: hot}
live -> fs: "SourceHit list, rank = API order"
fs -> merger: "merge(hits)"
merger -> fs: "MergedResult list"
fs -> ranking: "rank(results, text, path,\ntypeHints, first variant words)" {class: hot}
ranking -> ranking: "fusion 1/(60+rank+1) per source id\n+ title, path, type boosts (RankingWeights)\n+ 0.008 × popularity"
ranking -> ranking: "a need, not a name: the best result of the\nother lane (no path) or of the chosen\nlane (path) moves to place 2 or 1"
ranking -> fs: "sorted by score, title, id,\nlanes on top" {class: hot}
