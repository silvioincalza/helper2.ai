# Sequence: the prod deploy job of a release: approval, OIDC login to OpenBao, kubeconfig and app_env,
# tag checks, helm upgrade with rollback on failure, status, clean-up.
# Source of truth: .github/workflows/release.yml (prod job), .github/workflows/deploy.yml,
#   .github/actions/bao-login/action.yml, deploy/k8s/Makefile (diff, deploy, status),
#   deploy/k8s/terraform/rbac.tf (prod deployer may get the staging Deployment).
# Render: cd docs/diagrams && d2 fmt sequence-0028-ci-cd.d2 && d2 sequence-0028-ci-cd.d2 sequence-0028-ci-cd.svg

...@style

shape: sequence_diagram

reviewer: Prod reviewer {class: person}
gha: "GitHub Actions\n(release.yml)" {class: ext}
runner: "Self-hosted runner\n(one JIT job)" {class: app}
bao: OpenBao {class: data}
k8s: Kubernetes API {class: ext}
site: "https://helper2.ai" {class: ext}

approval: Approval {
  gha -> reviewer: "release vX.Y.Z checked and published;\njob prod waits on environment prod"
  reviewer -> gha: "approve"
  gha -> runner: "run deploy.yml\n(environment prod, tag = the release commit[0:12])" {class: hot}
}

login: OpenBao login (OIDC) {
  runner -> gha: "request OIDC token\n(audience = OpenBao address)"
  gha -> runner: "JWT, sub ...:environment:prod"
  runner -> bao: "auth/helper2/jwt/login role=deploy-prod"
  bao -> runner: "token (can read ci/prod only)"
  runner -> bao: "kv get ci/prod field kubeconfig"
  bao -> runner: "prod deployer kubeconfig"
}

tag: Resolve tag {
  runner -> runner: "tag = 12 hex chars;\nno ref with that name;\ncommit on origin/main"
  runner -> runner: "git checkout <commit>:\nchart and image match"
  runner -> bao: "kv get ci/prod field app_env"
  bao -> runner: "prod/app.env"
}

deploy: Deploy {
  runner -> k8s: "make diff (kubectl diff)"
  runner -> k8s: "make deploy: helm upgrade --install\n--server-side --wait --timeout 6m\n--rollback-on-failure" {class: hot}
  k8s -> runner: "ready, or rolled back\nto the previous revision"
  runner -> site: "make status: GET / → HTTP code"
  runner -> runner: "always: rm app.env, kubeconfig"
}
