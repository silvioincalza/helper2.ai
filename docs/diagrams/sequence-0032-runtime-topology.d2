# Sequence: the runtime paths of the hosted chart: a visitor's request through Cloudflare and ingress-nginx, the
# probes and the metrics scrape on the management port, the Postgres and Redis probes and the restart they
# trigger, an old pod leaving in a rolling update, and the nightly backup on prod with its verification gate.
# Source of truth: deploy/helm/helper2/templates/app.yaml, postgres.yaml, redis.yaml, backup.yaml, networkpolicy.yaml,
#   values-prod.yaml; the edge (tunnel, DNS, Ingresses) is in incalza-me-infra.
# Render: cd docs/diagrams && d2 fmt sequence-0032-runtime-topology.d2 && d2 sequence-0032-runtime-topology.d2 sequence-0032-runtime-topology.svg

...@style

shape: sequence_diagram

user: Visitor {class: person}
cf: "Cloudflare edge\n(TLS, platform tunnel)" {class: ext}
nginx: "ingress-nginx\n(Ingress helper2-public)" {class: ext}
app: "helper2 pod\n(:8080 site and API,\n:8081 Actuator)" {class: app}
pg: "postgres\n(StatefulSet)" {class: data}
redis: "redis\n(StatefulSet, AOF)" {class: data}
obs: "kubelet probes;\nAlloy scrape\n(ns observability)" {class: ext}
backup: "pg-backup\n(CronJob, prod)" {class: app}

request: One request {
  user -> cf: "HTTPS helper2.ai" {class: hot}
  cf -> nginx: "through the platform's tunnel"
  nginx -> app: "plain HTTP to Service helper2:80\n→ pod 8080 (ingress-app)" {class: hot}
  app -> redis: "AUTH requirepass, then\ncache, limits, sessions (6379)"
  app -> pg: "JDBC 5432 (pool 10)"
  pg -> app: "rows"
  app -> nginx: "response"
  nginx -> cf: "response"
  cf -> user: "HTTPS response" {class: hot}
}

management: Management port, never through an Ingress {
  obs -> app: "startup (≤ 300 s), readiness 5 s,\nliveness 10 s: /actuator/health on 8081"
  obs -> app: "GET /actuator/prometheus on 8081\n(Alloy, namespace observability)"
}

stores: Postgres and Redis probes (postgres.yaml, redis.yaml) {
  obs -> pg: "startup: pg_isready every 5 s, up to 10 min\n(exit 1 while the log replays after a crash)"
  obs -> pg: "then readiness 5 s; liveness every 20 s:\n6 failures (2 min) restart the container"
  obs -> redis: "readiness: PING answers PONG (not while the AOF loads);\nliveness after 30 s: PONG or LOADING, every 20 s,\n6 failures restart the container"
  obs -> pg: "kubelet restarts a hung server;\nthe volume and its data stay" {class: hot}
}

shutdown: An old pod leaves (rolling update, app.shutdown) {
  obs -> app: "kubelet: preStop sleep 10 s;\nthe pod still serves"
  obs -> nginx: "the pod leaves the Service endpoints;\nthe controller stops sending to it"
  obs -> app: "SIGTERM"
  app -> app: "graceful shutdown: no new connections,\nrequests in flight get 30 s (H2_SHUTDOWN_TIMEOUT)"
  obs -> app: "SIGKILL only after 45 s\n(terminationGracePeriodSeconds)"
}

nightly: 02:30 Europe/Zurich, prod {
  backup -> pg: "pg_dump --no-owner | gzip (pipefail:\na failed dump fails the Job)"
  pg -> backup: "dump, into helper2-<date>.sql.gz.tmp\non the pg-backup volume (NFS)"
  backup -> backup: "gzip -t reads it back whole, and it is\nbigger than an empty dump: else the Job fails\nand the old dumps stay" {class: hot}
  backup -> backup: "mv .tmp into place, then delete\ndumps older than 7 days"
}
