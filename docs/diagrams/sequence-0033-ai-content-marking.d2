# Sequence: one guide question, and how its answer reaches the page marked as AI-written; then one non-English
# search, and how the model's translation of the query reaches the page apart from the word-list terms; then one
# resource page with values a model read.
# Shows the streamed answer event carrying aiContent, interpretation.translatedQuery, the aiContent of a search
# response and of a resource, and the attributes and labels the browser adds per AI-written element.
# Source of truth: backend/apps/public/src/main/java/ai/helper2/guide/web/GuideStreamController.java, GuideDtoMapper.java,
#   frontend/src/api/client.ts (askGuideStream), frontend/src/features/guide/GuideAnswer.tsx, frontend/src/lib/aiMark.ts,
#   backend/libs/core/src/main/java/ai/helper2/search/web/SearchController.java, backend/libs/core/src/main/kotlin/ai/helper2/search/QueryAnalyzer.kt,
#   frontend/src/features/search/Results.tsx,
#   backend/apps/public/src/main/java/ai/helper2/catalog/web/ResourceDetailController.java (aiContent),
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcEnrichmentResults.java (the run's model),
#   frontend/src/features/resource/Resource.tsx, ResourcePage.tsx.
# Render: cd docs/diagrams && d2 fmt sequence-0033-ai-content-marking.d2 && d2 sequence-0033-ai-content-marking.d2 sequence-0033-ai-content-marking.svg

...@style

shape: sequence_diagram

user: "User" {class: person}
spa: "GuideAnswer\n(browser)" {class: app}
ctl: GuideStreamController {class: app}
guide: AskGuide {class: app}
llm: "Nemotron\n(Nebius)" {class: ai}
map: GuideDtoMapper {class: app}
search: "SearchController\n+ SearchResources" {class: app}
detail: "ResourceDetailController\n+ GetResourceDetail" {class: app}

ask: One guide question {
  user -> spa: "asks the guide"
  spa -> ctl: "POST /api/v1/guide/stream"
  ctl -> guide: "answer(request)"
  guide -> llm: "plan" {class: ai-call}
  llm -> guide: "search terms, requirements"
  guide -> ctl: "planned(searchQuery, constraints)"
  ctl -> spa: "event: planned, aiContent:\nfast model, searchQuery, constraints[]"
  guide -> llm: "choose, check" {class: ai-call}
  llm -> guide: "picks and reasons"
  guide -> ctl: "GuideAnswer (modelUsed = true)"
  ctl -> map: "toDto(answer)" {class: hot}
  map -> map: "aiContent: provider, models,\nthe AI-written fields it holds, policy /mission;\nno QUERY_EXPANDED, no AI-origin description"
  map -> ctl: "GuideResponse with aiContent"
  ctl -> spa: "event: answer" {class: hot}
}

show: The page {
  spa -> spa: "section: data-ai-provider, data-ai-models"
  spa -> spa: "each reason, cell, sentence, query:\ndata-ai-generated=\"true\""
  spa -> spa: "quotes, titles, links: no attribute"
  spa -> user: "answer with visible AI labels"
}

translate: One non-English search {
  user -> spa: "searches in Italian"
  spa -> search: "GET /api/v1/search"
  search -> llm: "translate the query" {class: ai-call}
  llm -> search: "English query"
  search -> search: "translatedQuery = translation;\nexpandedTerms = word-list terms only"
  search -> search: "aiContent: provider, the fast model,\ninterpretation.translatedQuery and each\nAI-written value of a result; null with none"
  search -> spa: "SearchResponse.interpretation,\nSearchResponse.aiContent" {class: hot}
  spa -> spa: "\"Also searched for\": translation with\ndata-ai-generated, data-ai-model and\n\"Translated by AI\"; data-ai-provider on its line;\nword-list terms \"not AI\", unmarked"
}

resource: One resource page {
  user -> spa: "opens a resource"
  spa -> detail: "GET /api/v1/resources/{id}"
  detail -> detail: "assertions and relationships\nwith the model of their run"
  detail -> detail: "aiContent: provider, the runs' models,\ncard, assertions[], relationships[],\nsummary.claims[] a model wrote or read;\nnull with none"
  detail -> spa: "ResourceDetail.aiContent" {class: hot}
  spa -> spa: "page: data-ai-provider, data-ai-models;\neach AI value: data-ai-generated\nand its label"
}
