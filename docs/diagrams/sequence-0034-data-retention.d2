# Sequence: the daily catalog purge on a cluster of replicas: one replica takes the lock and runs the rules in order,
# the others skip; the Scout, identity, search and guide purges run the same way under their own locks.
# Source of truth: backend/src/main/java/ai/helper2/catalog/CatalogRetentionSchedule.java, catalog/usecase/PurgeExpiredData.java,
#   catalog/internal/CatalogRetention.java, platform/ClusterLocks.java (keptAlive, tryRun),
#   backend/src/main/java/ai/helper2/scout/internal/ScoutRetentionSchedule.java, identity/IdentityRetentionSchedule.java,
#   search/config/SearchRetentionSchedule.java, guide/internal/GuideRetentionSchedule.java.
# Render: cd docs/diagrams && d2 fmt sequence-0034-data-retention.d2 && d2 sequence-0034-data-retention.d2 sequence-0034-data-retention.svg

...@style

shape: sequence_diagram

r1: "CatalogRetentionSchedule\n(replica 1)" {class: app}
r2: "CatalogRetentionSchedule\n(replica 2)" {class: app}
lock: "ClusterLock\nretention-catalog" {class: app}
purge: "PurgeExpiredData\n(catalog.usecase)" {class: app}
sql: "CatalogRetention\n(catalog.internal)" {class: app}
pg: Postgres {class: data}

daily: "03:17 UTC (helper2.retention.cron)" {
  r1 -> lock: "tryRun(purge)" {class: hot}
  lock -> pg: "take lock (shedlock row)"
  pg -> lock: "taken, kept alive"
  r2 -> lock: "tryRun(purge)"
  lock -> r2: "held elsewhere: skip"
  lock -> purge: "purge()" {class: hot}
  purge -> sql: "deleteReviewItemsResolvedBefore(now − 180 d)"
  purge -> sql: "deleteIssueReportsResolvedBefore(now − 365 d)"
  purge -> sql: "deleteEnrichmentRunsStartedBefore(now − 90 d)"
  purge -> sql: "deleteWebNewsRetrievedBefore(now − 180 d)"
  purge -> sql: "deleteEventsEndedBefore(now − 365 d)"
  purge -> sql: "deleteObservedUnseenSince(now − 180 d)"
  sql -> pg: "DELETE … AND NOT EXISTS\n(issue_report, review_item)"
  pg -> pg: "ON DELETE CASCADE / SET NULL"
  pg -> sql: "rows deleted"
  sql -> purge: "counts"
  purge -> purge: "log catalog retention: Purged(…)"
  purge -> lock: "done"
  lock -> pg: "release"
}

failure: A failed purge {
  r1 -> r1: "RuntimeException: log.warn,\nthe next day's run catches up"
}
