# Sequence: the owner signs in on the admin host and opens the review queue; the same id on the public host is a plain
# user, and the back office is not there (ADR 0035, 0069).
# Source of truth: backend/apps/backoffice/src/main/java/ai/helper2/identity/config/BackOfficeSecurityConfiguration.java,
#   BackOfficeEdge.java, backend/apps/public/src/main/java/ai/helper2/identity/config/PublicSecurityConfiguration.java (NoBackOfficeHere),
#   backend/libs/identity/src/main/java/ai/helper2/identity/config/WebSecurity.java (oauthUsers, roles),
#   backend/libs/platform/src/main/java/ai/helper2/platform/AdminHost.java, RateLimitInterceptor.java (clientKey),
#   frontend/src/components/SignIn.tsx, Layout.tsx (SignInReturn), frontend/src/lib/signInReturn.ts,
#   the platform repo (helper2-admin Ingress, whitelist-source-range), outside this repo.
# Render: cd docs/diagrams && d2 fmt sequence-0035-admin-host.d2 && d2 sequence-0035-admin-host.d2 sequence-0035-admin-host.svg

...@style

shape: sequence_diagram

owner: "Owner\n(on the VPN)" {class: person}
nginx: "ingress-nginx\n(allow-list)" {class: app}
apub: "Public app" {class: app}
abo: "Back office app" {class: app}
gh: GitHub {class: ext}

adminhost: Admin host {
  owner -> nginx: "GET admin.helper2.ai/admin" {class: hot}
  nginx -> abo: "private address: allowed" {class: hot}
  abo -> owner: "admin web app, not signed in"
  owner -> abo: "/oauth2/authorization/github"
  abo -> owner: "302 to GitHub, callback pinned to\nH2_ADMIN_BASE_URL/login/oauth2/code/github"
  owner -> gh: "sign in"
  gh -> owner: "302 back with code"
  owner -> abo: "callback"
  abo -> gh: "token + user info" {class: ai-call}
  abo -> abo: "id allow-listed: ROLE_ADMIN;\n__Host-SESSION in its own Redis namespace"
  abo -> owner: "302 /admin"
  owner -> abo: "GET /api/v1/me: sets __Host-XSRF-TOKEN"
  owner -> abo: "PUT /api/v1/admin/review-items/{id}/resolution\n(Origin, X-XSRF-TOKEN)"
  abo -> owner: "200"
  owner -> abo: "GET /api/v1/search?q=…"
  abo -> abo: "rate limit key admin-host-user-<login>,\nnot the forwarded address"
  abo -> owner: "200, or 429 over the limit"
}

publichost: Public host {
  owner -> apub: "GET helper2.ai/api/v1/admin/review-items"
  apub -> owner: "404 (no back office here)"
  owner -> apub: "Sign in with GitHub (the sign-in page or Saved);\nthe page stays in sessionStorage"
  apub -> owner: "ROLE_USER only, 302 /"
  owner -> owner: "SPA opens the stored page again\n(a path on this site only)"
}
