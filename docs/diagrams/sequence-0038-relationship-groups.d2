# Sequence: an admin marks every open candidate that names Cursor as a service, in one click.
# Source of truth: frontend/src/admin/RelationshipGroups.tsx,
#   backend/apps/backoffice/src/main/java/ai/helper2/admin/web/RelationshipTargetsController.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/admin/usecase/DecideRelationshipTargetGroup.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/admin/usecase/DecideRelationshipItem.java,
#   backend/libs/core/src/main/java/ai/helper2/catalog/internal/JdbcRelationshipTargets.java.
# Render: cd docs/diagrams && d2 fmt sequence-0038-relationship-groups.d2 && d2 sequence-0038-relationship-groups.d2 sequence-0038-relationship-groups.svg

...@style

shape: sequence_diagram

person: "Admin" {class: person}
ui: "Back office\n(RelationshipGroups)" {class: app}
api: RelationshipTargetsController {class: app}
group: DecideRelationshipTargetGroup {class: app}
item: "DecideRelationshipItem\n(one transaction per item)" {class: app}
db: "PostgreSQL\n(review_item, relationship,\nknown_target, admin_audit)" {class: data}

person -> ui: "It is a service (117 items)"
ui -> api: "POST /admin/relationship-targets/decision\n{key: cursor, decision: SERVICE}"
api -> group: "decide(cursor, Known(SERVICE), admin)"
group -> db: "open candidates named cursor, oldest first, at most 1000"
group -> db: "add known target Cursor (SERVICE), ADD_KNOWN_TARGET"
group -> item: "confirmKnown(item, admin, batch), for each item"
item -> db: "lock item; relationship VERIFIED (SERVICE);\nitem SUPERSEDED"
item -> db: "RESOLVE_REVIEW_ITEM SUPERSEDED bulk:<batch>"
group -> db: "count open candidates named cursor"
group -> api: "batch, decided 117, skipped 0, left 0"
api -> ui: "200"
ui -> person: "Cursor: 117 items decided, 0 skipped, 0 left."
