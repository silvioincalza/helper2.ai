# Sequence: the design system on a phone: Home with the radar and the two lists as tabs, a scroll that
# folds the title while the box stays pinned, the lists moving like a news ticker, a question asked with Ask the guide
# (with today's AI answers in sight), and a search that waits for Ask the guide.
# Code: frontend/src/features/home/Home.tsx, features/home/HomeRadar.tsx, radarClock.ts, useRadarMotion.ts, TermList.tsx, ticker.ts, HomeTabs.tsx,
#   homeFeeds.ts, features/guide/GuideAnswersLeft.tsx,
#   lib/sourceCounts.ts, features/search/HomeOrResultsPage.tsx, features/search/Results.tsx, ResultRow.tsx, Resource.tsx.
# Source of truth: docs/adr/frontend/0040-design-system.md, docs/design/system/README.md.
# Render: cd docs/diagrams && d2 fmt sequence-0040-design-system.d2 && d2 sequence-0040-design-system.d2 sequence-0040-design-system.svg

...@style

shape: sequence_diagram

user: User {class: person}
home: "Home\n(title, radar, pinned box,\nlists as tabs)" {class: app}
api: "GET /api/v1/sources, /me,\n/recent, /events/upcoming" {class: ext}
page: "Results\n(one column, loaded on demand)" {class: app}
resource: "Resource page" {class: app}
search: "GET /api/v1/search" {class: ext}
guide: "POST /api/v1/guide/stream\n(SSE)" {class: ext}

landing: Home {
  user -> home: "/"
  home -> api: "sources, me, news, events?days=90 (once each)"
  api -> home: "sources (shortName, external, newThisWeek),\nlimits, preferences, rows, totals"
  home -> user: "helper2.ai, the title, a quarter radar in the corner,\nbox, 2-3 of N sources at a time,\n> new in the catalog N | coming up N" {class: hot}
  home -> user: "2 sources, 0.6 s apart; then every 1.6 s the next of the queue\ncomes or the oldest leaves; each lights up as the sweep passes\n(still, 3 dots: reduced motion or motion off)"
  user -> home: "moves the mouse over the radar"
  home -> user: "the clock stops: beam and dots hold still\n(they run again when the mouse or the focus leaves; no button)"
  user -> home: "scrolls 24 px"
  home -> user: "title and radar fold away,\nthe box stays pinned"
  user -> home: "scrolls through the list"
  home -> user: "the tabs stay under the pinned box\n(its height measured) until the list ends"
  home -> user: "a list with more rows than it shows: every 4 s\none row leaves at the top, the next comes in\n(still under reduced motion or motion off; no Pause button)"
  home -> user: "the list holds while the page scrolls,\nand moves again a second after"
  user -> home: "moves the mouse over the list, tabs into it, or taps it"
  home -> user: "the list stands still until the mouse or the focus leaves,\nor a second tap (off screen or a hidden tab hold it too)"
}

question: A question {
  user -> page: "/search?q=translate my newsletter\ninto Italian for free"
  page -> user: "h1 and box at once, skeleton rows\nuntil the results view loads"
  page -> search: "search"
  search -> page: "results, facets, coverage"
  page -> user: "results at once; the guide's\nsteps where the picks sit"
  page -> guide: "asked: Ask the guide or Shift+Enter" {class: hot}
  guide -> page: "picks: reason, quote, checks"
  page -> user: "picks marked in their rows: AI-written\nreason labelled, quote checked word for word;\n2 of 3 AI answers left today"
  user -> resource: "a row"
  resource -> user: "why the guide picked it; Open, Save"
  user -> page: "Back: the same place in the list"
}

short: A few words {
  user -> page: "/search?q=translate"
  page -> search: "search"
  search -> page: "results"
  page -> user: "results; Ask the guide stays\nin the box (no model call)"
  user -> page: "Ask the guide"
  page -> guide: "ask"
}
