# Sequence: a search on the v2 results page, from the box to the guide picks and a shared link.
# Shows results shown before the guide answers, the reserved picks bar, the SSE answer that adds badges without
# re-ordering, the selected result written to the URL with replaceState, and a shared link that opens the same result.
# Source of truth: docs/adr/0040-frontend-design-v2.md, docs/adr/0015-ai-guide-evidence-gate.md (guide stream).
# Render: cd docs/diagrams && d2 fmt sequence-0040-frontend-design-v2.d2 && d2 sequence-0040-frontend-design-v2.d2 sequence-0040-frontend-design-v2.svg

...@style

shape: sequence_diagram

user: User {class: person}
page: "Results page\n(list, preview, picks bar)" {class: app}
history: "Browser history" {class: data}
search: "GET /api/v1/search" {class: ext}
guide: "POST /api/v1/guide/stream\n(SSE)" {class: ext}

search_first: Results first {
  user -> page: "/search?q=postgres mcp server"
  page -> search: "search"
  search -> page: "results"
  page -> user: "list at once; picks bar reserved:\n\"Guide is reading 14 candidates…\"" {class: hot}
  page -> guide: "ask the guide (same query)"
}

reading: While the guide works {
  user -> page: "click row 4"
  page -> history: "replaceState ?q=…&id=spec"
  page -> user: "preview of row 4"
}

answer: Guide answers {
  guide -> page: "picks #1 #2 #3 with checked quotes"
  page -> user: "bar shows the picks (AI-written);\nbadges in place; row 4 stays where it was" {class: hot}
  user -> page: "tap chip #1"
  page -> history: "replaceState ?q=…&id=pg"
  page -> user: "preview of pick #1"
}

share: Shared link {
  user -> page: "opens /search?q=…&id=pg"
  page -> search: "search"
  search -> page: "results"
  page -> user: "same result selected"
}
