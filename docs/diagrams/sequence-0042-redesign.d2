# Sequence: the redesign (design system v4) on a phone: Home with the radar and terminals, a scroll that folds the
# title while the box stays pinned, a question that starts the guide on its own, and a short search that waits for
# Ask the guide.
# Source of truth: docs/adr/frontend/0042-redesign-design-system-v4.md, docs/design/system/README.md,
#   docs/design/redesign/*.dc.html. The code follows page by page (decision 8).
# Render: cd docs/diagrams && d2 fmt sequence-0042-redesign.d2 && d2 sequence-0042-redesign.d2 sequence-0042-redesign.svg

...@style

shape: sequence_diagram

user: User {class: person}
home: "Home\n(title, radar, pinned box,\nterminals)" {class: app}
api: "GET /api/v1/sources,\n/recent, /events/upcoming" {class: ext}
page: "Results\n(one column)" {class: app}
search: "GET /api/v1/search" {class: ext}
guide: "POST /api/v1/guide/stream\n(SSE)" {class: ext}

landing: Home {
  user -> home: "/"
  home -> api: "sources, news, events"
  api -> home: "12 sources, rows"
  home -> user: "title, radar dots, box,\nNew this week, Coming up" {class: hot}
  user -> home: "scrolls 24 px"
  home -> user: "title folds away,\nthe box stays pinned"
}

question: A question {
  user -> page: "/search?q=translate my newsletter\ninto Italian for free"
  page -> search: "search"
  search -> page: "results, facets, coverage"
  page -> user: "results at once; the guide's\nsteps where the picks sit"
  page -> guide: "4+ words: ask on its own" {class: hot}
  guide -> page: "picks: reason, quote, checks"
  page -> user: "Recommended for you:\nAI-written reason labelled,\nquote checked word for word"
}

short: A few words {
  user -> page: "/search?q=translate"
  page -> search: "search"
  search -> page: "results"
  page -> user: "results and Ask the guide\n(no model call)"
  user -> page: "Ask the guide"
  page -> guide: "ask"
}
