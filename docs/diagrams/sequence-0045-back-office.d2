# Sequence: the owner opens the back office and follows a count into the filtered queue (ADR 0045).
# Source of truth: frontend/src/pages/admin/AdminOverview.tsx, ReviewQueuePage.tsx,
#   backend/src/main/java/ai/helper2/admin/usecase/GetOverview.java, admin/web/OverviewController.java,
#   catalog/ReviewQueue.java (openCountsByKind), scout/internal/CatalogEnrichmentStore.java, catalog/internal/JdbcEnrichmentCandidates.java (pendingCount),
#   examples/usecase/CountHomeExamples.java, examples/internal/JdbcHomeExamples.java (all), platform/llm/BudgetLedger.java,
#   admin/usecase/GetReviewEvidence.java, catalog/internal/JdbcReviewEvidence.java, frontend/src/pages/admin/ReviewEvidence.tsx,
#   frontend/src/pages/admin/EnrichmentQueuePage.tsx, admin/web/EnrichmentQueueController.java,
#   scout/usecase/PrioritiseEnrichment.kt, scout/internal/JdbcEnrichmentQueueControl.java,
#   admin/usecase/ResolveReviewItems.java, frontend/src/pages/admin/ReviewBulk.tsx.# Render: cd docs/diagrams && d2 fmt sequence-0045-back-office.d2 && d2 sequence-0045-back-office.d2 sequence-0045-back-office.svg

...@style

shape: sequence_diagram

owner: "Owner\n(admin host)" {class: person}
spa: "Admin pages" {class: app}
api: "Back office\n(admin module)" {class: app}
db: PostgreSQL {class: data}
redis: Redis {class: data}

overview: Overview {
  owner -> spa: "/admin" {class: hot}
  spa -> api: "GET /api/v1/admin/overview"
  api -> db: "open items per kind, backlog count,\nlast runs, every home example"
  api -> redis: "today's count of each budget,\nweb credits"
  api -> spa: "counts, counted at T\n(kept one minute)"
  spa -> owner: "12 User report · 420 waiting ·\nEnrichment 120 of 500"
}

follow: Follow a count {
  owner -> spa: "12 User report"
  spa -> api: "GET /api/v1/admin/review-items?status=OPEN&kind=USER_REPORT"
  api -> db: "page of open user reports"
  api -> spa: "items"
  spa -> owner: "/admin/review?kind=USER_REPORT"
}

review: Review with the evidence {
  spa -> api: "GET /api/v1/admin/review-items/{id}/evidence\n(the selected item)"
  api -> db: "the item's links and its run,\nthen fields and quotes (or the relationship)"
  api -> spa: "run, errors, fields with quotes,\naiContent"
  spa -> owner: "the item next to the list,\nAI values labelled"
  owner -> spa: "a (accept)" {class: hot}
  spa -> api: "PUT /api/v1/admin/review-items/{id}/resolution"
  api -> spa: "decided"
  spa -> owner: "next item focused,\n\"Accepted. 11 left.\""
}

act: Act on the enrichment queue {
  owner -> spa: "/admin/enrichment: Move to top"
  spa -> api: "POST /api/v1/admin/enrichment-queue/{id}/prioritise (CSRF)"
  api -> db: "lock the top (pg_advisory_xact_lock),\nwhere the resource stands,\nhow many at the top (backlog rule)"
  api -> db: "one transaction: control row\n+ audit PRIORITISE_ENRICHMENT"
  api -> spa: "204 (409 not-applicable with the reason)"
  spa -> api: "GET /api/v1/admin/enrichment-queue"
  api -> db: "page: at the top first"
  spa -> owner: "\"Acme MCP\" is at the top (focus on the result)"
}

bulk: Decide several at once {
  owner -> spa: "x on 12 rows, Accept,\nconfirm (focus on Cancel)" {class: hot}
  spa -> api: "POST /api/v1/admin/review-items/resolutions\n12 ids, ACCEPTED"
  api -> db: "per item: rule check (its run's conflicting fields),\nthen its own transaction: decision, audit bulk:<batch>"
  api -> spa: "one outcome per item"
  spa -> owner: "\"11 done, 1 failed (already decided)\",\nthe failed item stays picked"
}
