# Sequence: a discovery pass that finds a self-hosted app, and an admin who accepts it.
# Source of truth: backend/src/main/kotlin/ai/helper2/scout/usecase/RunScout.kt (collect, proposeCandidates),
#   backend/src/main/java/ai/helper2/scout/internal/ResourceCandidateJson.java,
#   backend/src/main/java/ai/helper2/sources/tavily/TavilyDiscoveryCollector.java,
#   backend/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateReview.java,
#   backend/src/main/java/ai/helper2/catalog/ReviewQueue.java (proposeCandidate),
#   backend/src/main/java/ai/helper2/admin/usecase/ResolveReview.java,
#   backend/src/main/kotlin/ai/helper2/scout/usecase/IndexAcceptedCandidate.kt.
# Render: cd docs/diagrams && d2 fmt sequence-0051-tavily-discovery.d2 && d2 sequence-0051-tavily-discovery.d2 sequence-0051-tavily-discovery.svg

...@style

shape: sequence_diagram

runner: RunScout {class: app}
col: TavilyDiscoveryCollector {class: app}
tavily: "Tavily API" {class: ext}
catalog: "CatalogIndex\n(catalog)" {class: app}
review: ReviewQueueCandidateReview {class: app}
queue: "ReviewQueue\n(review_item)" {class: data}
person: "Admin" {class: person}
resolve: ResolveReview {class: app}
accept: IndexAcceptedCandidate {class: app}

runner -> col: "collect(checkpoint, null, 1000)"
col -> tavily: "POST /search, 33 searches\n(\"open-source self-hosted AI app...\")"
tavily -> col: "10 results with score and excerpt"
col -> col: "sort: product sites, list pages,\ndropped; merge by URL; tag every\ncategory it belongs to"
col -> runner: "hits: 1 ARTICLE;\ncandidates: openwebui.com\n(PRODUCT; self-hosted, local-ai)"
runner -> catalog: "index(ARTICLE)"
runner -> review: "propose(tavily-discovery, candidates)"
review -> queue: "proposeCandidate(RESOURCE_CANDIDATE,\nurl, reason, JSON)"
queue -> review: "opened (not in catalog,\nnot proposed before)"
person -> resolve: "PUT /admin/review-items/{id}/resolution\nACCEPTED"
resolve -> queue: "find(id): OPEN RESOURCE_CANDIDATE"
resolve -> accept: "accept(details)"
accept -> accept: "ResourceCandidateJson.read;\ncheck source, URL, type, tags"
accept -> queue: "CatalogLookup: listed? no"
accept -> catalog: "index(record of tavily-discovery)"
catalog -> accept: "resource id"
resolve -> queue: "decide ACCEPTED (same transaction)"
resolve -> person: "200 ACCEPTED"
