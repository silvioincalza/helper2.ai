# Sequence: a person arrives on a hub page from a search engine (ADR 0052).
# Source of truth: backend/apps/public/src/main/java/ai/helper2/site/pages/web/PageRoutes.java, HubController.java,
#   site/pages/internal/CatalogSiteLists.java, catalog/usecase/ListNewestIndexable.java,
#   frontend/src/features/hubs/HubPage.tsx.
# Render: cd docs/diagrams && d2 fmt sequence-0052-hub-pages.d2 && d2 sequence-0052-hub-pages.d2 sequence-0052-hub-pages.svg

...@style

shape: sequence_diagram

person: "Person\n(browser)" {class: person}
api: "helper2 public app\n(site.pages, catalog)" {class: app}
db: PostgreSQL {class: data}

person -> api: "GET /mcp-servers"
api -> db: "index-worthy MCP servers, newest change first,\nat most 50 (once every 10 minutes)"
db -> api: "ids, then cards"
api -> person: "200 index.html: head, the list as links" {class: hot}
person -> api: "GET /api/v1/hubs/MCP_SERVER (the app starts)"
api -> person: "200 HubResponse from memory"
person -> person: "createRoot replaces the body\nwith the same list"
person -> api: "a row: GET /resource/{id}/{slug}"
