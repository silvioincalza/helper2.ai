# Sequence: a person filters a search by category, opens a result and asks the guide on the filtered page.
# Source of truth: frontend/src/components/CategoryFacet.tsx, frontend/src/hooks/useCategories.ts,
#   frontend/src/hooks/useGuideStream.ts, frontend/src/components/results/CategoryLinks.tsx,
#   backend/src/main/java/ai/helper2/search/web/CategoriesController.java,
#   backend/src/main/java/ai/helper2/search/web/SearchController.java,
#   backend/src/main/kotlin/ai/helper2/search/usecase/SearchResources.kt,
#   backend/src/main/kotlin/ai/helper2/search/ResultMerger.kt,
#   backend/src/main/java/ai/helper2/catalog/internal/CatalogSearchSource.java,
#   backend/src/main/java/ai/helper2/guide/web/GuideStreamController.java,
#   backend/src/main/kotlin/ai/helper2/guide/steps/PickAnswer.kt (searchFor).
# Render: cd docs/diagrams && ./render.sh

...@style

shape: sequence_diagram

person: "Person" {class: person}
page: "Results page\n(React)" {class: app}
cats: "CategoriesController" {class: app}
ctl: "SearchController" {class: app}
search: "SearchResources" {class: app}
index: "Catalog source\n(resource_label CATEGORY)" {class: data}
web: "Live sources\n(Tavily, GitHub ...)" {class: ext}
merger: "ResultMerger +\nCategoryMatcher" {class: app}
guide: "GuideStreamController\n+ AskGuide" {class: app}

person -> page: "/search?q=review"
page -> cats: "GET /categories"
cats -> page: "34 categories, ETag,\nmax-age 1 h (304 next time)"
page -> ctl: "GET /search?q=review"
ctl -> search: "search(filters)"
search -> index: "query"
index -> search: "hits with their stored categories"
search -> web: "query"
web -> search: "hits without categories"
search -> merger: "merge(hits)"
merger -> search: "every result with its categories\n(stored + matched by code)"
search -> ctl: "results + facet counts\n(category: coding 4, unknown 3)"
ctl -> page: "200"
person -> page: "ticks Coding (4)"
page -> ctl: "GET /search?q=review&category=coding"
ctl -> ctl: "coding is a configured id"
ctl -> page: "results in coding only, same facet counts"
person -> page: "Ask the guide"
page -> guide: "POST /guide/stream\n{request, categories: [coding]}"
guide -> search: "pick search with category coding\n(cache key includes it)"
guide -> page: "picks, all in coding"
person -> page: "opens a resource: Categories → Coding"
page -> ctl: "GET /search?q=Coding&category=coding"
