# Sequence: Google checks the site; a visitor in Europe opens a resource page with AdSense on (ADR 0059).
# Source of truth: backend/src/main/java/ai/helper2/pages/internal/PageHtml.java, pages/web/CrawlerFiles.java,
#   identity/config/CspHeaderWriter.java, frontend/src/lib/googleConsent.ts, components/AdSenseSlot.tsx.
# Render: cd docs/diagrams && d2 fmt sequence-0059-adsense.d2 && d2 sequence-0059-adsense.d2 sequence-0059-adsense.svg

...@style

shape: sequence_diagram

google: "Google AdSense\ncrawler" {class: person}
person: "Visitor\n(browser)" {class: person}
api: "helper2\n(pages, identity)" {class: app}
fc: "Google consent tool" {class: data}
ads: "Google AdSense" {class: data}

check: "Site check" {
  google -> api: "GET /, GET /ads.txt"
  api -> google: "meta google-adsense-account;\ngoogle.com, pub-..., DIRECT, f08c47fec0942fa0" {class: hot}
}

visit: "A visit" {
  person -> api: "GET /resource/{id}"
  api -> person: "index.html, every script with the nonce;\nCSP names the nonce"
  person -> api: "GET /api/v1/me"
  api -> person: "monetisation: adsenseClient, adsenseSlot"
  person -> fc: "Privacy & messaging tag (pub-...)"
  fc -> person: "question; TCF answer"
  person -> person: "purposes 1 + 8, vendor 755:\nGoogle Analytics loads"
  person -> ads: "adsbygoogle.js, one ad for the box\n(resource address, no search words)"
  ads -> person: "the ad"
}
