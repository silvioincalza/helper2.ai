# Sequence: an admin adds the model a news item is about, from its ABOUT candidate, and accepts the link.
# Source of truth: frontend/src/pages/admin/RelationshipTarget.tsx,
#   backend/apps/helper2/src/main/java/ai/helper2/admin/web/ReviewController.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/usecase/ChangeRelationshipTarget.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/usecase/AddCuratedResource.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/RelationshipTargets.java,
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/internal/ReviewDecisions.java.
# Render: cd docs/diagrams && d2 fmt sequence-0064-relationship-target-in-review.d2 && d2 sequence-0064-relationship-target-in-review.d2 sequence-0064-relationship-target-in-review.svg

...@style

shape: sequence_diagram

person: "Admin" {class: person}
ui: "Back office\n(RelationshipTarget)" {class: app}
api: ReviewController {class: app}
change: ChangeRelationshipTarget {class: app}
add: AddCuratedResource {class: app}
db: "PostgreSQL\n(resource, relationship,\nreview_item, admin_audit)" {class: data}

person -> ui: "Add the resource: Gemini 4 Carbon,\nhttps://deepmind.google/models/gemini/, Model"
ui -> api: "PUT /admin/review-items/{id}/relationship-target\n{newResource}"
api -> change: "change(item, Added, admin)"
change -> add: "add(name, address, MODEL)"
add -> db: "resource at this address? none"
add -> db: "upsert curated record (CURATED, NOT_RUN)"
change -> db: "ADD_RESOURCE <id> ADDED"
change -> db: "lock item: OPEN, RELATIONSHIP_CANDIDATE"
change -> db: "relationship: target <id>, target_origin CURATED (origin kept)"
change -> db: "CHANGE_RELATIONSHIP_TARGET LINKED <id>"
api -> ui: "200 evidence: About (AI) Gemini 4 Carbon (target chosen by an admin)"
person -> ui: "Accept"
ui -> api: "PUT /admin/review-items/{id}/resolution ACCEPTED"
api -> db: "item ACCEPTED, relationship VERIFIED"
