# Sequence: a news post a discovery category proposed as a PRODUCT is edited to NEWS, then accepted.
# Source of truth: frontend/src/pages/admin/CandidateEditForm.tsx,
#   backend/apps/backoffice/src/main/java/ai/helper2/admin/web/ReviewController.java (editCandidate),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/EditCandidate.kt,
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ReviewQueueCandidateItems.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/scout/internal/ResourceCandidateJson.java,
#   backend/apps/backoffice/src/main/java/ai/helper2/admin/usecase/ResolveReview.java (lock, then index),
#   backend/libs/catalog/src/main/java/ai/helper2/catalog/ReviewQueue.java (lock),
#   backend/apps/backoffice/src/main/kotlin/ai/helper2/scout/usecase/IndexAcceptedCandidate.kt.
# Render: cd docs/diagrams && d2 fmt sequence-0065-candidate-edit-in-review.d2 && d2 sequence-0065-candidate-edit-in-review.d2 sequence-0065-candidate-edit-in-review.svg

...@style

shape: sequence_diagram

person: "Admin" {class: person}
ui: "Back office\n(CandidateEditForm)" {class: app}
api: ReviewController {class: app}
edit: EditCandidate {class: app}
items: "ReviewQueueCandidateItems\n(ResourceCandidateJson)" {class: app}
db: "PostgreSQL\n(review_item, admin_audit)" {class: data}
accept: "ResolveReview →\nIndexAcceptedCandidate" {class: app}
catalog: "CatalogIndex\n(catalog)" {class: app}

person -> ui: "title without \"| Engadget\", type News"
ui -> api: "PUT /admin/review-items/{id}/candidate\n{expectedDetails, title, type: NEWS}"
api -> edit: "edit(item, expectedDetails, change, admin)"
edit -> items: "find(item): OPEN, RESOURCE_CANDIDATE,\ndetails = expectedDetails"
edit -> edit: "check title and type"
edit -> items: "edit(details): title, type replaced;\nedited [title, type]"
edit -> db: "BEGIN"
edit -> items: "replace(item, old, new)"
items -> db: "UPDATE review_item … WHERE details = old"
edit -> db: "EDIT_CANDIDATE EDITED title, type; COMMIT"
api -> ui: "200 item: New NEWS … found by discovery-…"
person -> ui: "Accept"
ui -> accept: "PUT …/resolution ACCEPTED"
accept -> db: "SELECT … FOR UPDATE (lock the item)"
accept -> accept: "type NEWS chosen by the admin:\nno finder needs to declare it"
accept -> catalog: "index(record of the first finder,\nextra.edited [title, type])"
