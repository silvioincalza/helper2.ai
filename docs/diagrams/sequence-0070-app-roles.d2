# Sequence: a deploy with a new migration, from app.env to the apps serving as their own roles (ADR 0070).
# Source of truth: deploy/k8s/Makefile (env-secret, deploy), deploy/helm/helper2/templates/ (migrate.yaml, app.yaml,
#   backoffice.yaml, redis.yaml), backend/libs/schema (MigrateStep, AppLogins, SchemaCheck),
#   backend/libs/identity (SessionConfiguration).
# Render: cd docs/diagrams && d2 fmt sequence-0070-app-roles.d2 && d2 sequence-0070-app-roles.d2 sequence-0070-app-roles.svg

...@style

shape: sequence_diagram

make: "make deploy" {class: app}
k8s: Kubernetes {class: app}
job: "migrate Job\n(owner)" {class: app}
public: "public app\n(h2_public)" {class: app}
bo: "back office\n(h2_backoffice)" {class: app}
db: Postgres {class: data}
redis: Redis {class: data}

secrets: Secrets {
  make -> k8s: "check-app-env.sh; helper2-credentials (6 passwords)\nand helper2-app-env (the rest)"
}

release: helm upgrade --wait --wait-for-jobs {
  make -> k8s: "Job helper2-migrate-<revision>, new app pods"
  k8s -> job: "start: owner password, both role passwords"
  k8s -> public: "start a new pod (old pods keep serving)"
  k8s -> bo: "start a new pod"
  public -> db: "validate as h2_public"
  db -> public: "migrations missing: wait 5 s"
  job -> db: "Flyway migrate (V23 and later)"
  job -> db: "ALTER ROLE ... LOGIN, SCRAM password"
  job -> k8s: "exit 0"
  public -> db: "validate: valid"
  bo -> db: "validate as h2_backoffice: valid"
  public -> redis: "AUTH h2_public"
  bo -> redis: "AUTH h2_backoffice"
  k8s -> make: "Job complete, pods ready: release deployed"
}

serve: Serving {
  public -> db: "rows only"
  public -> redis: "sign-in: h2:v1:session:public:* (JSON)"
  bo -> redis: "h2:v1:session:public:*: NOPERM" {class: fail}
}
