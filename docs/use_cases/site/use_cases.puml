@startuml Site
left to right direction

actor "Visitor" as visitor
actor "Scheduler" as scheduler
actor "Search Engine" as search_engine
actor "Payment Provider" as payment

rectangle "Site" {
    usecase "UC-014\nBrowse Hub Pages" as UC014
    usecase "UC-015\nRead Mission, Privacy and Terms" as UC015
    usecase "UC-016\nSupport searchavo.ai" as UC016
    usecase "UC-017\nNotify Search Engines of Changed Pages" as UC017
}

visitor --> UC014
search_engine --> UC014
visitor --> UC015
visitor --> UC016
UC016 --> payment
scheduler --> UC017
UC017 --> search_engine

@enduml
