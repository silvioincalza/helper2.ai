{
  "name": "helper2-frontend",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml --enum-values -o src/api/schema.ts",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "pretypecheck": "npm run gen:api",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run gen:api",
    "lint": "eslint .",
    "pretest": "npm run gen:api",
    "test": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "i18next": "26.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
